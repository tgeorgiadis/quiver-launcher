{
  "name": "@quiverlauncher/ui",
  "version": "0.1.0",
  "description": "Catalog components and styles shared by Quiver Launcher and quiverlauncher.com",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tgeorgiadis/quiver-launcher.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/tgeorgiadis/quiver-launcher/tree/v4/packages/ui#readme",
  "main": "src/index.tsx",
  "exports": {
    ".": "./src/index.tsx",
    "./markdown": "./src/markdown.tsx",
    "./catalog.css": "./src/catalog.css"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./markdown": {
        "types": "./dist/markdown.d.ts",
        "default": "./dist/markdown.js"
      },
      "./catalog.css": "./dist/catalog.css"
    }
  },
  "files": ["dist"],
  "sideEffects": ["*.css"],
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/catalog.css','dist/catalog.css')\"",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@quiverlauncher/api": "workspace:^",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "lucide-react": ">=0.468.0 <1",
    "react": "^19.2.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.0",
    "jsdom": "^30.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.7.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0"
  }
}
