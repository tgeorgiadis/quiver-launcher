{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/QuiverLauncher.Desktop/QuiverLauncher.Desktop.csproj",
        "-c",
        "Debug",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}/QuiverLauncher.sln",
        "-c",
        "Release",
        "--filter",
        "Category!=Slow",
        "--logger",
        "console;verbosity=normal"
      ],
      "group": "test",
      "problemMatcher": "$msCompile"
    }
  ]
}
