<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net9.0</TargetFramework>
		<ApplicationIcon>icon.ico</ApplicationIcon>
		<AssemblyName>QuiverLauncher</AssemblyName>
		<RootNamespace>QuiverLauncher</RootNamespace>
		<AssemblyTitle>Quiver Launcher</AssemblyTitle>
		<AssemblyDescription>Quiver Launcher — download and manage GitHub-hosted game ports</AssemblyDescription>
		<Version>3.1.0</Version>
		<AssemblyVersion>3.1.0.0</AssemblyVersion>
		<FileVersion>3.1.0.0</FileVersion>
		<Configurations>Debug;Release</Configurations>
		<Platforms>AnyCPU;x64</Platforms>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
		<DefineConstants>$(DefineConstants);LINUX</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
		<DefineConstants>$(DefineConstants);OSX</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AsyncImageLoader.Avalonia" Version="3.7.0" />
		<PackageReference Include="Avalonia" Version="11.3.12" />
		<PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />
		<PackageReference Include="ppy.SDL2-CS" Version="1.0.82" />
		<PackageReference Include="SharpCompress" Version="0.50.1" />
		<PackageReference Include="System.Text.Json" Version="10.0.3" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.3" />
		<PackageReference Include="NAudio" Version="2.2.1" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
		<PackageReference Include="Velopack" Version="1.2.0" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets/**" />
		<AvaloniaResource Include="Assets/Icons/**" />
	</ItemGroup>

	<ItemGroup>
		<None Update="icon.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="lib\QuiverLauncher.Core\QuiverLauncher.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="lib\QuiverLauncher.Core\**\*.cs" />
		<Compile Remove="QuiverLauncher.Tests\**\*.cs" />
		<Compile Remove="_test_build\**\*.cs" />
		<Compile Remove="artifacts\**\*.cs" />
		<EmbeddedResource Remove="lib\QuiverLauncher.Core\**\*.*" />
		<EmbeddedResource Remove="QuiverLauncher.Tests\**\*.*" />
		<EmbeddedResource Remove="_test_build\**\*.*" />
		<EmbeddedResource Remove="artifacts\**\*.*" />
		<None Remove="lib\QuiverLauncher.Core\**\*.*" />
		<None Remove="QuiverLauncher.Tests\**\*.*" />
		<None Remove="_test_build\**\*.*" />
		<None Remove="artifacts\**\*.*" />
	</ItemGroup>
</Project>
