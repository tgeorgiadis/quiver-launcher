<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:QuiverLauncher.ViewModels" xmlns:services="using:QuiverLauncher.Services" x:Class="QuiverLauncher.Views.LibraryFiltersView" x:DataType="vm:LibraryFiltersViewModel" x:CompileBindings="True">
<Grid x:Name="Surface" RowDefinitions="Auto,*">
				<StackPanel Grid.Row="0" Margin="0,4,0,8">
					<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,0,0,8"/>
					<TextBlock Text="SHOW"
							   FontSize="10"
							   FontWeight="Bold"
							   Foreground="{DynamicResource ThemeTextSecondary}"
							   LetterSpacing="1"
							   Margin="24,0,0,4"/>
				</StackPanel>

				<!-- Filter Buttons ScrollViewer -->
				<ScrollViewer x:Name="LibraryFiltersScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="12,0,12,0">

							<Button x:Name="UnhideAllGamesButton"
									Classes="settings scope-filter"
									Width="216"
									HorizontalAlignment="Left"
									Click="UnhideAllGamesButton_Click">
								<TextBlock Text="All Apps"/>
							</Button>

							<Button x:Name="HideNonInstalledButton"
									Classes="settings scope-filter"
									Width="216"
									HorizontalAlignment="Left"
									Click="HideNonInstalledButton_Click">
								<TextBlock Text="Installed Only"/>
							</Button>

							<Button x:Name="ShowHiddenGamesButton"
									Classes="settings scope-filter"
									Width="216"
									HorizontalAlignment="Left"
									Click="ShowHiddenGamesButton_Click">
								<TextBlock Text="Hidden"/>
							</Button>

							<Border Height="1"
									Background="{DynamicResource ThemeBorder}"
									Margin="0,8,0,8"/>

							<Grid ColumnDefinitions="*,Auto" Margin="12,0,8,8">
								<TextBlock Grid.Column="0"
										   Text="TAG FILTERS"
										   FontSize="10"
										   FontWeight="Bold"
										   Foreground="{DynamicResource ThemeTextSecondary}"
										   LetterSpacing="1"
										   VerticalAlignment="Center"/>
								<Button Grid.Column="1"
										Classes="iconbutton tag-filter-add"
										Width="24"
										Height="24"
										ToolTip.Tip="Add tag filter"
										Click="AddDisplayFilter_Click">
									<TextBlock Text="+"
											   FontSize="16"
											   FontWeight="Bold"
											   HorizontalAlignment="Center"
											   VerticalAlignment="Center"
											   TextAlignment="Center"/>
								</Button>
							</Grid>

							<ItemsControl x:Name="TagDisplayFiltersItemsControl"
										  ItemsSource="{Binding TagDisplayFilters}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="services:TagDisplayFilterListItem">
										<Button Classes="settings display-filter-row"
												Classes.selected="{Binding IsSelected}"
												Margin="0,0,0,4"
												HorizontalAlignment="Stretch"
												HorizontalContentAlignment="Stretch"
												Click="TagDisplayFilterButton_Click"
												Tag="{Binding Id}">
											<Grid ColumnDefinitions="*,Auto,Auto">
													<TextBlock Grid.Column="0"
															   Text="{Binding Name}"
															   TextTrimming="CharacterEllipsis"
															   VerticalAlignment="Center"/>
													<Border Grid.Column="1"
															Classes="display-filter-reorder"
															Width="28"
															Height="28"
															Margin="4,0,0,0"
															VerticalAlignment="Center"
															Tag="{Binding Id}"
															PointerPressed="TagDisplayFilterReorder_PointerPressed">
														<TextBlock Text="↕"
																   FontSize="14"
																   IsHitTestVisible="False"
																   HorizontalAlignment="Center"
																   VerticalAlignment="Center"/>
													</Border>
													<Button Grid.Column="2"
															Classes="options options-listview display-filter-overflow"
															Content="⋯"
															FontSize="18"
															Width="28"
															Height="28"
															Padding="0"
															Margin="2,0,0,0"
															VerticalAlignment="Center"
															Click="DisplayFilterOverflow_Click"
															Tag="{Binding Id}">
														<Button.ContextMenu>
															<ContextMenu>
																<MenuItem Header="Edit"
																		  Tag="{Binding Id}"
																		  Click="EditTagDisplayFilter_Click"/>
																<MenuItem Header="Move Up"
																		  Tag="{Binding Id}"
																		  Click="MoveTagDisplayFilterUp_Click"/>
																<MenuItem Header="Move Down"
																		  Tag="{Binding Id}"
																		  Click="MoveTagDisplayFilterDown_Click"/>
																<MenuItem Header="Delete"
																		  Tag="{Binding Id}"
																		  Click="DeleteTagDisplayFilter_Click"/>
															</ContextMenu>
														</Button.ContextMenu>
													</Button>
												</Grid>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<Button Classes="options"
									Content="Add Display Filter"
									HorizontalAlignment="Stretch"
									Margin="0,8,0,0"
									Click="AddDisplayFilter_Click"/>
						</StackPanel>
				</ScrollViewer>
				</Grid>
</UserControl>
