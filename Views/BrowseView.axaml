		<StreamGeometry x:Key="BrowseOsAndroid">M420.55,301.93a24,24,0,1,1,24-24,24,24,0,0,1-24,24m-265.1,0a24,24,0,1,1,24-24,24,24,0,0,1-24,24m273.7-144.48,47.94-83a10,10,0,1,0-17.27-10h0l-48.54,84.07a301.25,301.25,0,0,0-246.56,0L116.18,64.45a10,10,0,1,0-17.27,10h0l47.94,83C64.53,202.22,8.24,285.55,0,384H576c-8.24-98.45-64.54-181.78-146.85-226.55</StreamGeometry>
		<StreamGeometry x:Key="BrowseOsIOS">M1.1 6.05C.486 6.05 0 6.53 0 7.13A1.08 1.08 0 0 0 1.1 8.21C1.72 8.21 2.21 7.73 2.21 7.13C2.21 6.53 1.72 6.05 1.1 6.05M8.71 6.07C5.35 6.07 3.25 8.36 3.25 12C3.25 15.67 5.35 17.95 8.71 17.95C12.05 17.95 14.16 15.67 14.16 12C14.16 8.36 12.05 6.07 8.71 6.07M19.55 6.07C17.05 6.07 15.27 7.45 15.27 9.5C15.27 11.13 16.28 12.15 18.4 12.64L19.89 13C21.34 13.33 21.93 13.81 21.93 14.64C21.93 15.6 20.96 16.28 19.58 16.28C18.17 16.28 17.11 15.59 17 14.53H15C15.08 16.65 16.82 17.95 19.46 17.95C22.25 17.95 24 16.58 24 14.4C24 12.69 23 11.72 20.68 11.19L19.35 10.89C17.94 10.55 17.36 10.1 17.36 9.34C17.36 8.38 18.24 7.74 19.54 7.74C20.85 7.74 21.75 8.39 21.85 9.46H23.81C23.76 7.44 22.09 6.07 19.55 6.07M8.71 7.82C10.75 7.82 12.06 9.45 12.06 12C12.06 14.57 10.75 16.2 8.71 16.2C6.65 16.2 5.35 14.57 5.35 12C5.35 9.45 6.65 7.82 8.71 7.82M.111 9.31V17.76H2.1V9.31H.11Z</StreamGeometry>
		<!-- A card drawn like the website's catalog card. -->
		<DataTemplate x:Key="BrowseCardTemplate" x:DataType="vm:BrowseItem">
			<Border Classes="catalog-focus-card browse-card"
					Width="256"
					CornerRadius="9"
					Margin="0,0,14,14"
					Classes.gamepad-focused="{Binding IsGamepadFocused}"
					ClipToBounds="True"
					Cursor="Hand"
					PlatformFeedback.FeedbackType="Auto"
					PointerEntered="BrowseCard_PointerEntered"
					PointerExited="BrowseCard_PointerExited"
					Tapped="BrowseCard_Tapped">
				<Grid RowDefinitions="Auto,*">
					<Border Grid.Row="0" Height="140" ClipToBounds="True" Background="{DynamicResource ThemeLighter}">
						<Grid>
							<Path Width="40" Height="40" Stretch="Uniform"
								  HorizontalAlignment="Center" VerticalAlignment="Center"
								  Stroke="{DynamicResource ThemeTextSecondary}" StrokeThickness="1.5"
								  Data="M 3,3 L 10,3 L 10,10 L 3,10 Z M 14,3 L 21,3 L 21,10 L 14,10 Z M 3,14 L 10,14 L 10,21 L 3,21 Z M 14,14 L 21,14 L 21,21 L 14,21 Z"
								  IsVisible="{Binding #BrowseCardArt.Source, Converter={x:Static converters:ObjectConverters.IsNull}}"/>
							<Image x:Name="BrowseCardArt" Stretch="UniformToFill"
								   asyncImageLoader:ImageLoader.Source="{Binding ImageUrl}"/>
							<Border Classes="browse-badge" Classes.in-library="{Binding InLibrary}"
									HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding HasBadge}">
								<TextBlock Text="{Binding BadgeText}"/>
							</Border>
						</Grid>
					</Border>
					<StackPanel Grid.Row="1" Margin="14,14,14,11">
						<Grid ColumnDefinitions="*,Auto,Auto" MinHeight="13" Margin="0,0,0,6">
							<services:HoverScrollText Grid.Column="0" Text="{Binding CardKind}" IsActive="{Binding ShouldScroll}"
													  FontSize="9" LetterSpacing="0.7" Foreground="#94a3b8" VerticalAlignment="Center"/>
							<Border Grid.Column="1" Classes="browse-ai-chip" IsVisible="{Binding HasAiChip}">
								<TextBlock Text="{Binding AiChip}"/>
							</Border>
							<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" Margin="8,0,0,0" VerticalAlignment="Center"
										Background="Transparent" ToolTip.Tip="{Binding PlatformTip}">
								<Path Classes="browse-os" Data="{StaticResource BrowseOsWindows}" IsVisible="{Binding RunsOnWindows}"/>
								<Path Classes="browse-os" Data="{StaticResource BrowseOsMacOS}" IsVisible="{Binding RunsOnMacOS}"/>
								<Path Classes="browse-os" Data="{StaticResource BrowseOsLinux}" IsVisible="{Binding RunsOnLinux}"/>
								<Path Classes="browse-os" Data="{StaticResource BrowseOsAndroid}" IsVisible="{Binding RunsOnAndroid}"/>
								<Path Classes="browse-os" Data="{StaticResource BrowseOsIOS}" IsVisible="{Binding RunsOnIOS}"/>
							</StackPanel>
						</Grid>
						<services:HoverScrollText Text="{Binding Title}" IsActive="{Binding ShouldScroll}"
												  FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}"/>
						<Grid ColumnDefinitions="Auto,*" Margin="0,8,0,0" IsVisible="{Binding HasBasedOn}">
							<TextBlock Grid.Column="0" Classes="browse-based-on" Text="BASED ON" Margin="0,0,6,0"/>
							<services:HoverScrollRow Grid.Column="1" IsActive="{Binding ShouldScroll}" HorizontalAlignment="Left">
							<ItemsControl ItemsSource="{Binding BasedOn}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel Orientation="Horizontal" Spacing="6"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="x:String">
										<Border Classes="browse-game-chip">
											<TextBlock Text="{Binding}"/>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							</services:HoverScrollRow>
						</Grid>
						<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,14,0,11" IsVisible="{Binding HasFooter}"/>
						<Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasFooter}">
							<services:HoverScrollRow Grid.Column="0" IsActive="{Binding ShouldScroll}" Margin="0,0,8,0" HorizontalAlignment="Left">
							<TextBlock FontSize="11">
								<Run Classes="browse-score" Classes.positive="{Binding ScorePositive}" Classes.caution="{Binding ScoreCaution}"
									 Classes.negative="{Binding ScoreNegative}" Text="{Binding ScoreLabel}"/><Run
									 FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Text="{Binding ScoreCounts}"/>
							</TextBlock>
							</services:HoverScrollRow>
							<TextBlock Grid.Column="1" Classes="browse-release" Classes.stale="{Binding ReleaseStale}" Text="{Binding ReleaseText}"/>
						</Grid>
					</StackPanel>
				</Grid>
			</Border>
		</DataTemplate>
	</UserControl.Resources>
	<Grid x:Name="Surface"
		  XYFocus.NavigationModes="Gamepad,Remote"
		  XYFocus.UpNavigationStrategy="Projection"
		  XYFocus.DownNavigationStrategy="Projection"
		  XYFocus.LeftNavigationStrategy="Projection"
		  XYFocus.RightNavigationStrategy="Projection"
		  RowDefinitions="Auto,Auto,*">
		<!-- Laid out like the website's catalog: title and sort, then search and the four filters. -->
		<Grid x:Name="BrowseToolbarPanel" Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,30,14">
			<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
				<TextBlock x:Name="BrowseTitleText" Text="Explore the catalog" FontSize="18" FontWeight="SemiBold"
						   Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center"/>
				<Border CornerRadius="5" Padding="7,2" VerticalAlignment="Center" BorderThickness="1"
						Background="{DynamicResource ThemeLighter}" BorderBrush="{DynamicResource ThemeBorder}">
					<TextBlock x:Name="BrowseCountText" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}"/>
				</Border>
				<Button x:Name="BrowseCatalogTabButton" Classes="catalog-filter selected" Content="Quiver catalog"
						FontSize="11" MinHeight="32" Margin="14,0,0,0" Click="BrowseSourceTab_Click"/>
				<Button x:Name="BrowseCustomListTabButton" Classes="catalog-filter" Content="My app list"
						FontSize="11" MinHeight="32" Click="BrowseSourceTab_Click"/>
			</StackPanel>
			<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
				<TextBlock x:Name="BrowseSortLabel" Text="Sort by" FontSize="11" VerticalAlignment="Center"
						   Foreground="{DynamicResource ThemeTextSecondary}"/>
				<TextBlock x:Name="BrowseRelevantText" Text="Most relevant ↓" FontSize="11" VerticalAlignment="Center"
						   Foreground="{DynamicResource ThemeTextSecondary}" IsVisible="False"/>
				<ComboBox x:Name="BrowseSortComboBox" Classes="browse-filter" MinWidth="150"
						  SelectionChanged="BrowseSort_SelectionChanged"/>
			</StackPanel>
		</Grid>
		<Grid x:Name="BrowseFiltersPanel" Grid.Row="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,0,30,14">
			<TextBox x:Name="BrowseSearchTextBox" Grid.Column="0"
					 Watermark="Search games, projects, or tags…"
					 MinWidth="200"
					 MinHeight="40"
					 FontSize="12"
					 VerticalContentAlignment="Center"
					 Margin="0,0,18,0"
					 TextChanged="BrowseSearch_TextChanged">
				<TextBox.InnerLeftContent>
					<Path Width="15" Height="15" Margin="12,0,2,0" Stretch="Uniform" VerticalAlignment="Center"
						  Stroke="{DynamicResource ThemeTextSecondary}" StrokeThickness="1.6" StrokeLineCap="Round"
						  Data="M 11,4 A 7,7 0 1 1 10.99,4 Z M 16,16 L 21,21"/>
				</TextBox.InnerLeftContent>
			</TextBox>
			<WrapPanel x:Name="BrowseFilterSelects" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
				<Path Width="17" Height="17" Margin="0,0,10,0" Stretch="Uniform" VerticalAlignment="Center"
					  Stroke="{DynamicResource ThemeTextSecondary}" StrokeThickness="1.6" StrokeLineCap="Round"
					  Data="M 21,4 L 14,4 M 10,4 L 3,4 M 21,12 L 12,12 M 8,12 L 3,12 M 21,20 L 16,20 M 12,20 L 3,20 M 14,2 L 14,6 M 8,10 L 8,14 M 16,18 L 16,22"/>
				<ComboBox x:Name="BrowseTypeComboBox" Classes="browse-filter" MinWidth="140" Margin="0,0,10,0"
						  ToolTip.Tip="Project type" SelectionChanged="BrowseFilter_SelectionChanged"/>
				<ComboBox x:Name="BrowsePlatformComboBox" Classes="browse-filter" MinWidth="130" Margin="0,0,10,0"
						  ToolTip.Tip="Operating system" SelectionChanged="BrowseFilter_SelectionChanged"/>
				<ComboBox x:Name="BrowseConsoleComboBox" Classes="browse-filter" MinWidth="180" Margin="0,0,10,0"
						  ToolTip.Tip="Console" SelectionChanged="BrowseFilter_SelectionChanged"/>
				<ComboBox x:Name="BrowseAiComboBox" Classes="browse-filter" MinWidth="150"
						  ToolTip.Tip="Labels are based on the developer's answer, the README and repository signals"
						  SelectionChanged="BrowseFilter_SelectionChanged"/>
				<Button x:Name="BrowseRetryButton" Classes="options" Content="Try again" FontSize="12" MinHeight="40"
						Margin="10,0,0,0" IsVisible="False" Click="BrowseRetry_Click"/>
				<Button x:Name="BrowseClearFiltersButton" Classes="options" Content="Clear filters" FontSize="12" MinHeight="40"
						Margin="10,0,0,0" IsVisible="False" Click="BrowseClearFilters_Click"/>
			</WrapPanel>
		</Grid>
		<ScrollViewer x:Name="BrowseScrollViewer"
					  Grid.Row="2"
					  VerticalScrollBarVisibility="Auto"
					  HorizontalScrollBarVisibility="Disabled"
					  ScrollChanged="BrowseScrollViewer_ScrollChanged">
			<StackPanel x:Name="BrowseContentStack" Margin="0,0,30,0">
				<StackPanel x:Name="BrowseLoadingPanel" Margin="0,8,0,0" Spacing="8" IsVisible="{Binding IsLoading}">
					<ProgressBar Width="120" Height="4" HorizontalAlignment="Left" Minimum="0" Maximum="100"
								 BorderThickness="0" Background="Transparent" IsIndeterminate="True"/>
					<TextBlock Text="Loading apps…" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"/>
				</StackPanel>
				<ItemsControl x:Name="BrowseItemsControl" ItemsSource="{Binding Items}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<StaticResource ResourceKey="BrowseCardTemplate"/>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				<TextBlock x:Name="BrowseStatusText"
						   Text="{Binding Status}"
						   FontSize="12"
						   Foreground="{DynamicResource ThemeTextSecondary}"
						   TextWrapping="Wrap"
						   Margin="0,8,0,8"/>
				<TextBlock Text="Loading more apps…" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"
						   Margin="0,0,0,12" IsVisible="{Binding IsLoadingMore}"/>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
