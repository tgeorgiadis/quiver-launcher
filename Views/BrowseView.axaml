<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:vm="using:QuiverLauncher.ViewModels"
             xmlns:services="using:QuiverLauncher.Services"
             x:Class="QuiverLauncher.Views.BrowseView" x:DataType="vm:BrowseViewModel" x:CompileBindings="True">
	<UserControl.Styles>
		<Style Selector="ComboBox.browse-filter">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="MinHeight" Value="40"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
			<Setter Property="Background" Value="{DynamicResource ThemeDarker}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
		</Style>
		<!-- The catalog card, coloured like the website's. -->
		<Style Selector="Border.browse-card">
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
			<Setter Property="Background" Value="{DynamicResource ThemeBase}"/>
		</Style>
		<Style Selector="Border.browse-card:pointerover">
			<Setter Property="BorderBrush" Value="#0ea5e9"/>
		</Style>
		<Style Selector="Border.browse-card.gamepad-focused">
			<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
			<Setter Property="BorderThickness" Value="3"/>
		</Style>
		<Style Selector="Border.browse-badge">
			<Setter Property="Background" Value="#0ea5e9"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Padding" Value="7,3"/>
			<Setter Property="Margin" Value="10"/>
		</Style>
		<Style Selector="Border.browse-badge.in-library">
			<Setter Property="Background" Value="#22c55e"/>
		</Style>
		<Style Selector="Border.browse-badge TextBlock">
			<Setter Property="FontSize" Value="9"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="LetterSpacing" Value="0.8"/>
			<Setter Property="Foreground" Value="#04121b"/>
		</Style>
		<Style Selector="Path.browse-os">
			<Setter Property="Height" Value="12"/>
			<Setter Property="Stretch" Value="Uniform"/>
			<Setter Property="Fill" Value="#b7c0cc"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Border.browse-ai-chip">
			<Setter Property="BorderBrush" Value="#394451"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="999"/>
			<Setter Property="Padding" Value="6,1"/>
			<Setter Property="Margin" Value="8,0,0,0"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Border.browse-ai-chip TextBlock">
			<Setter Property="FontSize" Value="8"/>
			<Setter Property="LetterSpacing" Value="0.7"/>
			<Setter Property="Foreground" Value="#b7c0cc"/>
		</Style>
		<Style Selector="TextBlock.browse-based-on">
			<Setter Property="FontSize" Value="9"/>
			<Setter Property="LetterSpacing" Value="0.8"/>
			<Setter Property="Foreground" Value="#8f929b"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Border.browse-game-chip">
			<Setter Property="Background" Value="#243044"/>
			<Setter Property="BorderBrush" Value="#3c516c"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="999"/>
			<Setter Property="Padding" Value="9,3"/>
		</Style>
		<Style Selector="Border.browse-game-chip TextBlock">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Foreground" Value="#f4f6f8"/>
		</Style>
		<Style Selector="Run.browse-score">
			<Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
		</Style>
		<Style Selector="Run.browse-score.positive">
			<Setter Property="Foreground" Value="#8ac3a2"/>
		</Style>
		<Style Selector="Run.browse-score.caution">
			<Setter Property="Foreground" Value="#d7b56a"/>
		</Style>
		<Style Selector="Run.browse-score.negative">
			<Setter Property="Foreground" Value="#e38c87"/>
		</Style>
		<Style Selector="TextBlock.browse-release">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Foreground" Value="#8f929b"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="TextBlock.browse-release.stale">
			<Setter Property="Foreground" Value="#d7b56a"/>
		</Style>
	</UserControl.Styles>
	<UserControl.Resources>
		<!-- Platform icons the website shows on its cards (Font Awesome and Simple Icons brand marks). -->
		<StreamGeometry x:Key="BrowseOsWindows">M0 93.7l183.6-25.3v177.4H0V93.7zm0 324.6l183.6 25.3V268.4H0v149.9zm203.8 28L448 480V268.4H203.8v177.9zm0-380.6v180.1H448V32L203.8 65.7z</StreamGeometry>
