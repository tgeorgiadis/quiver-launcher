<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:vm="using:QuiverLauncher.ViewModels"
             x:Class="QuiverLauncher.Views.BrowseView" x:DataType="vm:BrowseViewModel" x:CompileBindings="True">
	<UserControl.Styles>
		<Style Selector="ComboBox.browse-filter">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="MinHeight" Value="40"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
			<Setter Property="Background" Value="{DynamicResource ThemeDarker}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
		</Style>
	</UserControl.Styles>
	<UserControl.Resources>
		<DataTemplate x:Key="BrowseCardTemplate" x:DataType="vm:BrowseItem">
			<Border Classes="catalog-focus-card"
					Width="228"
					CornerRadius="8"
					Margin="0,0,12,12"
					Classes.gamepad-focused="{Binding IsGamepadFocused}"
					Background="{DynamicResource ThemeDarker}"
					BorderBrush="{DynamicResource ThemeBorder}"
					BorderThickness="1"
					ClipToBounds="True"
					Cursor="Hand"
					PlatformFeedback.FeedbackType="Auto"
					Tapped="BrowseCard_Tapped">
				<Grid RowDefinitions="Auto,*">
					<Border Grid.Row="0" Height="128" CornerRadius="8,8,0,0" ClipToBounds="True" Background="{DynamicResource ThemeLighter}">
						<Grid>
							<Path Width="40" Height="40" Stretch="Uniform"
								  HorizontalAlignment="Center" VerticalAlignment="Center"
								  Stroke="{DynamicResource ThemeTextSecondary}" StrokeThickness="1.5"
								  Data="M 3,3 L 10,3 L 10,10 L 3,10 Z M 14,3 L 21,3 L 21,10 L 14,10 Z M 3,14 L 10,14 L 10,21 L 3,21 Z M 14,14 L 21,14 L 21,21 L 14,21 Z"
								  IsVisible="{Binding #BrowseCardArt.Source, Converter={x:Static converters:ObjectConverters.IsNull}}"/>
							<Image x:Name="BrowseCardArt" Stretch="UniformToFill"
								   asyncImageLoader:ImageLoader.Source="{Binding ImageUrl}"/>
							<Border Classes="mod-status-chip" CornerRadius="3" Padding="5,2" Margin="8"
									HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding HasBadge}">
								<TextBlock Text="{Binding Badge}" FontSize="9"/>
							</Border>
						</Grid>
					</Border>
					<StackPanel Grid.Row="1" Margin="10,8,10,10" Spacing="3">
						<TextBlock Text="{Binding Kind}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}"
								   TextTrimming="CharacterEllipsis" IsVisible="{Binding HasKind}"/>
						<TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}"
								   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
						<TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"
								   TextTrimming="CharacterEllipsis" IsVisible="{Binding HasSubtitle}"/>
						<TextBlock Text="{Binding ScoreText}" FontSize="11" Foreground="{DynamicResource ThemeText}"
								   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ScoreText}"/>
						<TextBlock Text="{Binding ReleaseText}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}"
								   TextTrimming="CharacterEllipsis"/>
					</StackPanel>
				</Grid>
			</Border>
		</DataTemplate>
	</UserControl.Resources>
	<Grid x:Name="Surface"
		  XYFocus.NavigationModes="Gamepad,Remote"
		  XYFocus.UpNavigationStrategy="Projection"
		  XYFocus.DownNavigationStrategy="Projection"
		  XYFocus.LeftNavigationStrategy="Projection"
		  XYFocus.RightNavigationStrategy="Projection"
		  RowDefinitions="Auto,Auto,*">
		<!-- Laid out like the website's catalog: title and sort, then search and the four filters. -->
		<Grid x:Name="BrowseToolbarPanel" Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,30,14">
			<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
				<TextBlock x:Name="BrowseTitleText" Text="Explore the catalog" FontSize="18" FontWeight="SemiBold"
						   Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center"/>
				<Border CornerRadius="5" Padding="7,2" VerticalAlignment="Center" BorderThickness="1"
						Background="{DynamicResource ThemeLighter}" BorderBrush="{DynamicResource ThemeBorder}">
					<TextBlock x:Name="BrowseCountText" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}"/>
				</Border>
				<Button x:Name="BrowseCatalogTabButton" Classes="catalog-filter selected" Content="Quiver catalog"
						FontSize="11" MinHeight="32" Margin="14,0,0,0" Click="BrowseSourceTab_Click"/>
				<Button x:Name="BrowseCustomListTabButton" Classes="catalog-filter" Content="My app list"
						FontSize="11" MinHeight="32" Click="BrowseSourceTab_Click"/>
			</StackPanel>
			<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
				<TextBlock x:Name="BrowseSortLabel" Text="Sort by" FontSize="11" VerticalAlignment="Center"
						   Foreground="{DynamicResource ThemeTextSecondary}"/>
				<TextBlock x:Name="BrowseRelevantText" Text="Most relevant ↓" FontSize="11" VerticalAlignment="Center"
						   Foreground="{DynamicResource ThemeTextSecondary}" IsVisible="False"/>
				<ComboBox x:Name="BrowseSortComboBox" Classes="browse-filter" MinWidth="150"
						  SelectionChanged="BrowseSort_SelectionChanged"/>
			</StackPanel>
		</Grid>
		<Grid x:Name="BrowseFiltersPanel" Grid.Row="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,0,30,14">
			<TextBox x:Name="BrowseSearchTextBox" Grid.Column="0"
					 Watermark="Search games, projects, or tags…"
					 MinWidth="200"
					 MinHeight="40"
					 FontSize="12"
					 VerticalContentAlignment="Center"
					 Margin="0,0,18,0"
					 TextChanged="BrowseSearch_TextChanged">
				<TextBox.InnerLeftContent>
					<Path Width="15" Height="15" Margin="12,0,2,0" Stretch="Uniform" VerticalAlignment="Center"
						  Stroke="{DynamicResource ThemeTextSecondary}" StrokeThickness="1.6" StrokeLineCap="Round"
						  Data="M 11,4 A 7,7 0 1 1 10.99,4 Z M 16,16 L 21,21"/>
				</TextBox.InnerLeftContent>
			</TextBox>
			<WrapPanel x:Name="BrowseFilterSelects" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
				<Path Width="17" Height="17" Margin="0,0,10,0" Stretch="Uniform" VerticalAlignment="Center"
					  Stroke="{DynamicResource ThemeTextSecondary}" StrokeThickness="1.6" StrokeLineCap="Round"
					  Data="M 21,4 L 14,4 M 10,4 L 3,4 M 21,12 L 12,12 M 8,12 L 3,12 M 21,20 L 16,20 M 12,20 L 3,20 M 14,2 L 14,6 M 8,10 L 8,14 M 16,18 L 16,22"/>
				<ComboBox x:Name="BrowseTypeComboBox" Classes="browse-filter" MinWidth="140" Margin="0,0,10,0"
						  ToolTip.Tip="Project type" SelectionChanged="BrowseFilter_SelectionChanged"/>
				<ComboBox x:Name="BrowsePlatformComboBox" Classes="browse-filter" MinWidth="130" Margin="0,0,10,0"
						  ToolTip.Tip="Operating system" SelectionChanged="BrowseFilter_SelectionChanged"/>
				<ComboBox x:Name="BrowseConsoleComboBox" Classes="browse-filter" MinWidth="180" Margin="0,0,10,0"
						  ToolTip.Tip="Console" SelectionChanged="BrowseFilter_SelectionChanged"/>
				<ComboBox x:Name="BrowseAiComboBox" Classes="browse-filter" MinWidth="150"
						  ToolTip.Tip="Labels are based on the developer's answer, the README and repository signals"
						  SelectionChanged="BrowseFilter_SelectionChanged"/>
				<Button x:Name="BrowseRetryButton" Classes="options" Content="Try again" FontSize="12" MinHeight="40"
						Margin="10,0,0,0" IsVisible="False" Click="BrowseRetry_Click"/>
				<Button x:Name="BrowseClearFiltersButton" Classes="options" Content="Clear filters" FontSize="12" MinHeight="40"
						Margin="10,0,0,0" IsVisible="False" Click="BrowseClearFilters_Click"/>
			</WrapPanel>
		</Grid>
		<ScrollViewer x:Name="BrowseScrollViewer"
					  Grid.Row="2"
					  VerticalScrollBarVisibility="Auto"
					  HorizontalScrollBarVisibility="Disabled"
					  ScrollChanged="BrowseScrollViewer_ScrollChanged">
			<StackPanel x:Name="BrowseContentStack" Margin="0,0,30,0">
				<StackPanel x:Name="BrowseLoadingPanel" Margin="0,8,0,0" Spacing="8" IsVisible="{Binding IsLoading}">
					<ProgressBar Width="120" Height="4" HorizontalAlignment="Left" Minimum="0" Maximum="100"
								 BorderThickness="0" Background="Transparent" IsIndeterminate="True"/>
					<TextBlock Text="Loading apps…" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"/>
				</StackPanel>
				<ItemsControl x:Name="BrowseItemsControl" ItemsSource="{Binding Items}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<StaticResource ResourceKey="BrowseCardTemplate"/>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				<TextBlock x:Name="BrowseStatusText"
						   Text="{Binding Status}"
						   FontSize="12"
						   Foreground="{DynamicResource ThemeTextSecondary}"
						   TextWrapping="Wrap"
						   Margin="0,8,0,8"/>
				<TextBlock Text="Loading more apps…" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"
						   Margin="0,0,0,12" IsVisible="{Binding IsLoadingMore}"/>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
