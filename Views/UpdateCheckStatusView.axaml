<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QuiverLauncher.ViewModels" x:Class="QuiverLauncher.Views.UpdateCheckStatusView"
             x:DataType="vm:ShellViewModel" x:CompileBindings="True" VerticalContentAlignment="Center">
    <UserControl.Styles>
        <Style Selector="Expander.gamepad-focused /template/ ToggleButton#ExpanderHeader /template/ Border#ToggleButtonBackground, Expander:focus-visible /template/ ToggleButton#ExpanderHeader /template/ Border#ToggleButtonBackground">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
            <Setter Property="BorderThickness" Value="3"/>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="12,6" VerticalAlignment="Center" IsVisible="{Binding ShowUpdateCheckStatus}">
        <TextBlock Text="{Binding UpdateCheckStatus}" TextWrapping="Wrap" VerticalAlignment="Center"
                   FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"/>
        <Button Grid.Column="1" Classes="options" Content="Cancel" IsVisible="{Binding IsCheckingUpdates}"
                MinHeight="28" Padding="8,3" FontSize="12" VerticalAlignment="Center" VerticalContentAlignment="Center" Click="Cancel_Click"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding !IsCheckingUpdates}">
        <Button Classes="options" Content="Retry"
                MinHeight="28" Padding="8,3" FontSize="12" VerticalAlignment="Center" VerticalContentAlignment="Center" Click="Retry_Click"/>
        <Button Classes="options" Content="×" Width="28" MinHeight="28" Padding="0" FontSize="16"
                VerticalAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Dismiss"
                AutomationProperties.Name="Dismiss update status" Click="Dismiss_Click"/>
        </StackPanel>
        <Expander x:Name="CheckDetailsExpander" Focusable="True" Grid.Row="1" Grid.ColumnSpan="2" Header="Check details" IsVisible="{Binding HasUpdateCheckDetails}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,6,0,0">
            <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled">
                <SelectableTextBlock Text="{Binding UpdateCheckDetails}" TextWrapping="Wrap" FontSize="12"
                                     Foreground="{DynamicResource ThemeTextSecondary}" Margin="8"/>
            </ScrollViewer>
        </Expander>
    </Grid>
</UserControl>
