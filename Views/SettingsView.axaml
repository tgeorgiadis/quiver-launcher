<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:QuiverLauncher.Views" xmlns:local="clr-namespace:QuiverLauncher"
             xmlns:vm="clr-namespace:QuiverLauncher.ViewModels"
             xmlns:services="clr-namespace:QuiverLauncher.Services"
             xmlns:loc="clr-namespace:QuiverLauncher.Services"
             x:Class="QuiverLauncher.Views.SettingsView"
             x:DataType="vm:SettingsViewModel" x:CompileBindings="True">
<Border x:Name="SettingsSurface"
						XYFocus.NavigationModes="Gamepad,Remote"
						XYFocus.UpNavigationStrategy="Projection"
						XYFocus.DownNavigationStrategy="Projection"
						XYFocus.LeftNavigationStrategy="Projection"
						XYFocus.RightNavigationStrategy="Projection"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch"
						Background="{DynamicResource ThemeDarker}"
						BorderBrush="{DynamicResource ThemeBorder}"
						BorderThickness="1,0,0,0"
						IsVisible="True"
						Opacity="0.97"
						ZIndex="10">
					<Grid x:Name="SettingsContent" RowDefinitions="Auto,*">

							<!-- Settings Header -->
							<Border Background="{DynamicResource ThemeBase}"
									Padding="20,14,20,14"
									BorderThickness="0,0,0,1"
									BorderBrush="{DynamicResource ThemeBorder}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0"
											   Text="{loc:Translate Text=&quot;Settings&quot;}"
											   FontSize="20"
											   FontWeight="Bold"
											   Foreground="{DynamicResource ThemeText}"
											   VerticalAlignment="Center"/>
									<Button x:Name="CloseSettingsButton"
											Grid.Column="1"
											Classes="modern-icon"
											Width="28"
											Height="28"
											ToolTip.Tip="{loc:Translate Text=&quot;Close settings&quot;}"
											Click="CloseSettingsPanel_Click">
										<Image Width="28"
											   Height="28"
											   Source="avares://QuiverLauncher/Assets/Icons/button_close.png"/>
									</Button>
								</Grid>
							</Border>

							<!-- Tab Control -->
							<TabControl Grid.Row="1" x:Name="SettingsTabControl"
										Background="Transparent"
										Foreground="{DynamicResource ThemeText}"
										Padding="4,4,4,0"
										Margin="0">
								<TabControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal"/>
									</ItemsPanelTemplate>
								</TabControl.ItemsPanel>
								<TabControl.Styles>
									<Style Selector="TabItem">
										<Setter Property="Theme">
											<ControlTheme TargetType="TabItem">
												<Setter Property="Background" Value="Transparent"/>
												<Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
												<Setter Property="BorderBrush" Value="Transparent"/>
												<Setter Property="BorderThickness" Value="0"/>
												<Setter Property="CornerRadius" Value="6"/>
												<Setter Property="Padding" Value="8,4"/>
												<Setter Property="Margin" Value="1,8,1,0"/>
												<Setter Property="FontSize" Value="11"/>
												<Setter Property="FontWeight" Value="SemiBold"/>
												<Setter Property="MinHeight" Value="36"/>
												<Setter Property="Cursor" Value="Hand"/>
												<Setter Property="HorizontalContentAlignment" Value="Center"/>
												<Setter Property="VerticalContentAlignment" Value="Center"/>
												<Setter Property="Template">
													<ControlTemplate TargetType="TabItem">
														<Border Background="{TemplateBinding Background}"
																BorderBrush="{TemplateBinding BorderBrush}"
																BorderThickness="{TemplateBinding BorderThickness}"
																CornerRadius="{TemplateBinding CornerRadius}"
																Padding="{TemplateBinding Padding}">
															<ContentPresenter Content="{TemplateBinding Header}"
																			  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
																			  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
														</Border>
													</ControlTemplate>
												</Setter>
												<Style Selector="^:selected">
													<Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
													<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
												</Style>
												<Style Selector="^:pointerover">
													<Setter Property="Background" Value="{DynamicResource ThemeBase}"/>
													<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
												</Style>
												<Style Selector="^:selected:pointerover">
													<Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
													<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
												</Style>
												<Style Selector="^.gamepad-focused, ^:focus">
													<Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
													<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
													<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
													<Setter Property="BorderThickness" Value="2"/>
												</Style>
												<Style Selector="^:selected.gamepad-focused, ^:selected:focus">
													<Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
													<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
													<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
													<Setter Property="BorderThickness" Value="2"/>
												</Style>
											</ControlTheme>
										</Setter>
									</Style>
								</TabControl.Styles>

								<!-- General Tab -->
								<TabItem Header="{loc:Translate Text=&quot;General&quot;}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
									<StackPanel Margin="16,12,16,16" Spacing="4">
                                        <Border IsVisible="{Binding HasAndroidUpdates}" Margin="0,0,0,12">
                                            <views:AndroidLauncherUpdateView DataContext="{Binding AndroidUpdates}"/>
                                        </Border>

                                        <TextBlock Text="{loc:Translate Text=&quot;Language&quot;}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ThemeText}"/>
                                        <ComboBox ItemsSource="{Binding Languages}"
                                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                                  DisplayMemberBinding="{Binding DisplayName}"
                                                  HorizontalAlignment="Stretch"
                                                  Margin="0,0,0,8"/>
                                        <TextBlock Text="{loc:Translate Text=&quot;Choose the language used by Quiver Launcher.&quot;}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,4"/>

										<!-- Behaviour -->
										<TextBlock Text="{loc:Translate Text=&quot;BEHAVIOUR&quot;}"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>


										<StackPanel Spacing="2">
											<CheckBox x:Name="CloseAfterLaunchCheckBox"
													  Content="{loc:Translate Text=&quot;Close After Launch&quot;}"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsChecked="{Binding CloseAfterLaunch, Mode=TwoWay}"/>
											<TextBlock Text="{loc:Translate Text=&quot;Close the launcher automatically after starting an app&quot;}"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0" IsVisible="{Binding IsDesktopPlatform}">
											<CheckBox x:Name="CloseToTrayCheckBox"
													  Content="{loc:Translate Text=&quot;Close to system tray&quot;}"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsChecked="{Binding CloseToTray, Mode=TwoWay}"/>
											<TextBlock Text="{loc:Translate Text=&quot;Keep Quiver Launcher running in the notification area when the window is closed&quot;}"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0">
											<CheckBox x:Name="IgnoreArticlesWhenSortingCheckBox"
													  Content="{loc:Translate Text=&quot;Ignore The/A/An when sorting by name&quot;}"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsChecked="{Binding IgnoreArticlesWhenSorting, Mode=TwoWay}"/>
											<TextBlock Text="{loc:Translate Text=&quot;Alphabetical sorts skip leading The, A, and An (e.g. The Legend of Zelda under L)&quot;}"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

                                        <StackPanel Spacing="2" Margin="0,8,0,8" IsVisible="{Binding IsDesktopPlatform}">
                                            <TextBlock Text="{loc:Translate Text=&quot;Mouse wheel scroll speed&quot;}" FontSize="13" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="MouseWheelScrollSpeedComboBox" HorizontalAlignment="Stretch"
                                                      SelectedIndex="{Binding MouseWheelScrollSpeedIndex, Mode=TwoWay}"
                                                      AutomationProperties.Name="{loc:Translate Text=&quot;Mouse wheel scroll speed&quot;}">
                                                <ComboBoxItem Content="1×"/>
                                                <ComboBoxItem Content="2×"/>
                                                <ComboBoxItem Content="3×"/>
                                                <ComboBoxItem Content="5×"/>
                                            </ComboBox>
                                            <TextBlock Text="{loc:Translate Text=&quot;Scroll amount per wheel tick in the library and app catalog.&quot;}"
                                                       FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap"/>
                                        </StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<StackPanel Spacing="2" Margin="0,0,0,0">
											<CheckBox x:Name="AutoUpdateNewlyAddedAppsCheckBox"
													  Content="{loc:Translate Text=&quot;Enable Auto Update for newly added apps&quot;}"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsChecked="{Binding AutoUpdateNewlyAddedApps, Mode=TwoWay}"/>
											<TextBlock Text="{loc:Translate Text=&quot;New apps from the catalog or Add Entry start with Auto Update enabled&quot;}"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0">
											<CheckBox x:Name="BackgroundUpdateCheckCheckBox"
													  Content="{loc:Translate Text=&quot;Check for app updates in the background&quot;}"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsChecked="{Binding BackgroundUpdateCheckEnabled, Mode=TwoWay}"/>
											<TextBlock Text="{loc:Translate Text=&quot;Scan for updates on a schedule while Quiver Launcher is running (including in the tray)&quot;}"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0">
											<TextBlock Text="{loc:Translate Text=&quot;Background check interval&quot;}"
													   FontSize="13" FontWeight="SemiBold"
													   Foreground="{DynamicResource ThemeText}"/>
											<ComboBox x:Name="BackgroundUpdateIntervalComboBox"
													  HorizontalAlignment="Stretch"
													  Margin="0,4,0,0"
													  SelectionChanged="BackgroundUpdateIntervalComboBox_SelectionChanged">
												<ComboBoxItem Content="{loc:Translate Text=&quot;Every 15 minutes&quot;}" Tag="15"/>
												<ComboBoxItem Content="{loc:Translate Text=&quot;Every 30 minutes&quot;}" Tag="30"/>
												<ComboBoxItem Content="{loc:Translate Text=&quot;Every hour&quot;}" Tag="60"/>
												<ComboBoxItem Content="{loc:Translate Text=&quot;Every 3 hours&quot;}" Tag="180"/>
												<ComboBoxItem Content="{loc:Translate Text=&quot;Every 6 hours&quot;}" Tag="360"/>
												<ComboBoxItem Content="{loc:Translate Text=&quot;Every 12 hours&quot;}" Tag="720"/>
												<ComboBoxItem Content="{loc:Translate Text=&quot;Every day&quot;}" Tag="1440"/>
											</ComboBox>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0">
											<CheckBox x:Name="PromptCatalogUpdatesCheckBox"
													  Content="{loc:Translate Text=&quot;Prompt when catalog updates are available&quot;}"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsChecked="{Binding PromptCatalogUpdates, Mode=TwoWay}"/>
											<TextBlock Text="{loc:Translate Text=&quot;Show a popup when catalog sources have changes to review (off by default; open App Catalog anytime)&quot;}"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0">
											<CheckBox x:Name="PromptAppUpdateReviewsCheckBox"
													  Content="{loc:Translate Text=&quot;Prompt when library apps have updates&quot;}"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsChecked="{Binding PromptAppUpdateReviews, Mode=TwoWay}"/>
											<TextBlock Text="{loc:Translate Text=&quot;Show app update prompts automatically. Manual update checks still show available updates, and Quiver Launcher self-update prompts still appear.&quot;}"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<StackPanel Spacing="4" IsVisible="{Binding IsDesktopPlatform}">

											<!-- Divider -->
											<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

											<!-- Install Path -->
											<TextBlock Text="{loc:Translate Text=&quot;APP INSTALL PATH&quot;}"
													   FontSize="10" FontWeight="Bold"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   LetterSpacing="1"
													   Margin="0,0,0,4"/>

											<TextBlock Text="{loc:Translate Text=&quot;Leave blank to use the default location&quot;}"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="0,0,0,4"/>

											<Panel HorizontalAlignment="Stretch">
												<TextBox x:Name="GamePathTextBox"
														 Foreground="{DynamicResource ThemeText}"
														 Background="{DynamicResource ThemeBase}"
														 BorderBrush="{DynamicResource ThemeBorder}"
														 BorderThickness="1"
														 Padding="12,10"
														 CornerRadius="4"
														 Margin="0,0,44,0"
														 TextChanged="GamePathTextBox_TextChanged"
														 Text="{Binding Settings.AppsPath, Mode=OneWay}"/>
												<Button Classes="options"
														HorizontalAlignment="Right"
														Width="40"
														Height="40"
														Content="📁"
														Click="BrowseGamePath_Click"/>
											</Panel>

											<Button Classes="options"
													Content="{loc:Translate Text=&quot;Reset to Default&quot;}"
													HorizontalAlignment="Stretch"
													Click="ClearGamePath_Click"
													FontSize="12"/>

											<!-- Divider -->
											<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>
										</StackPanel>

										<!-- Platform & Cache -->
										<TextBlock Text="{loc:Translate Text=&quot;PLATFORM &amp;amp; CACHE&quot;}"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<TextBlock Text="{Binding PlatformString}"
												   FontSize="11"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   Margin="0,0,0,4"/>

										<Button Classes="options"
												Content="{loc:Translate Text=&quot;Change Platform&quot;}"
												HorizontalAlignment="Stretch"
												Click="OptionsButton_Click"
												Tag="{Binding}"
												FontSize="12">
											<Button.ContextMenu>
												<ContextMenu>
													<MenuItem Header="{loc:Translate Text=&quot;Automatic&quot;}"   Click="PlatformAuto_Click"/>
													<MenuItem Header="{loc:Translate Text=&quot;Windows&quot;}"     Click="PlatformWindows_Click"/>
													<MenuItem Header="{loc:Translate Text=&quot;MacOS&quot;}"       Click="PlatformMacOS_Click"/>
													<MenuItem Header="{loc:Translate Text=&quot;Linux X64&quot;}"   Click="PlatformLinuxX64_Click"/>
													<MenuItem Header="{loc:Translate Text=&quot;Linux ARM64&quot;}" Click="PlatformLinuxARM64_Click"/>
													<MenuItem Header="{loc:Translate Text=&quot;Android&quot;}"     Click="PlatformAndroid_Click"/>
												</ContextMenu>
											</Button.ContextMenu>
										</Button>

										<Button Classes="options"
												Content="{loc:Translate Text=&quot;Clear Icon Cache&quot;}"
												HorizontalAlignment="Stretch"
												Click="ClearIconCache_Click"
												FontSize="12"/>

										<StackPanel Spacing="2" IsVisible="{Binding IsLinuxPlatform}">
											<TextBlock Text="{loc:Translate Text=&quot;LINUX WINDOWS RUNNER&quot;}"
													   FontSize="10" FontWeight="Bold"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   LetterSpacing="1"
													   Margin="0,8,0,4"/>
											<TextBox x:Name="LinuxWindowsLaunchCommandTextBox"
													 Foreground="{DynamicResource ThemeText}"
													 Background="{DynamicResource ThemeBase}"
													 BorderBrush="{DynamicResource ThemeBorder}"
													 BorderThickness="1"
													 Padding="12,10"
													 CornerRadius="4"
													 Watermark="{loc:Translate Text=&quot;Example: flatpak run com.usebottles.bottles -e {exe}&quot;}"
													 Text="{Binding Settings.LinuxWindowsLaunchCommand, Mode=TwoWay}"
													 TextChanged="LinuxWindowsLaunchCommandTextBox_TextChanged"/>
											<TextBlock Text="{loc:Translate Text=&quot;Global override for Windows-only apps on Linux when an app uses Auto. Use {exe}, {gamePath}, or {exeDir}. Per-app runner/prefix is under Launch Options → Windows Runner. Leave blank to auto-detect Proton then Wine.&quot;}"
													   FontSize="11"
													   TextWrapping="Wrap"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="0,0,0,4"/>
										</StackPanel>

									</StackPanel>
								</ScrollViewer></TabItem>

								<!-- Controls Tab -->
								<TabItem Header="{loc:Translate Text=&quot;Controls&quot;}" IsVisible="{Binding IsDesktopPlatform}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
									<views:InputBindingsView x:Name="BindingsView"/>
</ScrollViewer></TabItem>

								<!-- Appearance Tab -->
								<TabItem Header="{loc:Translate Text=&quot;Appearance&quot;}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
									<StackPanel Margin="16,12,16,16" Spacing="4">

										<StackPanel Spacing="4" IsVisible="{Binding IsDesktopPlatform}">
											<!-- Window -->
											<TextBlock Text="{loc:Translate Text=&quot;WINDOW&quot;}"
													   FontSize="10" FontWeight="Bold"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   LetterSpacing="1"
													   Margin="0,0,0,4"/>

											<StackPanel Spacing="2" IsVisible="{Binding ShowStartFullscreenSetting}">
												<CheckBox x:Name="StartFullscreenCheckBox"
														  Content="{loc:Translate Text=&quot;Start in Fullscreen&quot;}"
														  Foreground="{DynamicResource ThemeText}"
														  FontSize="13" FontWeight="SemiBold"
														  IsChecked="{Binding StartFullscreen, Mode=TwoWay}"/>
												<TextBlock Text="{loc:Translate Text=&quot;Launch the application in fullscreen mode&quot;}"
														   FontSize="11"
														   Foreground="{DynamicResource ThemeTextSecondary}"
														   Margin="20,0,0,0"/>
											</StackPanel>

											<StackPanel Spacing="2">
												<CheckBox x:Name="ShowOSTopBarCheckBox"
														  Content="{loc:Translate Text=&quot;Show OS Top Bar&quot;}"
														  Foreground="{DynamicResource ThemeText}"
														  FontSize="13" FontWeight="SemiBold"
														  IsChecked="{Binding ShowOSTopBar, Mode=TwoWay}"/>
												<TextBlock Text="{loc:Translate Text=&quot;Display your operating system's title bar&quot;}"
														   FontSize="11"
														   Foreground="{DynamicResource ThemeTextSecondary}"
														   Margin="20,0,0,0"/>
											</StackPanel>

											<StackPanel Spacing="4" Margin="0,8,0,0">
												<TextBlock Text="{loc:Translate Text=&quot;Interface scale&quot;}" FontSize="13" FontWeight="SemiBold"/>
												<ComboBox x:Name="InterfaceScaleComboBox" MinWidth="120" FontSize="13"
													HorizontalAlignment="Left" Focusable="True"
													AutomationProperties.Name="{loc:Translate Text=&quot;Interface scale&quot;}"
													SelectedIndex="{Binding InterfaceScaleIndex, Mode=TwoWay}">
													<ComboBoxItem Content="50%"/>
													<ComboBoxItem Content="75%"/>
													<ComboBoxItem Content="100%"/>
													<ComboBoxItem Content="125%"/>
													<ComboBoxItem Content="150%"/>
													<ComboBoxItem Content="175%"/>
													<ComboBoxItem Content="200%"/>
													<ComboBoxItem Content="225%"/>
												</ComboBox>
												<TextBlock Text="{loc:Translate Text=&quot;Adjust the size of text and controls in Quiver. Applies immediately.&quot;}"
													TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
												<TextBlock Text="{Binding InterfaceScaleNotice}" IsVisible="{Binding ShowInterfaceScaleNotice}"
													TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
											</StackPanel>
											<!-- Divider -->
											<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>
										</StackPanel>

										<!-- Theme Colors -->
										<TextBlock Text="{loc:Translate Text=&quot;THEME COLORS&quot;}"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<Button Classes="options"
												Content="{loc:Translate Text=&quot;Primary Color&quot;}"
												HorizontalAlignment="Stretch"
												Click="ThemeColorPicker_Click"
												FontSize="12"/>
										<Button Classes="options"
												Content="{loc:Translate Text=&quot;Secondary Color&quot;}"
												HorizontalAlignment="Stretch"
												Click="SecondaryColorPicker_Click"
												FontSize="12"/>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<!-- Background Image -->
										<TextBlock Text="{loc:Translate Text=&quot;BACKGROUND IMAGE&quot;}"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<TextBlock Text="{loc:Translate Text=&quot;PNG, JPG, and GIF formats supported&quot;}"
												   FontSize="11"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   Margin="0,0,0,4"/>

										<Button Classes="options"
												Content="{loc:Translate Text=&quot;Select Image&quot;}"
												HorizontalAlignment="Stretch"
												Click="SelectBackgroundImage_Click"
												FontSize="12"/>
										<Button Classes="options"
												Content="{loc:Translate Text=&quot;Clear Background&quot;}"
												HorizontalAlignment="Stretch"
												Click="ClearBackgroundImage_Click"
												IsEnabled="{Binding BackgroundImagePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
												FontSize="12"/>

										<StackPanel Spacing="4" Margin="0,4,0,0">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="{loc:Translate Text=&quot;Opacity:&quot;}"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeText}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=BackgroundOpacitySlider, Path=Value, StringFormat={}{0:F2}}"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeTextSecondary}"/>
											</StackPanel>
											<Slider x:Name="BackgroundOpacitySlider"
													Minimum="0" Maximum="1"
													Value="{Binding BackgroundOpacity}"
													TickFrequency="0.01"
													IsSnapToTickEnabled="True"
													ValueChanged="BackgroundOpacitySlider_ValueChanged"/>
										</StackPanel>

										<StackPanel Spacing="4" IsVisible="{Binding IsDesktopPlatform}">
											<!-- Divider -->
											<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

											<!-- Background Music -->
											<TextBlock Text="{loc:Translate Text=&quot;BACKGROUND MUSIC&quot;}"
													   FontSize="10" FontWeight="Bold"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   LetterSpacing="1"
													   Margin="0,0,0,4"/>

											<TextBlock Text="{loc:Translate Text=&quot;MP3, WAV, and OGG formats supported&quot;}"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="0,0,0,4"/>

											<Button Classes="options"
													Content="{loc:Translate Text=&quot;Select Music&quot;}"
													HorizontalAlignment="Stretch"
													Click="SelectLauncherMusic_Click"
													FontSize="12"/>
											<Button Classes="options"
													Content="{loc:Translate Text=&quot;Clear Music&quot;}"
													HorizontalAlignment="Stretch"
													Click="ClearLauncherMusic_Click"
													IsEnabled="{Binding LauncherMusicPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
													FontSize="12"/>

											<StackPanel Spacing="4" Margin="0,4,0,0">
												<StackPanel Orientation="Horizontal" Spacing="8">
													<TextBlock Text="{loc:Translate Text=&quot;Volume:&quot;}"
															   FontSize="12"
															   Foreground="{DynamicResource ThemeText}"
															   VerticalAlignment="Center"/>
													<TextBlock Text="{Binding ElementName=MusicVolumeSlider, Path=Value, StringFormat={}{0:F2}}"
															   FontSize="12"
															   Foreground="{DynamicResource ThemeTextSecondary}"/>
												</StackPanel>
												<Slider x:Name="MusicVolumeSlider"
														Minimum="0" Maximum="1"
														Value="{Binding MusicVolume}"
														TickFrequency="0.01"
														IsSnapToTickEnabled="True"
														ValueChanged="MusicVolumeSlider_ValueChanged"/>
											</StackPanel>
										</StackPanel>

									</StackPanel>
								</ScrollViewer></TabItem>

								<!-- App Cards Tab -->
								<TabItem Header="{loc:Translate Text=&quot;App Cards&quot;}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
									<StackPanel Margin="16,12,16,16" Spacing="4">

										<!-- Layout -->
										<TextBlock Text="{loc:Translate Text=&quot;LAYOUT&quot;}"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="2">
											<CheckBox x:Name="UseGridViewCheckBox"
													  Content="{loc:Translate Text=&quot;Grid View&quot;}"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsChecked="{Binding UseGridView, Mode=TwoWay}"/>
											<TextBlock Text="{loc:Translate Text=&quot;Display apps in a grid instead of a list&quot;}"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,4,0,0">
											<CheckBox x:Name="GridCompactCardsCheckBox"
													  Content="{loc:Translate Text=&quot;Details in card&quot;}"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsEnabled="{Binding ElementName=UseGridViewCheckBox, Path=IsChecked}"
													  IsChecked="{Binding GridCompactCards, Mode=TwoWay}"/>
											<TextBlock Text="{loc:Translate Text=&quot;Keep name, status, and buttons inside each grid card&quot;}"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"/>
										</StackPanel>

										<StackPanel Spacing="6" Margin="0,4,0,0">
											<TextBlock Text="{loc:Translate Text=&quot;Presets&quot;}"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"/>
											<StackPanel Orientation="Horizontal" Spacing="8">
												<Button Classes="modern-icon" Width="52" Height="52"
														Click="LayoutPreset_Landscape_Click"
														ToolTip.Tip="{loc:Translate Text=&quot;Landscape&quot;}">
													<Image Width="52" Height="52" Source="avares://QuiverLauncher/Assets/Icons/preset_landscape.png"/>
												</Button>
												<Button Classes="modern-icon" Width="52" Height="52"
														Click="LayoutPreset_Square_Click"
														ToolTip.Tip="{loc:Translate Text=&quot;Square&quot;}">
													<Image Width="52" Height="52" Source="avares://QuiverLauncher/Assets/Icons/preset_square.png"/>
												</Button>
												<Button Classes="modern-icon" Width="52" Height="52"
														Click="LayoutPreset_SquareAlt_Click"
														ToolTip.Tip="{loc:Translate Text=&quot;Square Alt&quot;}">
													<Image Width="52" Height="52" Source="avares://QuiverLauncher/Assets/Icons/preset_square_alt.png"/>
												</Button>
												<Button Classes="modern-icon" Width="52" Height="52"
														Click="LayoutPreset_Portrait_Click"
														ToolTip.Tip="{loc:Translate Text=&quot;Portrait&quot;}">
													<Image Width="52" Height="52" Source="avares://QuiverLauncher/Assets/Icons/preset_portrait.png"/>
												</Button>
												<Button Classes="modern-icon" Width="52" Height="52"
														Click="LayoutPreset_List_Click"
														ToolTip.Tip="{loc:Translate Text=&quot;List&quot;}">
													<Image Width="52" Height="52" Source="avares://QuiverLauncher/Assets/Icons/preset_list.png"/>
												</Button>
											</StackPanel>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<!-- Card Content -->
										<TextBlock Text="{loc:Translate Text=&quot;CARD CONTENT&quot;}"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="2" Margin="0,0,0,0">
											<TextBlock Text="{loc:Translate Text=&quot;Library name style&quot;}"
													   FontSize="13"
													   FontWeight="SemiBold"
													   Foreground="{DynamicResource ThemeText}"/>
											<ComboBox x:Name="LibraryNameStyleComboBox"
													  Foreground="{DynamicResource ThemeText}"
													  Background="{DynamicResource ThemeBase}"
													  BorderBrush="{DynamicResource ThemeBorder}"
													  BorderThickness="1"
													  CornerRadius="4"
													  Padding="8"
													  Margin="0,4,0,0"
													  SelectionChanged="LibraryNameStyleComboBox_SelectionChanged">
												<ComboBoxItem Content="{loc:Translate Text=&quot;Name only&quot;}" Tag="NameOnly"/>
												<ComboBoxItem Content="{loc:Translate Text=&quot;Name + project below&quot;}" Tag="NameAndProject"/>
												<ComboBoxItem Content="{loc:Translate Text=&quot;Name (project) in title&quot;}" Tag="NameAndProjectInTitle"/>
												<ComboBoxItem Content="{loc:Translate Text=&quot;Project only&quot;}" Tag="ProjectOnly"/>
											</ComboBox>
											<TextBlock Text="{loc:Translate Text=&quot;How names and projects appear in the Library. “Below” shows the project name under the title. Custom display names always win when set.&quot;}"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0">
											<CheckBox x:Name="TruncateLibraryCardTitlesCheckBox"
													  Content="{loc:Translate Text=&quot;Truncate name, project, and versions on library cards&quot;}"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsChecked="{Binding TruncateLibraryCardTitles, Mode=TwoWay}"/>
											<TextBlock Text="{loc:Translate Text=&quot;Idle cards show an ellipsis. Hover or gamepad/keyboard focus slides the full name, project, and version text.&quot;}"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0">
											<TextBlock Text="{loc:Translate Text=&quot;Tag lines on library cards&quot;}"
													   FontSize="13"
													   FontWeight="SemiBold"
													   Foreground="{DynamicResource ThemeText}"/>
											<ComboBox x:Name="LibraryCardTagMaxLinesComboBox"
													  Foreground="{DynamicResource ThemeText}"
													  Background="{DynamicResource ThemeBase}"
													  BorderBrush="{DynamicResource ThemeBorder}"
													  BorderThickness="1"
													  CornerRadius="4"
													  Padding="8"
													  Margin="0,4,0,0"
													  SelectionChanged="LibraryCardTagMaxLinesComboBox_SelectionChanged">
												<ComboBoxItem Content="{loc:Translate Text=&quot;0 lines&quot;}" Tag="0"/>
												<ComboBoxItem Content="{loc:Translate Text=&quot;1 line&quot;}" Tag="1"/>
												<ComboBoxItem Content="{loc:Translate Text=&quot;2 lines&quot;}" Tag="2"/>
												<ComboBoxItem Content="{loc:Translate Text=&quot;3 lines&quot;}" Tag="3"/>
												<ComboBoxItem Content="{loc:Translate Text=&quot;4 lines&quot;}" Tag="4"/>
												<ComboBoxItem Content="{loc:Translate Text=&quot;No limit&quot;}" Tag="99"/>
											</ComboBox>
											<TextBlock Text="{loc:Translate Text=&quot;How many wrapped lines of tags each library card can show. 0 hides tags on cards; filters still work.&quot;}"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0">
											<CheckBox x:Name="ShowLibraryAppUpdateBadgesCheckBox"
													  Content="{loc:Translate Text=&quot;Show catalog update badges on library cards&quot;}"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsChecked="{Binding ShowLibraryAppUpdateBadges, Mode=TwoWay}"/>
											<TextBlock Text="{loc:Translate Text=&quot;Small badge when catalog metadata for an app has changes to review (app version updates use the orange update button)&quot;}"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<!-- Card Size -->
										<TextBlock Text="{Binding CardSizeLabel}"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="{loc:Translate Text=&quot;Size:&quot;}"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeText}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding DisplayCardSize, StringFormat={}{0:0}}"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeTextSecondary}"/>
											</StackPanel>
											<Slider x:Name="ListRowHeightSlider" Minimum="72" Maximum="400" TickFrequency="4" IsSnapToTickEnabled="True" IsVisible="{Binding !UseGridView}" Value="{Binding ListRowHeight, Mode=TwoWay}"/>
<Slider x:Name="SlotSizeSlider"
													Minimum="120" Maximum="400" IsVisible="{Binding UseGridView}"
													TickFrequency="4"
													IsSnapToTickEnabled="True"
													Value="{Binding SlotSize, Mode=TwoWay}"/>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<!-- Action Buttons -->
										<TextBlock Text="{loc:Translate Text=&quot;ACTION BUTTONS&quot;}"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="{loc:Translate Text=&quot;Size:&quot;}"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeText}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=ActionButtonSizeSlider, Path=Value, StringFormat={}{0:0}}"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeTextSecondary}"/>
											</StackPanel>
											<Slider x:Name="ActionButtonSizeSlider"
													Minimum="32" Maximum="80"
													TickFrequency="4"
													IsSnapToTickEnabled="True"
													Value="{Binding ActionButtonSize, Mode=TwoWay}"/>
											<TextBlock Text="{loc:Translate Text=&quot;Size of Play, Download, and Update buttons&quot;}"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"/>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<!-- App Images -->
										<TextBlock Text="{loc:Translate Text=&quot;GAME IMAGES&quot;}"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<!-- Size -->
										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="{loc:Translate Text=&quot;Size:&quot;}"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeText}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=IconSizeSlider, Path=Value, StringFormat={}{0:0}}"
														   FontSize="11"
														   Foreground="{DynamicResource ThemeTextSecondary}"/>
											</StackPanel>
											<Slider x:Name="IconSizeSlider"
													Minimum="64" Maximum="512"
													TickFrequency="4"
													IsSnapToTickEnabled="True"
													Value="{Binding IconSize, Mode=TwoWay}"/>
										</StackPanel>

										<!-- Custom Image Fill -->
										<StackPanel Spacing="2">
											<CheckBox x:Name="IconFillCheckBox"
													  Content="{loc:Translate Text=&quot;Fill Cards&quot;}"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsChecked="{Binding IconFill, Mode=TwoWay}"/>
											<TextBlock Text="{Binding ImageFillDescription}"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"/>
										</StackPanel>

										<!-- Image Opacity -->
										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="{loc:Translate Text=&quot;Card Image Opacity:&quot;}"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeText}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=IconOpacitySlider, Path=Value, StringFormat={}{0:F1}}"
														   FontSize="11"
														   Foreground="{DynamicResource ThemeTextSecondary}"/>
											</StackPanel>
											<Slider x:Name="IconOpacitySlider"
													Minimum="0.0" Maximum="1.0"
													TickFrequency="0.1"
													IsSnapToTickEnabled="True"
													Value="{Binding IconOpacity, Mode=TwoWay}"/>
											<TextBlock Text="{loc:Translate Text=&quot;Control image transparency&quot;}"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"/>
										</StackPanel>

										<!-- Left Padding -->
										<StackPanel Spacing="4" IsVisible="{Binding UseGridView}">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="{loc:Translate Text=&quot;Left Padding:&quot;}"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeText}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=IconMarginSlider, Path=Value, StringFormat={}{0:0}}"
														   FontSize="11"
														   Foreground="{DynamicResource ThemeTextSecondary}"/>
											</StackPanel>
											<Slider x:Name="IconMarginSlider"
													Minimum="0" Maximum="512"
													TickFrequency="8"
													IsSnapToTickEnabled="True"
													Value="{Binding IconMargin, Mode=TwoWay}"/>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<!-- Text -->
										<TextBlock Text="{loc:Translate Text=&quot;TEXT&quot;}" IsVisible="{Binding UseGridView}"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="4" IsVisible="{Binding UseGridView}">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="{loc:Translate Text=&quot;Text Padding:&quot;}"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeText}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=TextMarginSlider, Path=Value, StringFormat={}{0:0}}"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeTextSecondary}"/>
											</StackPanel>
											<Slider x:Name="TextMarginSlider"
													Minimum="0" Maximum="256"
													TickFrequency="8"
													IsSnapToTickEnabled="True"
													Value="{Binding SlotTextMargin, Mode=TwoWay}"/>
											<TextBlock Text="{loc:Translate Text=&quot;Adjust the left spacing of text labels&quot;}"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"/>
										</StackPanel>

									</StackPanel>
								</ScrollViewer></TabItem>

								<!-- Advanced Tab -->
								<TabItem Header="{loc:Translate Text=&quot;Advanced&quot;}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
									<StackPanel Margin="16,12,16,16" Spacing="4">

										<!-- GitHub API Token -->
										<TextBlock Text="{loc:Translate Text=&quot;GITHUB API TOKEN&quot;}"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<TextBlock Text="{loc:Translate Text=&quot;Increases API rate limits for faster and more reliable downloads&quot;}"
												   FontSize="11"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   TextWrapping="Wrap"
												   Margin="0,0,0,6"/>

										<TextBox x:Name="GitHubTokenTextBox"
												 Foreground="{DynamicResource ThemeText}"
												 Background="{DynamicResource ThemeBase}"
												 BorderBrush="{DynamicResource ThemeBorder}"
												 BorderThickness="1"
												 Padding="12,10"
												 CornerRadius="4"
												 TextChanged="GitHubTokenTextBox_TextChanged"
												 PasswordChar="●"/>
<Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0"><Button x:Name="SaveGitHubTokenButton" Grid.Column="0" Classes="options" Content="{loc:Translate Text=&quot;Save token&quot;}" MinHeight="44" HorizontalAlignment="Stretch" Click="SaveGitHubToken_Click" FontSize="12"/><Button  Grid.Column="1" Classes="options" Content="{loc:Translate Text=&quot;Clear token&quot;}" MinHeight="44" HorizontalAlignment="Stretch" Click="ClearGitHubToken_Click" FontSize="12"/></Grid>
<TextBlock Text="{loc:Translate Text=&quot;Save to apply your token and resume waiting checks.&quot;}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,8"/>
<Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button  Grid.Column="0" Classes="options" Content="{loc:Translate Text=&quot;Create token&quot;}" MinHeight="32" Padding="10,4" HorizontalAlignment="Stretch" Click="CreateGitHubToken_Click" FontSize="12"/><Button x:Name="GitHubTokenHelpButton" Grid.Column="1" Classes="options" Content="{loc:Translate Text=&quot;Setup guide&quot;}" MinHeight="32" Padding="10,4" HorizontalAlignment="Stretch" Click="GitHubTokenHelp_Click" FontSize="12"/></Grid><StackPanel x:Name="GitHubTokenHelpText" IsVisible="False" Spacing="6" Margin="0,8,0,8"><TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" Text="{x:Static services:GitHubTokenSetupGuide.Introduction}"/><TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" Text="{x:Static services:GitHubTokenSetupGuide.CreateStep}"/><TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" Text="{x:Static services:GitHubTokenSetupGuide.ExpirationStep}"/><TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" Text="{x:Static services:GitHubTokenSetupGuide.PermissionsStep}"/><TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" Text="{x:Static services:GitHubTokenSetupGuide.GenerateStep}"/><TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" Text="{x:Static services:GitHubTokenSetupGuide.SaveStep}"/><TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" Text="{x:Static services:GitHubTokenSetupGuide.Privacy}"/></StackPanel>
<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,12,0,8"/>

										<!-- GitLab API Token -->
										<TextBlock Text="{loc:Translate Text=&quot;GITLAB API TOKEN&quot;}"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<TextBlock Text="{loc:Translate Text=&quot;Optional. Raises GitLab API rate limits and allows private gitlab.com projects&quot;}"
												   FontSize="11"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   TextWrapping="Wrap"
												   Margin="0,0,0,6"/>

										<TextBox x:Name="GitLabTokenTextBox"
												 Foreground="{DynamicResource ThemeText}"
												 Background="{DynamicResource ThemeBase}"
												 BorderBrush="{DynamicResource ThemeBorder}"
												 BorderThickness="1"
												 Padding="12,10"
												 CornerRadius="4"
												 TextChanged="GitLabTokenTextBox_TextChanged"
												 PasswordChar="●"/>
<Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0"><Button x:Name="SaveGitLabTokenButton" Grid.Column="0" Classes="options" Content="{loc:Translate Text=&quot;Save token&quot;}" MinHeight="44" HorizontalAlignment="Stretch" Click="SaveGitLabToken_Click" FontSize="12"/><Button  Grid.Column="1" Classes="options" Content="{loc:Translate Text=&quot;Clear token&quot;}" MinHeight="44" HorizontalAlignment="Stretch" Click="ClearGitLabToken_Click" FontSize="12"/></Grid>
<TextBlock Text="{loc:Translate Text=&quot;Save to apply your token and resume waiting checks.&quot;}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,8"/>
<Button  Grid.Column="0" Classes="options" Content="{loc:Translate Text=&quot;Create token&quot;}" MinHeight="32" Padding="10,4" HorizontalAlignment="Stretch" Click="CreateGitLabToken_Click" FontSize="12"/><TextBlock Text="{loc:Translate Text=&quot;Choose the read_api scope for release access.&quot;}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,4,0,0"/>
<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,12,0,8"/>

										<StackPanel Spacing="2">
											<CheckBox x:Name="AllowPrereleaseLauncherUpdatesCheckBox"
													  Content="{loc:Translate Text=&quot;Include preview updates&quot;}"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsChecked="{Binding AllowPrereleaseLauncherUpdates, Mode=TwoWay}"/>
											<TextBlock Text="{loc:Translate Text=&quot;Get early Quiver Launcher releases. Preview versions may be unstable.&quot;}"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

									</StackPanel>
								</ScrollViewer></TabItem>

							</TabControl>
					</Grid>
				</Border>
</UserControl>
