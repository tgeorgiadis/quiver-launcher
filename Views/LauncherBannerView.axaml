<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:QuiverLauncher.Services" x:Class="QuiverLauncher.Views.LauncherBannerView" x:CompileBindings="True">
<StackPanel>
			<Border x:Name="AnnouncementBanner"
					Classes="announcement-banner"
					IsVisible="False">
				<Grid ColumnDefinitions="*,Auto" Margin="12,8">
					<TextBlock x:Name="AnnouncementBannerText"
							   Grid.Column="0"
							   TextWrapping="Wrap"
							   VerticalAlignment="Center"
							   FontSize="13"
							   FontWeight="SemiBold"
							   Margin="0,0,12,0"/>
					<Button x:Name="AnnouncementBannerCloseButton"
							Grid.Column="1"
							Classes="announcement-banner-close"
							Content="{loc:Translate Text=&quot;✕&quot;}"
							Width="32"
							Height="28"
							FontSize="14"
							FontWeight="Bold"
							VerticalAlignment="Center"
							ToolTip.Tip="{loc:Translate Text=&quot;Dismiss&quot;}"
							Click="AnnouncementBannerClose_Click"/>
				</Grid>
			</Border>
			<Border x:Name="GitHubTokenBanner"
					Classes="github-token-banner"
					IsVisible="False">
				<Grid ColumnDefinitions="*,Auto" Margin="12,8">
					<StackPanel Grid.Column="0" Margin="0,0,12,0" Spacing="2">
						<TextBlock x:Name="GitHubTokenBannerText"
								   Text="{loc:Translate Text=&quot;GitHub rate-limits unauthenticated use, so catalog refresh and downloads can fail or stall.&quot;}"
								   TextWrapping="Wrap"
								   VerticalAlignment="Center"
								   FontSize="13"
								   FontWeight="SemiBold"/>
						<WrapPanel Orientation="Horizontal">
							<Button x:Name="GitHubTokenBannerSettingsButton"
									Classes="github-token-banner-link"
									Click="GitHubTokenBannerSettings_Click">
								<TextBlock Text="{loc:Translate Text=&quot;Set a GitHub token&quot;}"/>
							</Button>
							<Button x:Name="GitHubTokenBannerDontShowAgainButton"
									Classes="github-token-banner-link"
									Click="GitHubTokenBannerDontShowAgain_Click">
								<TextBlock Text="{loc:Translate Text=&quot;Don't show this again&quot;}"/>
							</Button>
						</WrapPanel>
					</StackPanel>
					<Button x:Name="GitHubTokenBannerCloseButton"
							Grid.Column="1"
							Classes="github-token-banner-close"
							Content="{loc:Translate Text=&quot;✕&quot;}"
							Width="32"
							Height="28"
							FontSize="14"
							FontWeight="Bold"
							VerticalAlignment="Center"
							ToolTip.Tip="{loc:Translate Text=&quot;Dismiss for a week&quot;}"
							Click="GitHubTokenBannerClose_Click"/>
				</Grid>
			</Border>
			</StackPanel>
</UserControl>