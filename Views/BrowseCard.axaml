<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:vm="using:QuiverLauncher.ViewModels"
             xmlns:services="using:QuiverLauncher.Services"
             x:Class="QuiverLauncher.Views.BrowseCard" x:DataType="vm:BrowseItem" x:CompileBindings="True">
	<UserControl.Styles>
	<!-- The catalog card, coloured like the website's. -->
	<Style Selector="Border.browse-card">
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
		<Setter Property="Background" Value="{DynamicResource ThemeBase}"/>
	</Style>
	<Style Selector="Border.browse-card:pointerover">
		<Setter Property="BorderBrush" Value="#0ea5e9"/>
	</Style>
	<Style Selector="Border.browse-card.gamepad-focused">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="3"/>
	</Style>
	<Style Selector="Border.browse-badge">
		<Setter Property="Background" Value="#0ea5e9"/>
		<Setter Property="CornerRadius" Value="4"/>
		<Setter Property="Padding" Value="7,3"/>
		<Setter Property="Margin" Value="10"/>
	</Style>
	<Style Selector="Border.browse-badge.in-library">
		<Setter Property="Background" Value="#22c55e"/>
	</Style>
	<Style Selector="Border.browse-badge TextBlock">
		<Setter Property="FontSize" Value="9"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="LetterSpacing" Value="0.8"/>
		<Setter Property="Foreground" Value="#04121b"/>
	</Style>
	<Style Selector="Path.browse-os">
		<Setter Property="Height" Value="12"/>
		<Setter Property="Stretch" Value="Uniform"/>
		<Setter Property="Fill" Value="#b7c0cc"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>
	<Style Selector="Border.browse-ai-chip">
		<Setter Property="BorderBrush" Value="#394451"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="999"/>
		<Setter Property="Padding" Value="6,1"/>
		<Setter Property="Margin" Value="8,0,0,0"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>
	<Style Selector="Border.browse-ai-chip TextBlock">
		<Setter Property="FontSize" Value="8"/>
		<Setter Property="LetterSpacing" Value="0.7"/>
		<Setter Property="Foreground" Value="#b7c0cc"/>
	</Style>
	<Style Selector="TextBlock.browse-based-on">
		<Setter Property="FontSize" Value="9"/>
		<Setter Property="LetterSpacing" Value="0.8"/>
		<Setter Property="Foreground" Value="#8f929b"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>
	<Style Selector="Border.browse-game-chip">
		<Setter Property="Background" Value="#243044"/>
		<Setter Property="BorderBrush" Value="#3c516c"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="999"/>
		<Setter Property="Padding" Value="9,3"/>
	</Style>
	<Style Selector="Border.browse-game-chip TextBlock">
		<Setter Property="FontSize" Value="11"/>
		<Setter Property="Foreground" Value="#f4f6f8"/>
	</Style>
	<Style Selector="Run.browse-score">
		<Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
	</Style>
	<Style Selector="Run.browse-score.positive">
		<Setter Property="Foreground" Value="#8ac3a2"/>
	</Style>
	<Style Selector="Run.browse-score.caution">
		<Setter Property="Foreground" Value="#d7b56a"/>
	</Style>
	<Style Selector="Run.browse-score.negative">
		<Setter Property="Foreground" Value="#e38c87"/>
	</Style>
	<Style Selector="TextBlock.browse-release">
		<Setter Property="FontSize" Value="11"/>
		<Setter Property="Foreground" Value="#8f929b"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>
	<Style Selector="TextBlock.browse-release.stale">
		<Setter Property="Foreground" Value="#d7b56a"/>
	</Style>
	</UserControl.Styles>
	<Border Classes="catalog-focus-card browse-card"
			Width="256"
			CornerRadius="9"
			Margin="0,0,14,14"
			Classes.gamepad-focused="{Binding IsGamepadFocused}"
			ClipToBounds="True"
			Cursor="Hand"
			PlatformFeedback.FeedbackType="Auto"
	PointerEntered="Card_PointerEntered"
			PointerExited="Card_PointerExited">
		<Grid RowDefinitions="Auto,*">
			<Border Grid.Row="0" Height="140" ClipToBounds="True" Background="{DynamicResource ThemeLighter}">
				<Grid>
					<Path Width="40" Height="40" Stretch="Uniform"
						  HorizontalAlignment="Center" VerticalAlignment="Center"
						  Stroke="{DynamicResource ThemeTextSecondary}" StrokeThickness="1.5"
						  Data="M 3,3 L 10,3 L 10,10 L 3,10 Z M 14,3 L 21,3 L 21,10 L 14,10 Z M 3,14 L 10,14 L 10,21 L 3,21 Z M 14,14 L 21,14 L 21,21 L 14,21 Z"
						  IsVisible="{Binding #BrowseCardArt.Source, Converter={x:Static converters:ObjectConverters.IsNull}}"/>
					<Image x:Name="BrowseCardArt" Stretch="UniformToFill"
						   asyncImageLoader:ImageLoader.Source="{Binding ImageUrl}"/>
					<Border Classes="browse-badge" Classes.in-library="{Binding InLibrary}"
							HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding HasBadge}">
						<TextBlock Text="{Binding BadgeText}"/>
					</Border>
				</Grid>
			</Border>
			<StackPanel Grid.Row="1" Margin="14,14,14,11">
				<Grid ColumnDefinitions="*,Auto,Auto" MinHeight="13" Margin="0,0,0,6">
					<services:HoverScrollText Grid.Column="0" Text="{Binding CardKind}" IsActive="{Binding ShouldScroll}"
											  FontSize="9" LetterSpacing="0.7" Foreground="#94a3b8" VerticalAlignment="Center"/>
					<Border Grid.Column="1" Classes="browse-ai-chip" IsVisible="{Binding HasAiChip}">
						<TextBlock Text="{Binding AiChip}"/>
					</Border>
					<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" Margin="8,0,0,0" VerticalAlignment="Center"
								Background="Transparent" ToolTip.Tip="{Binding PlatformTip}">
						<Path Classes="browse-os" Data="{x:Static services:PlatformIcons.Windows}" IsVisible="{Binding RunsOnWindows}"/>
						<Path Classes="browse-os" Data="{x:Static services:PlatformIcons.MacOS}" IsVisible="{Binding RunsOnMacOS}"/>
						<Path Classes="browse-os" Data="{x:Static services:PlatformIcons.Linux}" IsVisible="{Binding RunsOnLinux}"/>
						<Path Classes="browse-os" Data="{x:Static services:PlatformIcons.Android}" IsVisible="{Binding RunsOnAndroid}"/>
						<Path Classes="browse-os" Data="{x:Static services:PlatformIcons.IOS}" IsVisible="{Binding RunsOnIOS}"/>
					</StackPanel>
				</Grid>
				<services:HoverScrollText Text="{Binding Title}" IsActive="{Binding ShouldScroll}"
										  FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}"/>
				<Grid ColumnDefinitions="Auto,*" Margin="0,8,0,0" IsVisible="{Binding HasBasedOn}">
					<TextBlock Grid.Column="0" Classes="browse-based-on" Text="BASED ON" Margin="0,0,6,0"/>
					<services:HoverScrollRow Grid.Column="1" IsActive="{Binding ShouldScroll}" HorizontalAlignment="Left">
					<ItemsControl ItemsSource="{Binding BasedOn}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal" Spacing="6"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="x:String">
								<Border Classes="browse-game-chip">
									<TextBlock Text="{Binding}"/>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					</services:HoverScrollRow>
				</Grid>
				<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,14,0,11" IsVisible="{Binding HasFooter}"/>
				<Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasFooter}">
					<services:HoverScrollRow Grid.Column="0" IsActive="{Binding ShouldScroll}" Margin="0,0,8,0" HorizontalAlignment="Left">
					<TextBlock FontSize="11">
						<Run Classes="browse-score" Classes.positive="{Binding ScorePositive}" Classes.caution="{Binding ScoreCaution}"
							 Classes.negative="{Binding ScoreNegative}" Text="{Binding ScoreLabel}"/><Run
							 FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Text="{Binding ScoreCounts}"/>
					</TextBlock>
					</services:HoverScrollRow>
					<TextBlock Grid.Column="1" Classes="browse-release" Classes.stale="{Binding ReleaseStale}" Text="{Binding ReleaseText}"/>
				</Grid>
			</StackPanel>
		</Grid>
	</Border>
</UserControl>
