<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:vm="using:QuiverLauncher.ViewModels"
             xmlns:services="using:QuiverLauncher.Services"
             x:Class="QuiverLauncher.Views.BrowseCard" x:DataType="vm:BrowseItem" x:CompileBindings="True">
	<UserControl.Styles>
	<!-- The catalog card, coloured like the website's. -->
	<Style Selector="Border.browse-card">
		<Setter Property="Width" Value="256"/>
		<Setter Property="Margin" Value="0,0,14,14"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
		<Setter Property="Background" Value="{DynamicResource ThemeBase}"/>
	</Style>
	<Style Selector="Border.browse-card:pointerover">
		<Setter Property="BorderBrush" Value="#0ea5e9"/>
	</Style>
	<Style Selector="Border.browse-card.gamepad-focused">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="3"/>
	</Style>
	<!-- NEW is green, so it doesn't look like the blue + Add button; IN LIBRARY is a quiet light grey. -->
	<Style Selector="Border.browse-badge">
		<Setter Property="Background" Value="#22c55e"/>
		<Setter Property="CornerRadius" Value="4"/>
		<Setter Property="Padding" Value="7,3"/>
		<Setter Property="Margin" Value="10"/>
	</Style>
	<!-- Adds the app to the library without opening its page. -->
	<Style Selector="Button.browse-add">
		<Setter Property="Background" Value="#0ea5e9"/>
		<Setter Property="Foreground" Value="#04121b"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="CornerRadius" Value="999"/>
		<Setter Property="Padding" Value="11,4"/>
		<Setter Property="Margin" Value="10"/>
		<Setter Property="MinHeight" Value="0"/>
		<Setter Property="FontSize" Value="11"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>
	<Style Selector="Button.browse-add:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="#38bdf8"/>
		<Setter Property="Foreground" Value="#04121b"/>
	</Style>
	<Style Selector="Button.browse-add.in-library">
		<Setter Property="Background" Value="#e2e8f0"/>
	</Style>
	<Style Selector="Button.browse-add.in-library:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="#f8fafc"/>
		<Setter Property="Foreground" Value="#04121b"/>
	</Style>
	<Style Selector="Button.browse-add:disabled /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="#0b7fb3"/>
		<Setter Property="Foreground" Value="#04121b"/>
	</Style>
	<Style Selector="Border.browse-badge.in-library">
		<Setter Property="Background" Value="#e2e8f0"/>
	</Style>
	<Style Selector="Border.browse-badge TextBlock">
		<Setter Property="FontSize" Value="9"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="LetterSpacing" Value="0.8"/>
		<Setter Property="Foreground" Value="#04121b"/>
	</Style>
	<Style Selector="Path.browse-os">
		<Setter Property="Height" Value="12"/>
		<Setter Property="Stretch" Value="Uniform"/>
		<Setter Property="Fill" Value="#b7c0cc"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>
	<Style Selector="Border.browse-cover">
		<Setter Property="Height" Value="140"/>
	</Style>
	<Style Selector="StackPanel.browse-card-body">
		<Setter Property="Margin" Value="14,14,14,11"/>
	</Style>
	<Style Selector="StackPanel.browse-os-icons">
		<Setter Property="Grid.Column" Value="2"/>
		<Setter Property="Margin" Value="8,0,0,0"/>
	</Style>
	<Style Selector="services|HoverScrollText.browse-title">
		<Setter Property="FontSize" Value="14"/>
	</Style>
	<Style Selector="services|HoverScrollRow.browse-score-row">
		<Setter Property="Margin" Value="0,0,8,0"/>
	</Style>
	<Style Selector="TextBlock.browse-score-text">
		<Setter Property="FontSize" Value="11"/>
	</Style>
	<Style Selector="Border.browse-ai-chip">
		<Setter Property="Grid.Column" Value="1"/>
		<Setter Property="BorderBrush" Value="#394451"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="999"/>
		<Setter Property="Padding" Value="6,1"/>
		<Setter Property="Margin" Value="8,0,0,0"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>
	<Style Selector="Border.browse-ai-chip TextBlock">
		<Setter Property="FontSize" Value="8"/>
		<Setter Property="LetterSpacing" Value="0.7"/>
		<Setter Property="Foreground" Value="#b7c0cc"/>
	</Style>
	<Style Selector="TextBlock.browse-based-on">
		<Setter Property="FontSize" Value="9"/>
		<Setter Property="LetterSpacing" Value="0.8"/>
		<Setter Property="Foreground" Value="#8f929b"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>
	<Style Selector="Border.browse-game-chip">
		<Setter Property="Background" Value="#243044"/>
		<Setter Property="BorderBrush" Value="#3c516c"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="999"/>
		<Setter Property="Padding" Value="9,3"/>
	</Style>
	<Style Selector="Border.browse-game-chip TextBlock">
		<Setter Property="FontSize" Value="11"/>
		<Setter Property="Foreground" Value="#f4f6f8"/>
	</Style>
	<Style Selector="Run.browse-score">
		<Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
	</Style>
	<Style Selector="Run.browse-score.positive">
		<Setter Property="Foreground" Value="#8ac3a2"/>
	</Style>
	<Style Selector="Run.browse-score.caution">
		<Setter Property="Foreground" Value="#d7b56a"/>
	</Style>
	<Style Selector="Run.browse-score.negative">
		<Setter Property="Foreground" Value="#e38c87"/>
	</Style>
	<Style Selector="TextBlock.browse-release">
		<Setter Property="Grid.Column" Value="1"/>
		<Setter Property="FontSize" Value="11"/>
		<Setter Property="Foreground" Value="#8f929b"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>
	<Style Selector="TextBlock.browse-release.stale">
		<Setter Property="Foreground" Value="#d7b56a"/>
	</Style>
	<!-- Two to a row on a phone, as the website draws a narrow card: the kind on its own line, the AI label and
	     platforms under it, then the score and the release date on lines of their own. -->
	<Style Selector=".fill-cards Border.browse-card">
		<Setter Property="Width" Value="NaN"/>
		<Setter Property="Margin" Value="0"/>
	</Style>
	<Style Selector=".narrow-cards Border.browse-card">
		<Setter Property="Width" Value="NaN"/>
		<Setter Property="Margin" Value="0"/>
	</Style>
	<Style Selector=".narrow-cards Border.browse-cover">
		<Setter Property="Height" Value="156"/>
	</Style>
	<Style Selector=".narrow-cards StackPanel.browse-card-body">
		<Setter Property="Margin" Value="12,13,12,12"/>
	</Style>
	<Style Selector=".narrow-cards services|HoverScrollText.browse-kind">
		<Setter Property="Grid.ColumnSpan" Value="3"/>
	</Style>
	<Style Selector=".narrow-cards Border.browse-ai-chip">
		<Setter Property="Grid.Row" Value="1"/>
		<Setter Property="Grid.Column" Value="0"/>
		<Setter Property="HorizontalAlignment" Value="Left"/>
		<Setter Property="Margin" Value="0,6,0,0"/>
	</Style>
	<Style Selector=".narrow-cards StackPanel.browse-os-icons">
		<Setter Property="Grid.Row" Value="1"/>
		<Setter Property="MinHeight" Value="16"/>
		<Setter Property="Margin" Value="8,6,0,0"/>
	</Style>
	<Style Selector=".narrow-cards services|HoverScrollText.browse-title">
		<Setter Property="FontSize" Value="13"/>
	</Style>
	<Style Selector=".narrow-cards services|HoverScrollRow.browse-score-row">
		<Setter Property="Grid.ColumnSpan" Value="2"/>
		<Setter Property="Margin" Value="0"/>
	</Style>
	<Style Selector=".narrow-cards TextBlock.browse-score-text">
		<Setter Property="FontSize" Value="12"/>
	</Style>
	<Style Selector=".narrow-cards TextBlock.browse-release">
		<Setter Property="Grid.Row" Value="1"/>
		<Setter Property="Grid.Column" Value="0"/>
		<Setter Property="HorizontalAlignment" Value="Left"/>
		<Setter Property="Margin" Value="0,4,0,0"/>
		<Setter Property="FontSize" Value="12"/>
	</Style>
	</UserControl.Styles>
	<Border Classes="catalog-focus-card browse-card"
			CornerRadius="9"
			Classes.gamepad-focused="{Binding IsGamepadFocused}"
			ClipToBounds="True"
			Cursor="Hand"
			PlatformFeedback.FeedbackType="Auto"
	PointerEntered="Card_PointerEntered"
			PointerExited="Card_PointerExited">
		<Grid RowDefinitions="Auto,*">
			<Border Grid.Row="0" Classes="browse-cover" ClipToBounds="True" Background="{DynamicResource ThemeLighter}">
				<Grid>
					<Path Width="40" Height="40" Stretch="Uniform"
						  HorizontalAlignment="Center" VerticalAlignment="Center"
						  Stroke="{DynamicResource ThemeTextSecondary}" StrokeThickness="1.5"
						  Data="M 3,3 L 10,3 L 10,10 L 3,10 Z M 14,3 L 21,3 L 21,10 L 14,10 Z M 3,14 L 10,14 L 10,21 L 3,21 Z M 14,14 L 21,14 L 21,21 L 14,21 Z"
						  IsVisible="{Binding #BrowseCardArt.Source, Converter={x:Static converters:ObjectConverters.IsNull}}"/>
					<Image x:Name="BrowseCardArt" Stretch="UniformToFill"
						   asyncImageLoader:ImageLoader.Source="{Binding ImageUrl}"/>
					<Border Classes="browse-badge" Classes.in-library="{Binding InLibrary}"
							HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding HasBadge}">
						<TextBlock Text="{Binding BadgeText}"/>
					</Border>
					<Button x:Name="BrowseCardAddButton" Classes="browse-add" HorizontalAlignment="Right" VerticalAlignment="Bottom"
							Focusable="False" Content="{Binding CardActionText}" ToolTip.Tip="{Binding CardActionTip}"
							Classes.in-library="{Binding InLibrary}"
							IsVisible="{Binding ShowCardAction}" IsEnabled="{Binding !IsAdding}" Click="Add_Click"/>
				</Grid>
			</Border>
			<StackPanel Grid.Row="1" Classes="browse-card-body">
				<Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" MinHeight="13" Margin="0,0,0,6">
					<services:HoverScrollText Classes="browse-kind" Text="{Binding CardKind}" IsActive="{Binding ShouldScroll}"
											  FontSize="9" LetterSpacing="0.7" Foreground="#94a3b8" VerticalAlignment="Center"/>
					<Border Classes="browse-ai-chip" IsVisible="{Binding HasAiChip}">
						<TextBlock Text="{Binding AiChip}"/>
					</Border>
					<StackPanel Classes="browse-os-icons" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" HorizontalAlignment="Right"
								Background="Transparent" ToolTip.Tip="{Binding PlatformTip}">
						<Path Classes="browse-os" Data="{x:Static services:PlatformIcons.Windows}" IsVisible="{Binding RunsOnWindows}"/>
						<Path Classes="browse-os" Data="{x:Static services:PlatformIcons.MacOS}" IsVisible="{Binding RunsOnMacOS}"/>
						<Path Classes="browse-os" Data="{x:Static services:PlatformIcons.Linux}" IsVisible="{Binding RunsOnLinux}"/>
						<Path Classes="browse-os" Data="{x:Static services:PlatformIcons.Android}" IsVisible="{Binding RunsOnAndroid}"/>
						<Path Classes="browse-os" Data="{x:Static services:PlatformIcons.IOS}" IsVisible="{Binding RunsOnIOS}"/>
					</StackPanel>
				</Grid>
				<services:HoverScrollText Classes="browse-title" Text="{Binding Title}" IsActive="{Binding ShouldScroll}"
										  FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}"/>
				<Grid ColumnDefinitions="Auto,*" Margin="0,8,0,0" IsVisible="{Binding HasBasedOn}">
					<TextBlock Grid.Column="0" Classes="browse-based-on" Text="BASED ON" Margin="0,0,6,0"/>
					<services:HoverScrollRow Grid.Column="1" IsActive="{Binding ShouldScroll}" HorizontalAlignment="Left">
					<ItemsControl ItemsSource="{Binding BasedOn}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal" Spacing="6"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="x:String">
								<Border Classes="browse-game-chip">
									<TextBlock Text="{Binding}"/>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					</services:HoverScrollRow>
				</Grid>
				<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,14,0,11" IsVisible="{Binding HasFooter}"/>
				<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" IsVisible="{Binding HasFooter}">
					<services:HoverScrollRow Classes="browse-score-row" IsActive="{Binding ShouldScroll}" HorizontalAlignment="Left">
					<TextBlock Classes="browse-score-text">
						<Run Classes="browse-score" Classes.positive="{Binding ScorePositive}" Classes.caution="{Binding ScoreCaution}"
							 Classes.negative="{Binding ScoreNegative}" Text="{Binding ScoreLabel}"/><Run
							 FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Text="{Binding ScoreCounts}"/>
					</TextBlock>
					</services:HoverScrollRow>
					<TextBlock Classes="browse-release" Classes.stale="{Binding ReleaseStale}" Text="{Binding ReleaseText}"/>
				</Grid>
			</StackPanel>
		</Grid>
	</Border>
</UserControl>
