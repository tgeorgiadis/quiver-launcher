# Anonymous usage data and error reports, as on quiverlauncher.com. Copy to
# .env.local to try it.
#
# 1 sends usage data. Without it the launcher sends nothing and shows no usage
# data switch or notice. Release builds set it in their workflows.
VITE_USAGE_DATA=

# `pnpm dev` sends nothing even so, so local hacking doesn't count; set this to
# 1 to send from a dev build too.
VITE_USAGE_DEV=

# Where error reports go (Sentry's launcher project). Without it none are sent.
VITE_SENTRY_DSN=

# Where events go is chosen when the launcher runs, not when it's built:
# QUIVER_USAGE_HOST (default https://quiverlauncher.com). End-to-end tests point
# it at their mock API, and anywhere but the default sends no error reports.
