# Anonymous usage data (PostHog), as on quiverlauncher.com. Copy to .env.local to try it.
#
# The PostHog project token, the same one the website uses. Without it the
# launcher sends nothing and shows no usage data switch or notice. Release
# builds get it from the environment (CI: the POSTHOG_PROJECT_TOKEN variable).
VITE_POSTHOG_PROJECT_TOKEN=

# `pnpm dev` sends nothing even with a token, so local hacking doesn't count;
# set this to 1 to send from a dev build too.
VITE_POSTHOG_DEV=

# Where events go is chosen when the launcher runs, not when it's built:
# QUIVER_POSTHOG_HOST (default https://us.i.posthog.com). End-to-end tests point
# it at their mock API.
