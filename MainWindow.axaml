		<Setter Property="CornerRadius" Value="14"/>
		<Setter Property="Margin" Value="10"/>
		<Setter Property="BorderThickness" Value="3"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
	</Style>

	<Style Selector="Border.gamecardcompact">
		<Setter Property="Background" Value="{DynamicResource ThemeBase}"/>
		<Setter Property="CornerRadius" Value="14"/>
		<Setter Property="Margin" Value="6"/>
		<Setter Property="BorderThickness" Value="3"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
	</Style>

	<!-- Catalog/review cards: keep BorderBrush/Background in styles so gamepad-focused can override. -->
	<Style Selector="Border.catalog-focus-card">
		<Setter Property="Background" Value="{DynamicResource ThemeBase}"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="3"/>
	</Style>

	<!-- Installed badge: solid green + border so it reads on thumbnails. -->
	<Style Selector="Border.mod-status-chip">
		<Setter Property="Background" Value="#E622c55e"/>
		<Setter Property="BorderBrush" Value="#166534"/>
		<Setter Property="BorderThickness" Value="1.5"/>
	</Style>

	<Style Selector="Border.mod-status-chip TextBlock">
		<Setter Property="Foreground" Value="#FFFFFF"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
	</Style>

	<!-- Update available: same family, outlined so it stays distinct from Installed. -->
	<Style Selector="Border.mod-status-chip.mod-update-available">
		<Setter Property="Background" Value="#E616a34a"/>
		<Setter Property="BorderBrush" Value="#BBF7D0"/>
		<Setter Property="BorderThickness" Value="1.5"/>
	</Style>

	<Style Selector="Border.mod-status-chip.mod-update-available TextBlock">
		<Setter Property="Foreground" Value="#FFFFFF"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
	</Style>

	<Style Selector="Button.options.mod-update">
		<Setter Property="Background" Value="{DynamicResource ThemeSuccess}"/>
		<Setter Property="Foreground" Value="#18181b"/>
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeSuccess}"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
	</Style>

	<Style Selector="Button.options.mod-update:pointerover">
		<Setter Property="Background" Value="#16a34a"/>
		<Setter Property="BorderBrush" Value="#16a34a"/>
		<Setter Property="Foreground" Value="#18181b"/>
	</Style>

	<Style Selector="Button.options.mod-update:pressed">
		<Setter Property="Background" Value="#15803d"/>
		<Setter Property="BorderBrush" Value="#15803d"/>
		<Setter Property="Foreground" Value="#18181b"/>
	</Style>

	<!-- Library card update badge (corner overlay on app icons).
	     Solid dark green so it reads on charcoal cards; custom template so Fluent
	     pointerover chrome does not replace the fill with a grey wash. -->
	<Style Selector="Border.library-update-badge">
		<Setter Property="Background" Value="#166534"/>
		<Setter Property="BorderBrush" Value="#86EFAC"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="8"/>
		<Setter Property="Padding" Value="5,2"/>
		<Setter Property="MinWidth" Value="18"/>
		<Setter Property="MinHeight" Value="18"/>
	</Style>

	<Style Selector="Border.library-update-badge TextBlock">
		<Setter Property="Foreground" Value="#FFFFFF"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="FontSize" Value="10"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

	<Style Selector="Button.library-update-badge">
		<Setter Property="Background" Value="#166534"/>
		<Setter Property="BorderBrush" Value="#86EFAC"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="8"/>
		<Setter Property="Padding" Value="5,2"/>
		<Setter Property="MinWidth" Value="18"/>
		<Setter Property="MinHeight" Value="18"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Foreground" Value="#FFFFFF"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="Template">
			<ControlTemplate TargetType="Button">
				<Border Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="{TemplateBinding CornerRadius}"
						Padding="{TemplateBinding Padding}">
					<ContentPresenter
						Name="PART_ContentPresenter"
						Content="{TemplateBinding Content}"
						ContentTemplate="{TemplateBinding ContentTemplate}"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Foreground="{TemplateBinding Foreground}"
						FontSize="{TemplateBinding FontSize}"
						FontWeight="{TemplateBinding FontWeight}"/>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<Style Selector="Button.library-update-badge TextBlock">
		<Setter Property="Foreground" Value="#FFFFFF"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="FontSize" Value="10"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

	<Style Selector="Button.library-update-badge:pointerover">
		<Setter Property="Background" Value="#15803D"/>
		<Setter Property="BorderBrush" Value="#BBF7D0"/>
		<Setter Property="Foreground" Value="#FFFFFF"/>
	</Style>

	<Style Selector="Button.library-update-badge:pressed">
		<Setter Property="Background" Value="#14532D"/>
		<Setter Property="BorderBrush" Value="#86EFAC"/>
		<Setter Property="Foreground" Value="#FFFFFF"/>
	</Style>

	<Style Selector="Button.library-update-badge /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="Transparent"/>
	</Style>

	<Style Selector="Button.library-update-badge:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="#FFFFFF"/>
	</Style>

	<Style Selector="Button.library-update-badge:pressed /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="#FFFFFF"/>
	</Style>

	<!-- Orange gamepad rings require Window.gamepad-chrome (controller connected). -->
	<Style Selector="Window.gamepad-chrome Border.gamecard.gamepad-focused,
	                 Window.gamepad-chrome Border.gamecardgrid.gamepad-focused,
	                 Window.gamepad-chrome Border.gamecardcompact.gamepad-focused,
	                 Window.gamepad-chrome Border.catalog-focus-card.gamepad-focused,
	                 Window.gamepad-chrome Border.gamepad-focused">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="3"/>
		<Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
	</Style>

	<!-- Focus Visual Styles: orange :focus only under nav chrome; :focus-visible for Tab. -->
	<Style Selector="Window.gamepad-chrome Button:focus">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="2"/>
	</Style>

	<Style Selector="Window.gamepad-chrome ListBox.gamepad-focused">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="2"/>
	</Style>

	<Style Selector="Window.gamepad-chrome ListBox:focus">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="2"/>
	</Style>

	<Style Selector="Window.gamepad-chrome Button:focus /template/ Border">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="2"/>
	</Style>

	<Style Selector="Window.gamepad-chrome Button.modern:focus /template/ Border">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="3"/>
		<Setter Property="Margin" Value="-1"/>
	</Style>

	<Style Selector="Window.gamepad-chrome Button.modern-icon:focus /template/ Border">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="3"/>
		<Setter Property="Margin" Value="-1"/>
	</Style>

	<Style Selector="Button.modern-icon:focus-visible /template/ Border">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="3"/>
		<Setter Property="Margin" Value="-1"/>
	</Style>

	<Style Selector="Window.gamepad-chrome Button.modern-icon.gamepad-focused /template/ Border">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="3"/>
		<Setter Property="Margin" Value="-1"/>
	</Style>

	<Style Selector="Window.gamepad-chrome Button.options:focus /template/ Border">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="2"/>
	</Style>

	<Style Selector="Window.gamepad-chrome Button.options.gamepad-focused /template/ Border">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="2"/>
	</Style>

	<Style Selector="Button.options-grid:focus-visible /template/ Border">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="3"/>
	</Style>

	<Style Selector="Button.options-grid:focus-visible">
		<Setter Property="Opacity" Value="1"/>
		<Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
	</Style>

	<Style Selector="Button.settings:focus">
		<!-- Selected/current page uses background only; orange ring is gamepad-focused. -->
		<Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
	</Style>

	<Style Selector="Button.settings:focus /template/ Border">
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
	</Style>

	<Style Selector="Window.gamepad-chrome Button.settings.gamepad-focused">
		<Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="2"/>
		<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
	</Style>

	<Style Selector="Window.gamepad-chrome Button.settings.gamepad-focused /template/ Border">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="2"/>
	</Style>

	<Style Selector="Window.gamepad-chrome Button.iconbutton:focus">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="2"/>
	</Style>

	<Style Selector="CheckBox:focus /template/ Border#NormalRectangle">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="2"/>
	</Style>

	<Style Selector="Window.gamepad-chrome CheckBox.gamepad-focused">
		<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
	</Style>

	<Style Selector="Window.gamepad-chrome Slider.gamepad-focused /template/ Thumb">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="3"/>
	</Style>

	<Style Selector="Window.gamepad-chrome ComboBox.gamepad-focused">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="2"/>
	</Style>

	<Style Selector="Slider:focus /template/ Thumb">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="3"/>
	</Style>

	<Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="2"/>
	</Style>

	<Style Selector="TextBox#LibrarySearchTextBox /template/ TextBlock#PART_Watermark">
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

	<!-- Theme-aware text styles -->
	<Style Selector="TextBlock.theme-text">
		<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
	</Style>

	<Style Selector="TextBlock.theme-text-secondary">
		<Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
	</Style>

	<Style Selector="TextBlock.theme-text-muted">
		<Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
		<Setter Property="Opacity" Value="0.7"/>
	</Style>

	<Style Selector="TabItem">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
		<Setter Property="Padding" Value="14,4"/>
		<Setter Property="Margin" Value="4,8,4,0"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="CornerRadius" Value="6"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="MinHeight" Value="42"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>

	<!-- Keep all five settings tabs on one row -->
	<Style Selector="TabControl#SettingsTabControl">
		<Setter Property="Padding" Value="4,4,4,0"/>
	</Style>
	<Style Selector="TabControl#SettingsTabControl TabItem">
		<Setter Property="Padding" Value="8,4"/>
		<Setter Property="Margin" Value="1,8,1,0"/>
		<Setter Property="FontSize" Value="11"/>
		<Setter Property="MinHeight" Value="36"/>
	</Style>

	<Style Selector="TabItem:selected">
		<Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
		<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
		<Setter Property="BorderThickness" Value="0"/>
	</Style>

	<Style Selector="Window.gamepad-chrome TabItem.gamepad-focused">
		<Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
		<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="2"/>
	</Style>

	<Style Selector="Window.gamepad-chrome TabItem:selected.gamepad-focused">
		<Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="2"/>
	</Style>

	<Style Selector="TabItem:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource ThemeBase}"/>
		<Setter Property="TextBlock.Foreground" Value="{DynamicResource ThemeText}"/>
	</Style>

	<Style Selector="TabItem:selected:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
		<Setter Property="TextBlock.Foreground" Value="{DynamicResource ThemeText}"/>
	</Style>

</Window.Styles>

<Border CornerRadius="0" ClipToBounds="True" Background="Transparent">
	<Grid x:Name="MainGrid">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="240"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- Left Sidebar Navigation -->
		<Border Grid.Column="0" Background="{DynamicResource ThemeDarker}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0">
			<Grid Margin="0">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>	
				</Grid.RowDefinitions>

				<!-- Logo/Header -->
				<StackPanel Grid.Row="0"
							Margin="20"
							Orientation="Horizontal"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Spacing="6">
					<Image Source="avares://QuiverLauncher/Assets/app.png"
						   Width="45.75"
						   Height="95.25"
						   VerticalAlignment="Center"/>
					<StackPanel Orientation="Vertical"
								VerticalAlignment="Center"
								Margin="20,0,0,0"
								Spacing="2">
						<TextBlock Text="QUIVER"
								   FontSize="18"
								   FontWeight="Bold"
								   Foreground="{DynamicResource ThemeText}"
								   LetterSpacing="2"/>
						<TextBlock Text="LAUNCHER"
								   FontSize="11"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource ThemeTextSecondary}"
								   LetterSpacing="2.5"/>
					</StackPanel>
				</StackPanel>

				<!-- Navigation Buttons -->
				<StackPanel Grid.Row="1" Margin="12,0" VerticalAlignment="Top">

						<!-- Continue Button -->
						<Button x:Name="ContinueButton"
								Classes="settings"
								Margin="0,0,0,4"
								CornerRadius="8"
								Width="216"
								Height="64"
								HorizontalAlignment="Left"
								Click="ContinueButton_Click"
								IsVisible="{Binding IsContinueVisible}">
							<Grid ColumnDefinitions="*,Auto">
								<StackPanel Grid.Column="0"
											Orientation="Horizontal"
											VerticalAlignment="Center">
									<Image Width="32" Height="32" 
										   Source="avares://QuiverLauncher/Assets/Continue.png"
										   Margin="0,0,12,0"/>
									<TextBlock Text="Continue" 
											  VerticalAlignment="Center"/>
								</StackPanel>
								<Border Grid.Column="1"
										ClipToBounds="True"
										MaxWidth="48"
										MaxHeight="44"
										Margin="8,0,0,0"
										VerticalAlignment="Center"
										HorizontalAlignment="Right">
									<asyncImageLoader:AdvancedImage Source="{Binding ContinueGameInfo.DefaultIconUrl}"
																	Stretch="Uniform"
																	MaxWidth="48"
																	MaxHeight="44"/>
								</Border>
							</Grid>
						</Button>

						<!-- Library Button -->
						<Button x:Name="LibraryNavButton"
								Classes="settings selected"
								Margin="0,0,0,4"
								CornerRadius="8"
								Width="216"
								HorizontalAlignment="Left"
								Click="LibraryNavButton_Click">
							<StackPanel Orientation="Horizontal">
								<Image Width="32" Height="32"
									   Source="avares://QuiverLauncher/Assets/DefaultGame.png"
									   Margin="0,0,12,0"/>
								<TextBlock Text="Library" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>

						<!-- App Catalog Button -->
						<Button x:Name="AppCatalogNavButton"
								Classes="settings"
								Margin="0,0,0,4"
								CornerRadius="8"
								Width="216"
								HorizontalAlignment="Left"
								Click="AppCatalogNavButton_Click">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
								<Image Width="32" Height="32"
									   Source="avares://QuiverLauncher/Assets/AppCatalog.png"
									   Margin="0,0,2,0"/>
								<TextBlock Text="App Catalog" VerticalAlignment="Center"/>
								<Border Background="{DynamicResource ThemeLighter}"
										CornerRadius="10"
										MinWidth="20"
										Height="20"
										Padding="6,0"
										VerticalAlignment="Center"
										IsVisible="{Binding CatalogReviewBadgeVisible}">
									<TextBlock Text="{Binding CatalogReviewBadgeCount}"
											   FontSize="11"
											   FontWeight="Bold"
											   HorizontalAlignment="Center"
											   VerticalAlignment="Center"/>
								</Border>
							</StackPanel>
						</Button>
					</StackPanel>

				<!-- Library-only filters -->
				<Grid x:Name="LibraryFiltersPanel" Grid.Row="2" Grid.RowSpan="2" RowDefinitions="Auto,*">
				<StackPanel Grid.Row="0" Margin="0,4,0,8">
					<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,0,0,8"/>
					<TextBlock Text="SHOW"
							   FontSize="10"
							   FontWeight="Bold"
							   Foreground="{DynamicResource ThemeTextSecondary}"
							   LetterSpacing="1"
							   Margin="24,0,0,4"/>
				</StackPanel>

				<!-- Filter Buttons ScrollViewer -->
				<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="12,0,12,0">

							<Button x:Name="UnhideAllGamesButton"
									Classes="settings scope-filter"
									Width="216"
									HorizontalAlignment="Left"
									Click="UnhideAllGamesButton_Click">
								<TextBlock Text="All Apps"/>
							</Button>

							<Button x:Name="HideNonInstalledButton"
									Classes="settings scope-filter"
									Width="216"
									HorizontalAlignment="Left"
									Click="HideNonInstalledButton_Click">
								<TextBlock Text="Installed Only"/>
							</Button>

							<Button x:Name="ShowHiddenGamesButton"
									Classes="settings scope-filter"
									Width="216"
									HorizontalAlignment="Left"
									Click="ShowHiddenGamesButton_Click">
								<TextBlock Text="Hidden"/>
							</Button>

							<Border Height="1"
									Background="{DynamicResource ThemeBorder}"
									Margin="0,8,0,8"/>

							<Grid ColumnDefinitions="*,Auto" Margin="12,0,8,8">
								<TextBlock Grid.Column="0"
										   Text="TAG FILTERS"
										   FontSize="10"
										   FontWeight="Bold"
										   Foreground="{DynamicResource ThemeTextSecondary}"
										   LetterSpacing="1"
										   VerticalAlignment="Center"/>
								<Button Grid.Column="1"
										Classes="iconbutton tag-filter-add"
										Width="24"
										Height="24"
										ToolTip.Tip="Add tag filter"
										Click="AddDisplayFilter_Click">
									<TextBlock Text="+"
											   FontSize="16"
											   FontWeight="Bold"
											   HorizontalAlignment="Center"
											   VerticalAlignment="Center"
											   TextAlignment="Center"/>
								</Button>
							</Grid>

							<ItemsControl x:Name="TagDisplayFiltersItemsControl"
										  ItemsSource="{Binding TagDisplayFilters}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Button Classes="settings display-filter-row"
												Classes.selected="{Binding IsSelected}"
												Margin="0,0,0,4"
												HorizontalAlignment="Stretch"
												HorizontalContentAlignment="Stretch"
												Click="TagDisplayFilterButton_Click"
												Tag="{Binding Id}">
											<Grid ColumnDefinitions="*,Auto,Auto">
													<TextBlock Grid.Column="0"
															   Text="{Binding Name}"
															   TextTrimming="CharacterEllipsis"
															   VerticalAlignment="Center"/>
													<Border Grid.Column="1"
															Classes="display-filter-reorder"
															Width="28"
															Height="28"
															Margin="4,0,0,0"
															VerticalAlignment="Center"
															Tag="{Binding Id}"
															PointerPressed="TagDisplayFilterReorder_PointerPressed">
														<TextBlock Text="↕"
																   FontSize="14"
																   IsHitTestVisible="False"
																   HorizontalAlignment="Center"
																   VerticalAlignment="Center"/>
													</Border>
													<Button Grid.Column="2"
															Classes="options options-listview display-filter-overflow"
															Content="⋯"
															FontSize="18"
															Width="28"
															Height="28"
															Padding="0"
															Margin="2,0,0,0"
															VerticalAlignment="Center"
															Click="DisplayFilterOverflow_Click"
															Tag="{Binding Id}">
														<Button.ContextMenu>
															<ContextMenu>
																<MenuItem Header="Edit"
																		  Tag="{Binding Id}"
																		  Click="EditTagDisplayFilter_Click"/>
																<MenuItem Header="Move Up"
																		  Tag="{Binding Id}"
																		  Click="MoveTagDisplayFilterUp_Click"/>
																<MenuItem Header="Move Down"
																		  Tag="{Binding Id}"
																		  Click="MoveTagDisplayFilterDown_Click"/>
																<MenuItem Header="Delete"
																		  Tag="{Binding Id}"
																		  Click="DeleteTagDisplayFilter_Click"/>
															</ContextMenu>
														</Button.ContextMenu>
													</Button>
												</Grid>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<Button Classes="options"
									Content="Add Display Filter"
									HorizontalAlignment="Stretch"
									Margin="0,8,0,0"
									Click="AddDisplayFilter_Click"/>
						</StackPanel>
				</ScrollViewer>
				</Grid>

				<!-- Footer Links -->
				<StackPanel Grid.Row="4" Margin="12,0,12,8">
						<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="-12,0,-12,8"/>
					<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
						<Button x:Name="GitHubFooterButton"
								Classes="iconbutton"
								Width="44"
								Height="44"
								ToolTip.Tip="GitHub"
								Click="GithubButton_Click">
							<Image Width="32" Height="32"
								   Source="avares://QuiverLauncher/Assets/Github.png"/>
						</Button>
						<Button x:Name="DiscordFooterButton"
								Classes="iconbutton"
								Width="44"
								Height="44"
								ToolTip.Tip="Discord"
								Click="DiscordButton_Click">
							<Image Width="32" Height="32"
								   Source="avares://QuiverLauncher/Assets/Discord.png"/>
						</Button>
					</StackPanel>
				</StackPanel>
			</Grid>
		</Border>

		<!-- Main Content Area -->
		<Grid Grid.Column="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- Top Bar: drag layer is a sibling behind controls so BeginMoveDrag never captures chrome clicks -->
			<Grid Grid.Row="0" ZIndex="1">
				<Border Background="{DynamicResource ThemeDarker}"
						BorderBrush="{DynamicResource ThemeBorder}"
						BorderThickness="0,0,0,1"
						PointerPressed="TopBar_PointerPressed"/>
				<Border Padding="0,8,0,8">
					<Grid VerticalAlignment="Top">
						<TextBlock x:Name="HeaderTitleText"
								   Text="Library"
								   FontSize="24"
								   Margin="15,0,0,0"
								   FontWeight="Bold"
								   Foreground="{DynamicResource ThemeText}"
								   VerticalAlignment="Center"
								   IsHitTestVisible="False"/>
						<StackPanel Orientation="Horizontal"
									HorizontalAlignment="Right"
									VerticalAlignment="Center">

							<StackPanel x:Name="LibraryTopBarPanel" Orientation="Horizontal">
							<Grid Width="220" Margin="0,0,16,0" VerticalAlignment="Center">
							<TextBox x:Name="LibrarySearchTextBox"
									 Watermark="Search this list"
									 MinHeight="32"
									 FontSize="12"
									 Padding="8,0,28,0"
									 VerticalAlignment="Center"
									 VerticalContentAlignment="Center"
									 TextChanged="LibrarySearch_TextChanged"/>
							<Button x:Name="LibrarySearchClearButton"
									Classes="options"
									Content="×"
									FontSize="14"
									Padding="6,0"
									MinHeight="24"
									MinWidth="24"
									HorizontalAlignment="Right"
									VerticalAlignment="Center"
									Margin="0,0,4,0"
									IsVisible="False"
									ToolTip.Tip="Clear search"
									Click="LibrarySearchClear_Click"/>
							</Grid>
							<Button x:Name="AddNewEntryButton"
									Classes="options"
									Content="+ Add New Entry"
									FontSize="13"
									Margin="0,0,16,0"
									Click="AddNewEntryButton_Click"/>

							<!-- Sorting ComboBox -->
							<TextBlock Text="Sort by:"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   FontSize="14"
									   FontWeight="Medium"
									   VerticalAlignment="Center"
									   IsHitTestVisible="False"/>
							<ComboBox x:Name="SortByComboBox"
									  Foreground="{DynamicResource ThemeTextSecondary}"
									  Background="{DynamicResource ThemeDarker}"
									  BorderBrush="{DynamicResource ThemeBorder}"
									  Margin="4,1,64,0"
									  SelectionChanged="SortByComboBox_SelectionChanged">
								<ComboBoxItem Content="Name (A-Z)" Tag="Name"/>
								<ComboBoxItem Content="Name (Z-A)" Tag="NameDesc"/>
								<ComboBoxItem Content="Installed First" Tag="Installed"/>
								<ComboBoxItem Content="Not Installed First" Tag="NotInstalled"/>
								<ComboBoxItem Content="Last Played" Tag="LastPlayed"/>
							</ComboBox>
							</StackPanel>

							<StackPanel x:Name="CatalogReviewTopBarPanel"
										Orientation="Horizontal"
										IsVisible="False">
								<TextBlock Text="Sort by:"
										   Foreground="{DynamicResource ThemeTextSecondary}"
										   FontSize="14"
										   FontWeight="Medium"
										   VerticalAlignment="Center"
										   IsHitTestVisible="False"/>
								<ComboBox x:Name="CatalogReviewSortByComboBox"
										  Foreground="{DynamicResource ThemeTextSecondary}"
										  Background="{DynamicResource ThemeDarker}"
										  BorderBrush="{DynamicResource ThemeBorder}"
										  Margin="4,1,16,0"
										  SelectionChanged="CatalogReviewSortByComboBox_SelectionChanged">
									<ComboBoxItem Content="Name (A-Z)" Tag="Name"/>
									<ComboBoxItem Content="Name (Z-A)" Tag="NameDesc"/>
									<ComboBoxItem Content="Repository (A-Z)" Tag="Repository"/>
									<ComboBoxItem Content="Status" Tag="Status"/>
								</ComboBox>
							</StackPanel>

							<Button x:Name="CatalogReviewBackButton"
									Classes="options"
									Content="← Back to sources"
									FontSize="13"
									Margin="0,0,16,0"
									IsVisible="False"
									Click="CatalogReviewBack_Click"/>

							<!-- Version text -->
							<TextBlock Text="{Binding currentVersionString}"
								   VerticalAlignment="Center"
								   HorizontalAlignment="Right"
								   Foreground="{DynamicResource ThemeText}"
								   FontSize="14"
								   IsHitTestVisible="False"/>

							<Button x:Name="CheckForUpdatesButton"
									Classes="modern-icon"
									Width="32"
									Height="32"
									ClipToBounds="False"
									Margin="12,0,0,0"
									ToolTip.Tip="{Binding CheckForUpdatesToolTip}"
									IsEnabled="{Binding !IsCheckingUpdates}"
									Click="CheckforUpdates_Click">
								<Grid Width="32" Height="32" ClipToBounds="False">
									<Image Width="28"
										   Height="28"
										   HorizontalAlignment="Center"
										   VerticalAlignment="Center"
										   Source="avares://QuiverLauncher/Assets/CheckForUpdates.png"
										   Opacity="{Binding CheckForUpdatesIconOpacity}"/>
									<Border Width="28"
											Height="2"
											HorizontalAlignment="Center"
											VerticalAlignment="Bottom"
											ClipToBounds="True"
											CornerRadius="1"
											IsVisible="{Binding IsCheckingUpdates}">
										<ProgressBar Height="2"
													 HorizontalAlignment="Stretch"
													 VerticalAlignment="Stretch"
													 BorderThickness="0"
													 Background="Transparent"
													 IsIndeterminate="True"/>
									</Border>
									<Border Background="#FF9500"
											CornerRadius="8"
											MinWidth="16"
											MinHeight="18"
											Padding="5,2"
											HorizontalAlignment="Right"
											VerticalAlignment="Top"
											Margin="0,-2,-2,0"
											IsVisible="{Binding UpdatesBadgeVisible}">
										<TextBlock Text="{Binding UpdatesBadgeText}"
												   FontSize="9"
												   FontWeight="Bold"
												   Foreground="White"
												   HorizontalAlignment="Center"
												   VerticalAlignment="Center"/>
									</Border>
									<Border Background="{DynamicResource ThemeSuccess}"
											CornerRadius="8"
											Width="16"
											Height="16"
											HorizontalAlignment="Right"
											VerticalAlignment="Top"
											Margin="0,-2,-2,0"
											IsVisible="{Binding UpdatesUpToDateBadgeVisible}">
										<TextBlock Text="✓"
												   FontSize="10"
												   FontWeight="Bold"
												   Foreground="White"
												   HorizontalAlignment="Center"
												   VerticalAlignment="Center"/>
									</Border>
								</Grid>
							</Button>

							<Button x:Name="SettingsButton"
									Classes="modern-icon"
									Width="28"
									Height="28"
									Margin="8,0,0,0"
									ToolTip.Tip="Settings"
									Click="SettingsButton_Click">
								<Image Width="28" Height="28"
									   Source="avares://QuiverLauncher/Assets/Settings.png"/>
							</Button>

							<!-- Minimize Button -->
							<Button x:Name="MinimizeButton"
									Classes="modern-icon"
									Width="28"
									Margin="12,0,0,0"
									ClickMode="Press"
									Click="MinimizeButton_Click">
								<Image Width="28"
									   Height="28"
									   Source="avares://QuiverLauncher/Assets/Icons/button_minimize.png"/>
							</Button>

							<!-- Fullscreen Button -->
							<Button x:Name="ToggleFullscreenButton"
									Classes="modern-icon"
									Width="28"
									Margin="8,0,0,0"
									ClickMode="Press"
									Click="ToggleFullscreen_Click">
								<Image Width="28"
									   Height="28"
									   Source="avares://QuiverLauncher/Assets/Icons/button_fullscreen.png"/>
							</Button>

							<!-- Close Button -->
							<Button x:Name="CloseLauncherButton"
									Classes="modern-icon"
									Width="28"
									Margin="8,0,10,0"
									ClickMode="Press"
									Click="CloseLauncher_Click">
								<Image Width="28"
									   Height="28"
									   Source="avares://QuiverLauncher/Assets/Icons/button_close.png"/>
							</Button>
						</StackPanel>
					</Grid>
				</Border>
			</Grid>
			<!-- Remote announcement banner (sky blue — not focus orange / success green) -->
			<Border x:Name="AnnouncementBanner"
					Grid.Row="1"
					Classes="announcement-banner"
					IsVisible="False"
					ZIndex="1">
				<Grid ColumnDefinitions="*,Auto" Margin="12,8">
					<TextBlock x:Name="AnnouncementBannerText"
							   Grid.Column="0"
							   TextWrapping="Wrap"
							   VerticalAlignment="Center"
							   FontSize="13"
							   FontWeight="SemiBold"
							   Margin="0,0,12,0"/>
					<Button x:Name="AnnouncementBannerCloseButton"
							Grid.Column="1"
							Classes="announcement-banner-close"
							Content="✕"
							Width="32"
							Height="28"
							FontSize="14"
							FontWeight="Bold"
							VerticalAlignment="Center"
							ToolTip.Tip="Dismiss"
							Click="AnnouncementBannerClose_Click"/>
				</Grid>
			</Border>

			<!-- Apps Content with Settings Panel Overlay -->
			<Grid Grid.Row="2">

				<!-- Background Image -->
				<Border Background="{DynamicResource ThemeDarker}"/>
				<Image x:Name="StaticBackgroundImage"
					Source="{Binding BackgroundImageUri}"
					Stretch="Fill"
					Opacity="{Binding BackgroundOpacity}"/>

				<!-- Main App List -->
				<Grid x:Name="LibraryViewContainer">
					<ScrollViewer x:Name="LibraryContentPanel" VerticalScrollBarVisibility="Auto" Margin="30,20,6,30">
						<Grid Margin="0,0,30,0">
							<ItemsControl ItemsSource="{Binding Games}" x:Name="ListViewControl"
										  IsVisible="{Binding ElementName=UseGridViewCheckBox, Path=!IsChecked}">
								<ItemsControl.ItemTemplate>
									<StaticResource ResourceKey="ListViewTemplate"/>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<ItemsControl ItemsSource="{Binding Games}" x:Name="ClassicGridViewControl"
										  IsVisible="False">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal" />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<StaticResource ResourceKey="GridViewTemplate"/>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<ItemsControl ItemsSource="{Binding Games}" x:Name="CompactGridViewControl"
										  IsVisible="False">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal" />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<StaticResource ResourceKey="CompactGridViewTemplate"/>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Grid>
					</ScrollViewer>

					<StackPanel x:Name="EmptyLibraryPanel"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Spacing="16"
								MaxWidth="520"
								Margin="30,20,30,30"
								IsVisible="False">
						<TextBlock Text="Your library is empty"
								   FontSize="24"
								   FontWeight="Bold"
								   Foreground="{DynamicResource ThemeText}"
								   HorizontalAlignment="Center"
								   TextAlignment="Center"/>
						<TextBlock Text="Get started by adding an app yourself, or browse the Quiver Community App Catalog to add apps from the community."
								   FontSize="14"
								   Foreground="{DynamicResource ThemeTextSecondary}"
								   TextWrapping="Wrap"
								   TextAlignment="Center"/>
						<StackPanel Orientation="Horizontal"
									Spacing="12"
									HorizontalAlignment="Center"
									Margin="0,8,0,0">
							<Button Classes="options"
									Content="Add App Manually"
									FontSize="13"
									Click="EmptyLibraryAddApp_Click"/>
							<Button Classes="options"
									Content="Browse Community Catalog"
									FontSize="13"
									Click="EmptyLibraryBrowseCatalog_Click"/>
						</StackPanel>
					</StackPanel>

					<StackPanel x:Name="LibrarySearchNoMatchesPanel"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Spacing="16"
								MaxWidth="520"
								Margin="30,20,30,30"
								IsVisible="False">
						<TextBlock Text="No apps match this search"
								   FontSize="24"
								   FontWeight="Bold"
								   Foreground="{DynamicResource ThemeText}"
								   HorizontalAlignment="Center"
								   TextAlignment="Center"/>
						<TextBlock Text="Try a different search, or clear it to show your library again."
								   FontSize="14"
								   Foreground="{DynamicResource ThemeTextSecondary}"
								   TextWrapping="Wrap"
								   TextAlignment="Center"/>
						<Button Classes="options"
								Content="Clear search"
								FontSize="13"
								HorizontalAlignment="Center"
								Click="LibrarySearchClear_Click"/>
					</StackPanel>

					<!-- App updates review (in-window, replaces modal) -->
					<Grid x:Name="AppUpdatesReviewPanel"
						  IsVisible="False"
						  Margin="30,20,6,30"
						  RowDefinitions="Auto,Auto,*">
						<TextBlock x:Name="AppUpdatesReviewHeaderText"
								   Grid.Row="0"
								   FontSize="15"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource ThemeText}"
								   TextWrapping="Wrap"
								   Margin="0,0,30,12"/>
						<StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,30,12">
							<Button x:Name="AppUpdatesUpdateAllButton"
									Classes="options"
									Content="Update All"
									FontSize="11"
									Click="AppUpdatesUpdateAll_Click"/>
							<Button x:Name="AppUpdatesSkipAllButton"
									Classes="options"
									Content="Skip all"
									FontSize="11"
									Click="AppUpdatesSkipAll_Click"/>
							<Button x:Name="AppUpdatesBackToLibraryButton"
									Classes="options"
									Content="Back to Library"
									FontSize="11"
									Click="AppUpdatesBackToLibrary_Click"/>
						</StackPanel>
						<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
							<StackPanel Margin="0,0,30,0">
								<TextBlock x:Name="AppUpdatesReviewEmptyText"
										   Text="No app updates pending."
										   FontSize="12"
										   Foreground="{DynamicResource ThemeTextSecondary}"
										   IsVisible="False"
										   Margin="0,8,0,0"/>
								<ItemsControl x:Name="AppUpdatesReviewItemsControl"
											  ItemsSource="{Binding AppUpdateReviewRows}">
									<ItemsControl.ItemTemplate>
										<StaticResource ResourceKey="AppUpdateReviewCardTemplate"/>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</ScrollViewer>
					</Grid>

					<!-- Mods browser (in-window overlay on Library) -->
					<Grid x:Name="ModsPanel"
						  IsVisible="False"
						  Margin="30,20,6,30"
						  RowDefinitions="Auto,Auto,Auto,Auto,*">
						<TextBlock x:Name="ModsHeaderText"
								   Grid.Row="0"
								   FontSize="15"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource ThemeText}"
								   TextWrapping="Wrap"
								   Margin="0,0,30,8"/>
						<StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,30,8">
							<Button x:Name="ModsRefreshButton"
									Classes="options"
									Content="Refresh"
									FontSize="11"
									Click="ModsRefresh_Click"/>
							<Button x:Name="ModsUpdateAllButton"
									Classes="options"
									Content="Update All"
									FontSize="11"
									Click="ModsUpdateAll_Click"/>
							<Button x:Name="ModsOpenFolderButton"
									Classes="options"
									Content="Open Mod Folder"
									FontSize="11"
									Click="ModsOpenFolder_Click"/>
							<Button x:Name="ModsCloseButton"
									Classes="options"
									Content="Back to Library"
									FontSize="11"
									Click="ModsClose_Click"/>
							<TextBlock x:Name="ModsStatusText"
									   VerticalAlignment="Center"
									   FontSize="11"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   Margin="8,0,0,0"/>
						</StackPanel>
						<StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,30,8">
							<Button x:Name="ModsTabBrowseButton"
									Classes="catalog-filter selected"
									Content="Browse"
									Tag="Browse"
									FontSize="11"
									Click="ModsTabFilter_Click"/>
							<Button x:Name="ModsTabInstalledButton"
									Classes="catalog-filter"
									Content="Installed"
									Tag="Installed"
									FontSize="11"
									Click="ModsTabFilter_Click"/>
							<TextBox x:Name="ModsSearchTextBox"
									 Watermark="Search mods"
									 Width="220"
									 FontSize="12"
									 Margin="12,0,0,0"
									 TextChanged="ModsSearch_TextChanged"/>
							<TextBlock Text="Sort:"
									   FontSize="11"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   VerticalAlignment="Center"
									   Margin="12,0,0,0"/>
							<ComboBox x:Name="ModsSortByComboBox"
									  FontSize="12"
									  MinWidth="150"
									  Foreground="{DynamicResource ThemeTextSecondary}"
									  Background="{DynamicResource ThemeDarker}"
									  BorderBrush="{DynamicResource ThemeBorder}"
									  SelectionChanged="ModsSortByComboBox_SelectionChanged">
								<ComboBoxItem Content="Installed first" Tag="InstalledFirst"/>
								<ComboBoxItem Content="Name (A-Z)" Tag="Name"/>
								<ComboBoxItem Content="Name (Z-A)" Tag="NameDesc"/>
								<ComboBoxItem Content="Updates first" Tag="UpdatesFirst"/>
								<ComboBoxItem Content="Top rated" Tag="TopRated"/>
								<ComboBoxItem Content="Newest" Tag="Newest"/>
								<ComboBoxItem Content="Last updated" Tag="LastUpdated"/>
								<ComboBoxItem Content="Most downloaded" Tag="MostDownloaded"/>
							</ComboBox>
						</StackPanel>
						<WrapPanel x:Name="ModsSourceFilterPanel"
								   Grid.Row="3"
								   Orientation="Horizontal"
								   Margin="0,0,30,8"/>
						<ScrollViewer x:Name="ModsListScrollViewer"
									  Grid.Row="4"
									  VerticalScrollBarVisibility="Auto"
									  ScrollChanged="ModsListScrollViewer_ScrollChanged">
							<StackPanel Margin="0,0,30,0">
								<TextBlock x:Name="ModsEmptyText"
										   Text="No mods found."
										   FontSize="12"
										   Foreground="{DynamicResource ThemeTextSecondary}"
										   IsVisible="False"
										   Margin="0,8,0,0"/>
								<ItemsControl x:Name="ModsItemsControl"
											  ItemsSource="{Binding ModListRows}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel Orientation="Horizontal"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<StaticResource ResourceKey="ModListCardTemplate"/>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</ScrollViewer>
					</Grid>
				</Grid>

				<!-- App Catalog Content -->
				<Grid x:Name="CatalogContentPanel" IsVisible="False" Margin="30,20,6,30">
					<!-- Sources list -->
					<ScrollViewer x:Name="CatalogSourcesPanel" VerticalScrollBarVisibility="Auto">
						<StackPanel Spacing="12" Margin="0,0,30,0">
							<TextBlock Text="External catalog sources reference remote app lists. Your local apps.json is your library."
									   FontSize="12"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   TextWrapping="Wrap"/>
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Button x:Name="AddCatalogSourceButton" Classes="options" Content="Add Source" Click="AddCatalogSource_Click" FontSize="12"/>
								<Button x:Name="RefreshCatalogSourcesButton" Classes="options" Content="Refresh All Sources" Click="RefreshCatalogSources_Click" FontSize="12"/>
							</StackPanel>
							<WrapPanel Orientation="Horizontal">
								<Button x:Name="CatalogSourceFilterAllButton" Classes="catalog-filter" Content="All"
										Tag="All" Click="CatalogSourceListFilter_Click" Margin="0,0,6,6"/>
								<Button x:Name="CatalogSourceFilterEnabledButton" Classes="catalog-filter selected" Content="Enabled"
										Tag="Enabled" Click="CatalogSourceListFilter_Click" Margin="0,0,6,6"/>
								<Button x:Name="CatalogSourceFilterDisabledButton" Classes="catalog-filter" Content="Disabled"
										Tag="Disabled" Click="CatalogSourceListFilter_Click" Margin="0,0,6,6"/>
							</WrapPanel>
							<ItemsControl ItemsSource="{Binding CatalogSources}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<StaticResource ResourceKey="CatalogSourceCardTemplate"/>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<TextBlock x:Name="CatalogSourcesEmptyText"
									   Text="No catalog sources yet. Add a source to subscribe to an external app list."
									   FontSize="12"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   TextWrapping="Wrap"
									   IsVisible="False"/>
						</StackPanel>
					</ScrollViewer>

					<!-- Source review -->
					<Grid x:Name="CatalogReviewPanel" IsVisible="False" RowDefinitions="Auto,Auto,Auto,*">
						<Border x:Name="CatalogReviewVersionBanner"
								Grid.Row="0"
								Classes="catalog-review-version-banner"
								IsVisible="False"
								Margin="0,0,30,8">
							<TextBlock x:Name="CatalogReviewVersionText"
									   FontSize="15"
									   Foreground="{DynamicResource ThemeText}"
									   TextWrapping="Wrap"/>
						</Border>
						<StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,30,8">
							<Button x:Name="CatalogSyncAddAllButton" Classes="options" Content="Add all new"
									Click="CatalogSyncAddAll_Click" FontSize="11"/>
							<Button x:Name="CatalogSyncReplaceAllButton" Classes="options" Content="Replace all changed"
									Click="CatalogSyncReplaceAll_Click" FontSize="11"/>
							<Button x:Name="CatalogSyncAcknowledgeButton" Classes="options" Content="Skip &amp; mark reviewed"
									Click="CatalogSyncAcknowledge_Click" FontSize="11" IsVisible="False"/>
						</StackPanel>
						<StackPanel Grid.Row="2" Spacing="8" Margin="0,0,30,8">
							<WrapPanel Orientation="Horizontal">
								<Button x:Name="CatalogFilterAllButton" Classes="catalog-filter selected" Content="All"
										Tag="All" Click="CatalogReviewFilter_Click" Margin="0,0,6,6"/>
								<Button x:Name="CatalogFilterNeedsReviewButton" Classes="catalog-filter" Content="Needs review"
										Tag="NeedsReview" Click="CatalogReviewFilter_Click" Margin="0,0,6,6"/>
								<Button x:Name="CatalogFilterNewButton" Classes="catalog-filter" Content="New"
										Tag="New" Click="CatalogReviewFilter_Click" Margin="0,0,6,6"/>
								<Button x:Name="CatalogFilterNotInLibraryButton" Classes="catalog-filter" Content="Not in library"
										Tag="NotInLibrary" Click="CatalogReviewFilter_Click" Margin="0,0,6,6"/>
								<Button x:Name="CatalogFilterChangedButton" Classes="catalog-filter" Content="Changed"
										Tag="Changed" Click="CatalogReviewFilter_Click" Margin="0,0,6,6"/>
								<Button x:Name="CatalogFilterUpToDateButton" Classes="catalog-filter" Content="Up to date"
										Tag="UpToDate" Click="CatalogReviewFilter_Click" Margin="0,0,6,6"/>
								<Button x:Name="CatalogFilterHiddenButton" Classes="catalog-filter" Content="Hidden"
										Tag="Hidden" Click="CatalogReviewFilter_Click" Margin="0,0,6,6"/>
								<TextBox x:Name="CatalogSearchTextBox"
										 Watermark="Search this list"
										 Width="220"
										 FontSize="12"
										 VerticalAlignment="Center"
										 Margin="6,0,6,6"
										 TextChanged="CatalogSearch_TextChanged"/>
							</WrapPanel>
							<StackPanel Spacing="4"
										IsVisible="{Binding HasCatalogTagChips}">
								<TextBlock Text="Tags (click to cycle: off → include → exclude)"
										   FontSize="10"
										   Foreground="{DynamicResource ThemeTextSecondary}"
										   Opacity="0.85"/>
								<ItemsControl x:Name="CatalogTagChipsItemsControl"
											  ItemsSource="{Binding CatalogTagChips}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel Orientation="Horizontal"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Button Classes="catalog-filter"
													Content="{Binding StateLabel}"
													Tag="{Binding Tag}"
													Click="CatalogTagChip_Click"
													Margin="0,0,6,6"
													Classes.selected="{Binding IsInclude}"
													ToolTip.Tip="Neutral → include → exclude"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
							<TextBlock Text="New = not in library yet and still needs review. Not in library = all catalog entries you haven't added (including ignored). Ignore skips changes for this catalog version. Hide removes apps from review until unhidden in Hidden."
									   FontSize="10"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   Opacity="0.85"/>
							<TextBlock Text="Tag colors on changed apps: orange = library only (kept on Merge, removed on Replace) · green = catalog only · gray = both"
									   FontSize="10"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   Opacity="0.85"/>
						</StackPanel>
						<ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
							<StackPanel Margin="0,0,30,0">
								<StackPanel x:Name="CatalogSyncNeedsReviewEmptyPanel"
											Spacing="12"
											Margin="0,8,0,0"
											IsVisible="False">
									<TextBlock Text="You're all caught up — nothing needs review."
											   FontSize="12"
											   Foreground="{DynamicResource ThemeTextSecondary}"
											   TextWrapping="Wrap"/>
									<StackPanel Orientation="Horizontal" Spacing="8">
										<Button x:Name="CatalogSyncBackToLibraryButton"
												Classes="options"
												Content="Back to Library"
												FontSize="11"
												Click="CatalogSyncBackToLibrary_Click"/>
										<Button x:Name="CatalogSyncBackToSourcesButton"
												Classes="options"
												Content="Back to sources"
												FontSize="11"
												Click="CatalogSyncBackToSources_Click"/>
									</StackPanel>
								</StackPanel>
								<TextBlock x:Name="CatalogSyncEmptyText"
										   Text="No apps match this filter."
										   FontSize="12"
										   Foreground="{DynamicResource ThemeTextSecondary}"
										   TextWrapping="Wrap"
										   IsVisible="False"
										   Margin="0,8,0,0"/>
								<ItemsControl x:Name="CatalogSyncRowsItemsControl"
											  ItemsSource="{Binding CatalogSyncRows}">
									<ItemsControl.ItemTemplate>
										<StaticResource ResourceKey="CatalogReviewCardTemplate"/>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</ScrollViewer>
					</Grid>
				</Grid>

				<TextBlock x:Name="GamepadHintsBar"
						   FontSize="11"
						   Foreground="{DynamicResource ThemeTextSecondary}"
						   HorizontalAlignment="Center"
						   VerticalAlignment="Bottom"
						   Margin="0,0,0,8"
						   IsVisible="{Binding GamepadHintsVisible}"/>

				<!-- Settings Panel Overlay -->
				<Border x:Name="SettingsPanel"
						HorizontalAlignment="Right"
						VerticalAlignment="Stretch"
						Width="400"
						Background="{DynamicResource ThemeDarker}"
						BorderBrush="{DynamicResource ThemeBorder}"
						BorderThickness="1,0,0,0"
						IsVisible="False"
						Opacity="0.97"
						ZIndex="10">
					<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
						<StackPanel x:Name="SettingsContent">

							<!-- Settings Header -->
							<Border Background="{DynamicResource ThemeBase}"
									Padding="20,14,20,14"
									BorderThickness="0,0,0,1"
									BorderBrush="{DynamicResource ThemeBorder}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0"
											   Text="Settings"
											   FontSize="20"
											   FontWeight="Bold"
											   Foreground="{DynamicResource ThemeText}"
											   VerticalAlignment="Center"/>
									<Button x:Name="CloseSettingsButton"
											Grid.Column="1"
											Classes="modern-icon"
											Width="28"
											Height="28"
											ToolTip.Tip="Close settings"
											Click="CloseSettingsPanel_Click">
										<Image Width="28"
											   Height="28"
											   Source="avares://QuiverLauncher/Assets/Icons/button_close.png"/>
									</Button>
								</Grid>
							</Border>

							<!-- Tab Control -->
							<TabControl x:Name="SettingsTabControl"
										Background="Transparent"
										Foreground="{DynamicResource ThemeText}"
										Padding="4,4,4,0"
										Margin="0">
								<TabControl.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel Orientation="Horizontal"/>
									</ItemsPanelTemplate>
								</TabControl.ItemsPanel>

								<!-- General Tab -->
								<TabItem Header="General">
									<StackPanel Margin="16,12,16,16" Spacing="4">

										<!-- Behaviour -->
										<TextBlock Text="BEHAVIOUR"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="2">
											<CheckBox x:Name="CloseAfterLaunchCheckBox"
													  Content="Close After Launch"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  Checked="CloseAfterLaunchCheckBox_Checked"
													  Unchecked="CloseAfterLaunchCheckBox_Unchecked"/>
											<TextBlock Text="Close the launcher automatically after starting an app"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0">
											<CheckBox x:Name="CloseToTrayCheckBox"
													  Content="Close to system tray"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  Checked="CloseToTrayCheckBox_Checked"
													  Unchecked="CloseToTrayCheckBox_Unchecked"/>
											<TextBlock Text="Keep Quiver Launcher running in the notification area when the window is closed"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0">
											<CheckBox x:Name="IgnoreArticlesWhenSortingCheckBox"
													  Content="Ignore The/A/An when sorting by name"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  Checked="IgnoreArticlesWhenSortingCheckBox_Checked"
													  Unchecked="IgnoreArticlesWhenSortingCheckBox_Unchecked"/>
											<TextBlock Text="Alphabetical sorts skip leading The, A, and An (e.g. The Legend of Zelda under L)"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<StackPanel Spacing="2" Margin="0,0,0,0">
											<CheckBox x:Name="AutoUpdateNewlyAddedAppsCheckBox"
													  Content="Enable Auto Update for newly added apps"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  Checked="AutoUpdateNewlyAddedAppsCheckBox_Checked"
													  Unchecked="AutoUpdateNewlyAddedAppsCheckBox_Unchecked"/>
											<TextBlock Text="New apps from the catalog or Add Entry start with Auto Update enabled"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0">
											<CheckBox x:Name="BackgroundUpdateCheckCheckBox"
													  Content="Check for app updates in the background"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  Checked="BackgroundUpdateCheckCheckBox_Checked"
													  Unchecked="BackgroundUpdateCheckCheckBox_Unchecked"/>
											<TextBlock Text="Scan for updates on a schedule while Quiver Launcher is running (including in the tray)"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0">
											<TextBlock Text="Background check interval"
													   FontSize="13" FontWeight="SemiBold"
													   Foreground="{DynamicResource ThemeText}"/>
											<ComboBox x:Name="BackgroundUpdateIntervalComboBox"
													  HorizontalAlignment="Stretch"
													  Margin="0,4,0,0"
													  SelectionChanged="BackgroundUpdateIntervalComboBox_SelectionChanged">
												<ComboBoxItem Content="Every 15 minutes" Tag="15"/>
												<ComboBoxItem Content="Every 30 minutes" Tag="30"/>
												<ComboBoxItem Content="Every hour" Tag="60"/>
												<ComboBoxItem Content="Every 3 hours" Tag="180"/>
												<ComboBoxItem Content="Every 6 hours" Tag="360"/>
												<ComboBoxItem Content="Every 12 hours" Tag="720"/>
												<ComboBoxItem Content="Every day" Tag="1440"/>
											</ComboBox>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0">
											<CheckBox x:Name="PromptCatalogUpdatesCheckBox"
													  Content="Prompt when catalog updates are available"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  Checked="PromptCatalogUpdatesCheckBox_Checked"
													  Unchecked="PromptCatalogUpdatesCheckBox_Unchecked"/>
											<TextBlock Text="Show a popup when catalog sources have changes to review (off by default; open App Catalog anytime)"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0">
											<CheckBox x:Name="PromptAppUpdateReviewsCheckBox"
													  Content="Prompt when library apps have updates"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  Checked="PromptAppUpdateReviewsCheckBox_Checked"
													  Unchecked="PromptAppUpdateReviewsCheckBox_Unchecked"/>
											<TextBlock Text="Show a popup for pending app updates (Quiver Launcher self-update prompts still appear)"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<!-- Install Path -->
										<TextBlock Text="APP INSTALL PATH"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<TextBlock Text="Leave blank to use the default location"
												   FontSize="11"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   Margin="0,0,0,4"/>

										<Panel HorizontalAlignment="Stretch">
											<TextBox x:Name="GamePathTextBox"
													 Foreground="{DynamicResource ThemeText}"
													 Background="{DynamicResource ThemeBase}"
													 BorderBrush="{DynamicResource ThemeBorder}"
													 BorderThickness="1"
													 Padding="12,10"
													 CornerRadius="4"
													 Margin="0,0,44,0"
													 TextChanged="GamePathTextBox_TextChanged"
													 Text="{Binding Settings.GamesPath, Mode=TwoWay}"/>
											<Button Classes="options"
													HorizontalAlignment="Right"
													Width="40"
													Height="40"
													Content="📁"
													Click="BrowseGamePath_Click"/>
										</Panel>

										<Button Classes="options"
												Content="Reset to Default"
												HorizontalAlignment="Stretch"
												Click="ClearGamePath_Click"
												FontSize="12"/>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<!-- Platform & Cache -->
										<TextBlock Text="PLATFORM &amp; CACHE"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<TextBlock Text="{Binding PlatformString}"
												   FontSize="11"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   Margin="0,0,0,4"/>

										<Button Classes="options"
												Content="Change Platform"
												HorizontalAlignment="Stretch"
												Click="OptionsButton_Click"
												Tag="{Binding}"
												FontSize="12">
											<Button.ContextMenu>
												<ContextMenu>
													<MenuItem Header="Automatic"   Click="PlatformAuto_Click"/>
													<MenuItem Header="Windows"     Click="PlatformWindows_Click"/>
													<MenuItem Header="MacOS"       Click="PlatformMacOS_Click"/>
													<MenuItem Header="Linux X64"   Click="PlatformLinuxX64_Click"/>
													<MenuItem Header="Linux ARM64" Click="PlatformLinuxARM64_Click"/>
												</ContextMenu>
											</Button.ContextMenu>
										</Button>

										<Button Classes="options"
												Content="Clear Icon Cache"
												HorizontalAlignment="Stretch"
												Click="ClearIconCache_Click"
												FontSize="12"/>

										<StackPanel Spacing="2" IsVisible="{Binding IsLinuxPlatform}">
											<TextBlock Text="LINUX WINDOWS RUNNER"
													   FontSize="10" FontWeight="Bold"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   LetterSpacing="1"
													   Margin="0,8,0,4"/>
											<TextBox x:Name="LinuxWindowsLaunchCommandTextBox"
													 Foreground="{DynamicResource ThemeText}"
													 Background="{DynamicResource ThemeBase}"
													 BorderBrush="{DynamicResource ThemeBorder}"
													 BorderThickness="1"
													 Padding="12,10"
													 CornerRadius="4"
													 Watermark="Example: flatpak run com.usebottles.bottles -e {exe}"
													 Text="{Binding Settings.LinuxWindowsLaunchCommand, Mode=TwoWay}"
													 TextChanged="LinuxWindowsLaunchCommandTextBox_TextChanged"/>
											<TextBlock Text="Global override for Windows-only apps on Linux when an app uses Auto. Use {exe}, {gamePath}, or {exeDir}. Per-app runner/prefix is under Launch Options → Windows Runner. Leave blank to auto-detect Proton then Wine."
													   FontSize="11"
													   TextWrapping="Wrap"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="0,0,0,4"/>
										</StackPanel>

									</StackPanel>
								</TabItem>

								<!-- Controls Tab -->
								<TabItem Header="Controls">
									<StackPanel Margin="16,12,16,16" Spacing="4">

										<TextBlock Text="ENABLE"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="2">
											<CheckBox x:Name="EnableGamepadCheckBox"
													  Content="Enable Gamepad Input"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  Checked="EnableGamepadCheckBox_Checked"
													  Unchecked="EnableGamepadCheckBox_Unchecked"/>
											<TextBlock Text="Navigate with the bound controls. The selected app is highlighted."
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<TextBlock Text="CONNECTED CONTROLLERS"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<TextBlock x:Name="ConnectedGamepadsText"
												   Text="No controllers detected"
												   FontSize="12"
												   Foreground="{DynamicResource ThemeText}"
												   TextWrapping="Wrap"
												   Margin="0,0,0,4"/>

										<TextBlock Text="All connected controllers are used. No exclusive selection."
												   FontSize="11"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   TextWrapping="Wrap"
												   Margin="0,0,0,4"/>

										<Button Classes="options"
												Content="Refresh Controllers"
												HorizontalAlignment="Stretch"
												Click="RefreshConnectedGamepads_Click"
												FontSize="12"/>

										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<TextBlock Text="BINDINGS"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<TextBlock x:Name="GamepadRebindStatusText"
												   FontSize="11"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   TextWrapping="Wrap"
												   Margin="0,0,0,4"
												   IsVisible="False"/>

										<StackPanel x:Name="GamepadBindingsPanel" Spacing="6"/>

										<Button Classes="options"
												Content="Reset Bindings to Defaults"
												HorizontalAlignment="Stretch"
												Click="ResetGamepadBindings_Click"
												FontSize="12"
												Margin="0,8,0,0"/>

									</StackPanel>
								</TabItem>

								<!-- Appearance Tab -->
								<TabItem Header="Appearance">
									<StackPanel Margin="16,12,16,16" Spacing="4">

										<!-- Window -->
										<TextBlock Text="WINDOW"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="2">
											<CheckBox x:Name="StartFullscreenCheckBox"
													  Content="Start in Fullscreen"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  Checked="StartFullscreenCheckBox_Checked"
													  Unchecked="StartFullscreenCheckBox_Unchecked"/>
											<TextBlock Text="Launch the application in fullscreen mode"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"/>
										</StackPanel>

										<StackPanel Spacing="2">
											<CheckBox x:Name="ShowOSTopBarCheckBox"
													  Content="Show OS Top Bar"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  Checked="ShowOSTopBarCheckBox_Checked"
													  Unchecked="ShowOSTopBarCheckBox_Unchecked"/>
											<TextBlock Text="Display your operating system's title bar"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"/>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<!-- Theme Colors -->
										<TextBlock Text="THEME COLORS"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<Button Classes="options"
												Content="Primary Color"
												HorizontalAlignment="Stretch"
												Click="ThemeColorPicker_Click"
												FontSize="12"/>
										<Button Classes="options"
												Content="Secondary Color"
												HorizontalAlignment="Stretch"
												Click="SecondaryColorPicker_Click"
												FontSize="12"/>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<!-- Background Image -->
										<TextBlock Text="BACKGROUND IMAGE"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<TextBlock Text="PNG, JPG, and GIF formats supported"
												   FontSize="11"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   Margin="0,0,0,4"/>

										<Button Classes="options"
												Content="Select Image"
												HorizontalAlignment="Stretch"
												Click="SelectBackgroundImage_Click"
												FontSize="12"/>
										<Button Classes="options"
												Content="Clear Background"
												HorizontalAlignment="Stretch"
												Click="ClearBackgroundImage_Click"
												IsEnabled="{Binding BackgroundImagePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
												FontSize="12"/>

										<StackPanel Spacing="4" Margin="0,4,0,0">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Opacity:"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeText}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=BackgroundOpacitySlider, Path=Value, StringFormat={}{0:F2}}"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeTextSecondary}"/>
											</StackPanel>
											<Slider x:Name="BackgroundOpacitySlider"
													Minimum="0" Maximum="1"
													Value="{Binding BackgroundOpacity}"
													TickFrequency="0.01"
													IsSnapToTickEnabled="True"
													ValueChanged="BackgroundOpacitySlider_ValueChanged"/>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<!-- Background Music -->
										<TextBlock Text="BACKGROUND MUSIC"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<TextBlock Text="MP3, WAV, and OGG formats supported"
												   FontSize="11"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   Margin="0,0,0,4"/>

										<Button Classes="options"
												Content="Select Music"
												HorizontalAlignment="Stretch"
												Click="SelectLauncherMusic_Click"
												FontSize="12"/>
										<Button Classes="options"
												Content="Clear Music"
												HorizontalAlignment="Stretch"
												Click="ClearLauncherMusic_Click"
												IsEnabled="{Binding LauncherMusicPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
												FontSize="12"/>

										<StackPanel Spacing="4" Margin="0,4,0,0">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Volume:"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeText}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=MusicVolumeSlider, Path=Value, StringFormat={}{0:F2}}"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeTextSecondary}"/>
											</StackPanel>
											<Slider x:Name="MusicVolumeSlider"
													Minimum="0" Maximum="1"
													Value="{Binding MusicVolume}"
													TickFrequency="0.01"
													IsSnapToTickEnabled="True"
													ValueChanged="MusicVolumeSlider_ValueChanged"/>
										</StackPanel>

									</StackPanel>
								</TabItem>

								<!-- App Cards Tab -->
								<TabItem Header="App Cards">
									<StackPanel Margin="16,12,16,16" Spacing="4">

										<!-- Layout -->
										<TextBlock Text="LAYOUT"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="2">
											<CheckBox x:Name="UseGridViewCheckBox"
													  Content="Grid View"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  Checked="UseGridViewCheckBox_Checked"
													  Unchecked="UseGridViewCheckBox_Unchecked"/>
											<TextBlock Text="Display apps in a grid instead of a list"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,4,0,0">
											<CheckBox x:Name="GridCompactCardsCheckBox"
													  Content="Details in card"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsEnabled="{Binding ElementName=UseGridViewCheckBox, Path=IsChecked}"
													  Checked="GridCompactCardsCheckBox_Checked"
													  Unchecked="GridCompactCardsCheckBox_Unchecked"/>
											<TextBlock Text="Keep name, status, and buttons inside each grid card"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"/>
										</StackPanel>

										<StackPanel Spacing="6" Margin="0,4,0,0">
											<TextBlock Text="Presets"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"/>
											<StackPanel Orientation="Horizontal" Spacing="8">
												<Button Classes="modern-icon" Width="52" Height="52"
														Click="LayoutPreset_Landscape_Click"
														ToolTip.Tip="Landscape">
													<Image Width="52" Height="52" Source="avares://QuiverLauncher/Assets/Icons/preset_landscape.png"/>
												</Button>
												<Button Classes="modern-icon" Width="52" Height="52"
														Click="LayoutPreset_Square_Click"
														ToolTip.Tip="Square">
													<Image Width="52" Height="52" Source="avares://QuiverLauncher/Assets/Icons/preset_square.png"/>
												</Button>
												<Button Classes="modern-icon" Width="52" Height="52"
														Click="LayoutPreset_Portrait_Click"
														ToolTip.Tip="Portrait">
													<Image Width="52" Height="52" Source="avares://QuiverLauncher/Assets/Icons/preset_portrait.png"/>
												</Button>
												<Button Classes="modern-icon" Width="52" Height="52"
														Click="LayoutPreset_List_Click"
														ToolTip.Tip="List">
													<Image Width="52" Height="52" Source="avares://QuiverLauncher/Assets/Icons/preset_list.png"/>
												</Button>
											</StackPanel>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<!-- Card Content -->
										<TextBlock Text="CARD CONTENT"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="2" Margin="0,0,0,0">
											<TextBlock Text="Library name style"
													   FontSize="13"
													   FontWeight="SemiBold"
													   Foreground="{DynamicResource ThemeText}"/>
											<ComboBox x:Name="LibraryNameStyleComboBox"
													  Foreground="{DynamicResource ThemeText}"
													  Background="{DynamicResource ThemeBase}"
													  BorderBrush="{DynamicResource ThemeBorder}"
													  BorderThickness="1"
													  CornerRadius="4"
													  Padding="8"
													  Margin="0,4,0,0"
													  SelectionChanged="LibraryNameStyleComboBox_SelectionChanged">
												<ComboBoxItem Content="Name only" Tag="NameOnly"/>
												<ComboBoxItem Content="Name + project below" Tag="NameAndProject"/>
												<ComboBoxItem Content="Name (project) in title" Tag="NameAndProjectInTitle"/>
												<ComboBoxItem Content="Project only" Tag="ProjectOnly"/>
											</ComboBox>
											<TextBlock Text="How names and projects appear in the Library. “Below” shows the project name under the title. Custom display names always win when set."
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0">
											<TextBlock Text="Tag lines on library cards"
													   FontSize="13"
													   FontWeight="SemiBold"
													   Foreground="{DynamicResource ThemeText}"/>
											<ComboBox x:Name="LibraryCardTagMaxLinesComboBox"
													  Foreground="{DynamicResource ThemeText}"
													  Background="{DynamicResource ThemeBase}"
													  BorderBrush="{DynamicResource ThemeBorder}"
													  BorderThickness="1"
													  CornerRadius="4"
													  Padding="8"
													  Margin="0,4,0,0"
													  SelectionChanged="LibraryCardTagMaxLinesComboBox_SelectionChanged">
												<ComboBoxItem Content="0 lines" Tag="0"/>
												<ComboBoxItem Content="1 line" Tag="1"/>
												<ComboBoxItem Content="2 lines" Tag="2"/>
												<ComboBoxItem Content="3 lines" Tag="3"/>
												<ComboBoxItem Content="4 lines" Tag="4"/>
												<ComboBoxItem Content="No limit" Tag="99"/>
											</ComboBox>
											<TextBlock Text="How many wrapped lines of tags each library card can show. 0 hides tags on cards; filters still work."
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0">
											<CheckBox x:Name="ShowLibraryAppUpdateBadgesCheckBox"
													  Content="Show catalog update badges on library cards"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  Checked="ShowLibraryAppUpdateBadgesCheckBox_Checked"
													  Unchecked="ShowLibraryAppUpdateBadgesCheckBox_Unchecked"/>
											<TextBlock Text="Small badge when catalog metadata for an app has changes to review (app version updates use the orange update button)"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<!-- Card Size -->
										<TextBlock Text="CARD SIZE"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Size:"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeText}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=SlotSizeSlider, Path=Value, StringFormat={}{0:0}}"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeTextSecondary}"/>
											</StackPanel>
											<Slider x:Name="SlotSizeSlider"
													Minimum="120" Maximum="400"
													Value="152"
													TickFrequency="4"
													IsSnapToTickEnabled="True"
													ValueChanged="SlotSizeSlider_ValueChanged"/>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<!-- Action Buttons -->
										<TextBlock Text="ACTION BUTTONS"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Size:"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeText}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=ActionButtonSizeSlider, Path=Value, StringFormat={}{0:0}}"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeTextSecondary}"/>
											</StackPanel>
											<Slider x:Name="ActionButtonSizeSlider"
													Minimum="32" Maximum="80"
													Value="36"
													TickFrequency="4"
													IsSnapToTickEnabled="True"
													ValueChanged="ActionButtonSizeSlider_ValueChanged"/>
											<TextBlock Text="Size of Play, Download, and Update buttons"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"/>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<!-- App Images -->
										<TextBlock Text="GAME IMAGES"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<!-- Size -->
										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Size:"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeText}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=IconSizeSlider, Path=Value, StringFormat={}{0:0}}"
														   FontSize="11"
														   Foreground="{DynamicResource ThemeTextSecondary}"/>
											</StackPanel>
											<Slider x:Name="IconSizeSlider"
													Minimum="64" Maximum="512"
													Value="124"
													TickFrequency="4"
													IsSnapToTickEnabled="True"
													ValueChanged="IconSizeSlider_ValueChanged"/>
										</StackPanel>

										<!-- Custom Image Fill -->
										<StackPanel Spacing="2">
											<CheckBox x:Name="IconFillCheckBox"
													  Content="Fill Cards"
													  IsChecked="False"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  Checked="IconFillCheckBox_Checked"
													  Unchecked="IconFillCheckBox_Unchecked"/>
											<TextBlock Text="Stretch images to fill entire cards"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"/>
										</StackPanel>

										<!-- Image Opacity -->
										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Card Image Opacity:"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeText}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=IconOpacitySlider, Path=Value, StringFormat={}{0:F1}}"
														   FontSize="11"
														   Foreground="{DynamicResource ThemeTextSecondary}"/>
											</StackPanel>
											<Slider x:Name="IconOpacitySlider"
													Minimum="0.0" Maximum="1.0"
													Value="0.2"
													TickFrequency="0.1"
													IsSnapToTickEnabled="True"
													ValueChanged="IconOpacitySlider_ValueChanged"/>
											<TextBlock Text="Control image transparency"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"/>
										</StackPanel>

										<!-- Left Padding -->
										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Left Padding:"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeText}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=IconMarginSlider, Path=Value, StringFormat={}{0:0}}"
														   FontSize="11"
														   Foreground="{DynamicResource ThemeTextSecondary}"/>
											</StackPanel>
											<Slider x:Name="IconMarginSlider"
													Minimum="0" Maximum="512"
													Value="0"
													TickFrequency="8"
													IsSnapToTickEnabled="True"
													ValueChanged="IconMarginSlider_ValueChanged"/>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<!-- Text -->
										<TextBlock Text="TEXT"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Text Padding:"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeText}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=TextMarginSlider, Path=Value, StringFormat={}{0:0}}"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeTextSecondary}"/>
											</StackPanel>
											<Slider x:Name="TextMarginSlider"
													Minimum="0" Maximum="256"
													Value="0"
													TickFrequency="8"
													IsSnapToTickEnabled="True"
													ValueChanged="TextMarginSlider_ValueChanged"/>
											<TextBlock Text="Adjust the left spacing of text labels"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"/>
										</StackPanel>

									</StackPanel>
								</TabItem>

								<!-- Advanced Tab -->
								<TabItem Header="Advanced">
									<StackPanel Margin="16,12,16,16" Spacing="4">

										<!-- GitHub API Token -->
										<TextBlock Text="GITHUB API TOKEN"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<TextBlock Text="Increases API rate limits for faster and more reliable downloads"
												   FontSize="11"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   TextWrapping="Wrap"
												   Margin="0,0,0,6"/>

										<TextBox x:Name="GitHubTokenTextBox"
												 Foreground="{DynamicResource ThemeText}"
												 Background="{DynamicResource ThemeBase}"
												 BorderBrush="{DynamicResource ThemeBorder}"
												 BorderThickness="1"
												 Padding="12,10"
												 CornerRadius="4"
												 TextChanged="GitHubTokenTextBox_TextChanged"
												 Text="{Binding Settings.GitHubApiToken, Mode=TwoWay}"/>

										<Button Classes="options"
												Content="Create GitHub Token"
												HorizontalAlignment="Stretch"
												Click="CreateGitHubToken_Click"
												FontSize="12"/>

										<Button Classes="options"
												Content="Clear Token"
												HorizontalAlignment="Stretch"
												Click="ClearGitHubToken_Click"
												FontSize="12"/>

										<TextBlock Text="Visit GitHub's token documentation for more information on generating a personal access token."
												   FontSize="10"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   FontStyle="Italic"
												   TextWrapping="Wrap"
												   Margin="0,8,0,0"/>

										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,12,0,8"/>

										<!-- GitLab API Token -->
										<TextBlock Text="GITLAB API TOKEN"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<TextBlock Text="Optional. Raises GitLab API rate limits and allows private gitlab.com projects"
												   FontSize="11"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   TextWrapping="Wrap"
												   Margin="0,0,0,6"/>

										<TextBox x:Name="GitLabTokenTextBox"
												 Foreground="{DynamicResource ThemeText}"
												 Background="{DynamicResource ThemeBase}"
												 BorderBrush="{DynamicResource ThemeBorder}"
												 BorderThickness="1"
												 Padding="12,10"
												 CornerRadius="4"
												 TextChanged="GitLabTokenTextBox_TextChanged"
												 Text="{Binding Settings.GitLabApiToken, Mode=TwoWay}"/>

										<Button Classes="options"
												Content="Create GitLab Token"
												HorizontalAlignment="Stretch"
												Click="CreateGitLabToken_Click"
												FontSize="12"/>

										<Button Classes="options"
												Content="Clear GitLab Token"
												HorizontalAlignment="Stretch"
												Click="ClearGitLabToken_Click"
												FontSize="12"/>

										<TextBlock Text="Visit GitLab's personal access token settings to create a token (read_api is enough for public releases)."
												   FontSize="10"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   FontStyle="Italic"
												   TextWrapping="Wrap"
												   Margin="0,8,0,0"/>

										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,12,0,8"/>

										<StackPanel Spacing="2">
											<CheckBox x:Name="AllowPrereleaseLauncherUpdatesCheckBox"
													  Content="Include prerelease Quiver Launcher updates"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  Checked="AllowPrereleaseLauncherUpdatesCheckBox_Checked"
													  Unchecked="AllowPrereleaseLauncherUpdatesCheckBox_Unchecked"/>
											<TextBlock Text="For development, to allow updates from Quiver Launcher GitHub prereleases. Not for normal users. Use at your own risk."
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

									</StackPanel>
								</TabItem>

							</TabControl>
						</StackPanel>
					</ScrollViewer>
				</Border>
				
				<!-- Changelog Panel -->
				<Border x:Name="ChangelogPanel"
						Grid.RowSpan="2"
						Background="{DynamicResource ThemeBase}"
						IsVisible="False"
						ZIndex="100">
					<Grid RowDefinitions="Auto,*">
						<Border Grid.Row="0"
								Background="{DynamicResource ThemeDarker}"
								BorderBrush="{DynamicResource ThemeBorder}"
								BorderThickness="0,0,0,1"
								Padding="40,16,40,16">
							<Grid ColumnDefinitions="*,Auto">
								<TextBlock x:Name="ChangelogTitle"
										   Grid.Column="0"
										   Text="Changelog"
										   FontSize="28"
										   FontWeight="Bold"
										   Foreground="{DynamicResource ThemeText}"
										   VerticalAlignment="Center"/>
								<Button x:Name="CloseChangelogButton"
										Grid.Column="1"
										Classes="options"
										Content="Close"
										Width="100"
										Click="CloseChangelog_Click"/>
							</Grid>
						</Border>
						<ScrollViewer x:Name="ChangelogScrollViewer"
									  Grid.Row="1"
									  VerticalScrollBarVisibility="Auto"
									  Margin="40,20,40,40">
							<StackPanel MaxWidth="900">
								<ItemsControl x:Name="ChangelogContent"
											  ItemsSource="{Binding}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<ContentControl Content="{Binding}"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</ScrollViewer>
					</Grid>
				</Border>

				<!-- Mod details (README / Changelog) -->
				<Border x:Name="ModDetailsPanel"
						Grid.RowSpan="2"
						Background="{DynamicResource ThemeBase}"
						IsVisible="False"
						ZIndex="110">
					<Grid RowDefinitions="Auto,Auto,*">
						<Border Grid.Row="0"
								Background="{DynamicResource ThemeDarker}"
								BorderBrush="{DynamicResource ThemeBorder}"
								BorderThickness="0,0,0,1"
								Padding="40,16,40,16">
							<Grid ColumnDefinitions="*,Auto">
								<TextBlock x:Name="ModDetailsTitle"
										   Grid.Column="0"
										   Text="Mod Details"
										   FontSize="24"
										   FontWeight="Bold"
										   Foreground="{DynamicResource ThemeText}"
										   VerticalAlignment="Center"
										   TextTrimming="CharacterEllipsis"
										   Margin="0,0,16,0"/>
								<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
									<Button x:Name="ModDetailsOpenPageButton"
											Classes="options"
											Content="Open Page"
											Click="ModDetailsOpenPage_Click"/>
									<Button x:Name="CloseModDetailsButton"
											Classes="options"
											Content="Close"
											Width="100"
											Click="CloseModDetails_Click"/>
								</StackPanel>
							</Grid>
						</Border>
						<StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="40,16,40,0">
							<Button x:Name="ModDetailsTabDetailsButton"
									Classes="catalog-filter selected"
									Content="Details"
									Tag="Details"
									FontSize="11"
									Click="ModDetailsTab_Click"/>
							<Button x:Name="ModDetailsTabChangelogButton"
									Classes="catalog-filter"
									Content="Changelog"
									Tag="Changelog"
									FontSize="11"
									Click="ModDetailsTab_Click"/>
						</StackPanel>
						<ScrollViewer x:Name="ModDetailsScrollViewer"
									  Grid.Row="2"
									  VerticalScrollBarVisibility="Auto"
									  Margin="40,16,40,40">
							<StackPanel MaxWidth="900">
								<ItemsControl x:Name="ModDetailsContent">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<ContentControl Content="{Binding}"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</ScrollViewer>
					</Grid>
				</Border>

				<!-- Entry Form Overlay -->
				<Border x:Name="EntryFormOverlay"
						Grid.RowSpan="2"
						Background="{DynamicResource ThemeBase}"
						IsVisible="False"
						ZIndex="100">
					<ScrollViewer VerticalScrollBarVisibility="Auto" Margin="40,40,6,40">
						<StackPanel Spacing="20" MinWidth="640" MaxWidth="960" HorizontalAlignment="Center" Margin="0,0,40,0">
							<Border Background="{DynamicResource ThemeDarker}"
									BorderBrush="{DynamicResource ThemeBorder}"
									BorderThickness="1"
									CornerRadius="8"
									Padding="16">
								<StackPanel Spacing="12">
									<TextBlock x:Name="FormTitleText"
											   Text="Create New Entry"
											   FontSize="18"
											   FontWeight="Bold"
											   Foreground="{DynamicResource ThemeText}"/>
									<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,4,0,8"/>

									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="130"/>
											<ColumnDefinition Width="*"/>
										</Grid.ColumnDefinitions>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="Auto"/>
										</Grid.RowDefinitions>

										<TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}"/>
										<TextBox Grid.Row="0" Grid.Column="1"
												 x:Name="NewGameNameTextBox"
												 Foreground="{DynamicResource ThemeText}"
												 Background="{DynamicResource ThemeBase}"
												 BorderBrush="{DynamicResource ThemeBorder}"
												 BorderThickness="1"
												 CornerRadius="4"
												 Padding="8"
												 Margin="8,0,0,8"
												 TextChanged="GameNameTextBox_TextChanged"/>

										<TextBlock Grid.Row="1" Grid.Column="0" Text="Project:" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}"/>
										<TextBox Grid.Row="1" Grid.Column="1"
												 x:Name="NewGameProjectTextBox"
												 Watermark="Team / project / author (optional)"
												 Foreground="{DynamicResource ThemeText}"
												 Background="{DynamicResource ThemeBase}"
												 BorderBrush="{DynamicResource ThemeBorder}"
												 BorderThickness="1"
												 CornerRadius="4"
												 Padding="8"
												 Margin="8,0,0,8"/>

										<TextBlock Grid.Row="2" Grid.Column="0" Text="Custom Name:" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}"/>
										<TextBox Grid.Row="2" Grid.Column="1"
												 x:Name="NewGameCustomDisplayNameTextBox"
												 Watermark="Overrides library name style when set"
												 Foreground="{DynamicResource ThemeText}"
												 Background="{DynamicResource ThemeBase}"
												 BorderBrush="{DynamicResource ThemeBorder}"
												 BorderThickness="1"
												 CornerRadius="4"
												 Padding="8"
												 Margin="8,0,0,8"/>

										<TextBlock Grid.Row="3" Grid.Column="0" Text="Management:" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}"/>
										<CheckBox Grid.Row="3" Grid.Column="1"
												  x:Name="NewGameManuallyManagedCheckBox"
												  Content="Manually managed (no repository or updates)"
												  Foreground="{DynamicResource ThemeText}"
												  Margin="8,0,0,8"
												  VerticalAlignment="Center"
												  Checked="ManuallyManagedCheckBox_Changed"
												  Unchecked="ManuallyManagedCheckBox_Changed"/>

										<TextBlock Grid.Row="4" Grid.Column="0" x:Name="NewGameRepositorySourceLabel" Text="Repository Source:" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}"/>
										<ComboBox Grid.Row="4" Grid.Column="1"
												  x:Name="NewGameRepositorySourceComboBox"
												  Foreground="{DynamicResource ThemeText}"
												  Background="{DynamicResource ThemeBase}"
												  BorderBrush="{DynamicResource ThemeBorder}"
												  BorderThickness="1"
												  CornerRadius="4"
												  Padding="8"
												  Margin="8,0,0,8"
												  HorizontalAlignment="Stretch"
												  SelectedIndex="0">
											<ComboBoxItem Content="GitHub" Tag="github"/>
											<ComboBoxItem Content="GitLab" Tag="gitlab"/>
										</ComboBox>

										<TextBlock Grid.Row="5" Grid.Column="0" x:Name="NewGameRepositoryLabel" Text="Repository:" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}"/>
										<TextBox Grid.Row="5" Grid.Column="1"
												 x:Name="NewGameRepoTextBox"
												 Foreground="{DynamicResource ThemeText}"
												 Background="{DynamicResource ThemeBase}"
												 BorderBrush="{DynamicResource ThemeBorder}"
												 BorderThickness="1"
												 CornerRadius="4"
												 Padding="8"
												 Margin="8,0,0,8"
												 TextChanged="GameRepoTextBox_TextChanged"/>

										<TextBlock Grid.Row="6" Grid.Column="0" Text="Folder Name:" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}"/>
										<TextBox Grid.Row="6" Grid.Column="1"
												 x:Name="NewGameFolderTextBox"
												 Foreground="{DynamicResource ThemeText}"
												 Background="{DynamicResource ThemeBase}"
												 BorderBrush="{DynamicResource ThemeBorder}"
												 BorderThickness="1"
												 CornerRadius="4"
												 Padding="8"
												 Margin="8,0,0,8"
												 TextChanged="GameFolderTextBox_TextChanged"/>

										<TextBlock Grid.Row="7" Grid.Column="0" Text="Tags:" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}"/>
										<TextBox Grid.Row="7" Grid.Column="1"
												 x:Name="NewGameTagsTextBox"
												 Watermark="e.g. n64, recomp"
												 Foreground="{DynamicResource ThemeText}"
												 Background="{DynamicResource ThemeBase}"
												 BorderBrush="{DynamicResource ThemeBorder}"
												 BorderThickness="1"
												 CornerRadius="4"
												 Padding="8"
												 Margin="8,0,0,8"
												 AcceptsReturn="False"
												 TextWrapping="Wrap"
												 MinHeight="56"/>

										<TextBlock Grid.Row="8" Grid.Column="0" Text="Icon URL:" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}"/>
										<TextBox Grid.Row="8" Grid.Column="1"
												 x:Name="NewGameIconTextBox"
												 Foreground="{DynamicResource ThemeText}"
												 Background="{DynamicResource ThemeBase}"
												 BorderBrush="{DynamicResource ThemeBorder}"
												 BorderThickness="1"
												 CornerRadius="4"
												 Padding="8"
												 Margin="8,0,0,8"
												 TextChanged="GameIconTextBox_TextChanged"/>

										<TextBlock Grid.Row="9" Grid.Column="0" Text="Files To Add:" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}"/>
										<TextBox Grid.Row="9" Grid.Column="1"
												 x:Name="NewGameFilesToAddTextBox"
												 Watermark="e.g. portable.txt"
												 Foreground="{DynamicResource ThemeText}"
												 Background="{DynamicResource ThemeBase}"
												 BorderBrush="{DynamicResource ThemeBorder}"
												 BorderThickness="1"
												 CornerRadius="4"
												 Padding="8"
												 Margin="8,0,0,8"/>

										<TextBlock Grid.Row="10" Grid.Column="0" Text="Mods Path:" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}"/>
										<TextBox Grid.Row="10" Grid.Column="1"
												 x:Name="NewGameModsPathTextBox"
												 Watermark="e.g. mods"
												 Foreground="{DynamicResource ThemeText}"
												 Background="{DynamicResource ThemeBase}"
												 BorderBrush="{DynamicResource ThemeBorder}"
												 BorderThickness="1"
												 CornerRadius="4"
												 Padding="8"
												 Margin="8,0,0,8"/>

										<TextBlock Grid.Row="11" Grid.Column="0" Text="Mod Layout:" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}"/>
										<CheckBox Grid.Row="11" Grid.Column="1"
												  x:Name="NewGameModsFolderPerModCheckBox"
												  Content="Install each mod into its own folder"
												  Foreground="{DynamicResource ThemeText}"
												  Margin="8,0,0,8"
												  VerticalAlignment="Center"/>

										<TextBlock Grid.Row="12" Grid.Column="0" Text="Mod Sources:" VerticalAlignment="Top" Margin="0,10,0,0" Foreground="{DynamicResource ThemeTextSecondary}"/>
										<TextBox Grid.Row="12" Grid.Column="1"
												 x:Name="NewGameModsSourcesTextBox"
												 Watermark="Thunderstore URL/slug or GameBanana mods/games/{id} (one per line)"
												 Foreground="{DynamicResource ThemeText}"
												 Background="{DynamicResource ThemeBase}"
												 BorderBrush="{DynamicResource ThemeBorder}"
												 BorderThickness="1"
												 CornerRadius="4"
												 Padding="8"
												 Margin="8,0,0,0"
												 AcceptsReturn="True"
												 TextWrapping="Wrap"
												 MinHeight="72"/>
									</Grid>

									<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
										<Button x:Name="CancelButton"
												Classes="options"
												Content="Cancel"
												FontSize="12"
												Width="100"
												Click="CancelForm_Click"/>
										<Button x:Name="CreateEditButton"
												Classes="options"
												Content="Create Entry"
												FontSize="12"
												Width="120"
												Click="CreateNewEntry_Click"/>
									</StackPanel>
								</StackPanel>
							</Border>

							<Border x:Name="ValidationStatusBorder"
									Background="{DynamicResource ThemeDarker}"
									BorderBrush="{DynamicResource ThemeBorder}"
									BorderThickness="1"
									CornerRadius="8"
									Padding="12"
									IsVisible="False">
								<TextBlock x:Name="ValidationStatusText"
										   Text=""
										   Foreground="{DynamicResource ThemeText}"
										   FontSize="12"
										   TextWrapping="Wrap"/>
							</Border>
						</StackPanel>
					</ScrollViewer>
				</Border>

				<!-- Display Filter Overlay -->
				<Border x:Name="DisplayFilterOverlay"
						Grid.RowSpan="2"
						Background="#CC000000"
						IsVisible="False"
						ZIndex="110">
					<Border Background="{DynamicResource ThemeDarker}"
							BorderBrush="{DynamicResource ThemeBorder}"
							BorderThickness="1"
							CornerRadius="8"
							Padding="20"
							MaxWidth="480"
							HorizontalAlignment="Center"
							VerticalAlignment="Center">
						<StackPanel Spacing="12">
							<TextBlock x:Name="DisplayFilterOverlayTitle"
									   Text="Add Display Filter"
									   FontSize="18"
									   FontWeight="Bold"
									   Foreground="{DynamicResource ThemeText}"/>
							<TextBox x:Name="DisplayFilterNameTextBox"
									 Watermark="Filter name"
									 Foreground="{DynamicResource ThemeText}"
									 Background="{DynamicResource ThemeBase}"
									 BorderBrush="{DynamicResource ThemeBorder}"
									 BorderThickness="1"
									 CornerRadius="4"
									 Padding="8"/>
							<TextBlock Text="Include tags"
									   FontSize="13"
									   FontWeight="SemiBold"
									   Foreground="{DynamicResource ThemeText}"/>
							<TextBox x:Name="DisplayFilterTagsTextBox"
									 Watermark="Tags (comma-separated, e.g. n64, favorites)"
									 Foreground="{DynamicResource ThemeText}"
									 Background="{DynamicResource ThemeBase}"
									 BorderBrush="{DynamicResource ThemeBorder}"
									 BorderThickness="1"
									 CornerRadius="4"
									 Padding="8"
									 AcceptsReturn="False"
									 TextWrapping="Wrap"
									 MinHeight="56"/>
							<TextBlock Text="Include match mode"
									   FontSize="13"
									   FontWeight="SemiBold"
									   Foreground="{DynamicResource ThemeText}"/>
							<ComboBox x:Name="DisplayFilterMatchModeComboBox"
									  SelectionChanged="DisplayFilterMatchModeComboBox_SelectionChanged">
								<ComboBoxItem Content="Any tag"/>
								<ComboBoxItem Content="All tags"/>
							</ComboBox>
							<TextBlock x:Name="DisplayFilterMatchModeHelpText"
									   FontSize="11"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   TextWrapping="Wrap"/>
							<TextBlock Text="Exclude tags"
									   FontSize="13"
									   FontWeight="SemiBold"
									   Foreground="{DynamicResource ThemeText}"/>
							<TextBox x:Name="DisplayFilterExcludeTagsTextBox"
									 Watermark="Tags to hide (comma-separated, optional, e.g. ai)"
									 Foreground="{DynamicResource ThemeText}"
									 Background="{DynamicResource ThemeBase}"
									 BorderBrush="{DynamicResource ThemeBorder}"
									 BorderThickness="1"
									 CornerRadius="4"
									 Padding="8"
									 AcceptsReturn="False"
									 TextWrapping="Wrap"
									 MinHeight="56"/>
							<TextBlock Text="Exclude match mode"
									   FontSize="13"
									   FontWeight="SemiBold"
									   Foreground="{DynamicResource ThemeText}"/>
							<ComboBox x:Name="DisplayFilterExcludeMatchModeComboBox"
									  SelectionChanged="DisplayFilterExcludeMatchModeComboBox_SelectionChanged">
								<ComboBoxItem Content="Any tag"/>
								<ComboBoxItem Content="All tags"/>
							</ComboBox>
							<TextBlock x:Name="DisplayFilterExcludeMatchModeHelpText"
									   FontSize="11"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   TextWrapping="Wrap"/>
							<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
								<Button x:Name="CancelDisplayFilterButton"
										Classes="options"
										Content="Cancel"
										Width="100"
										Click="CancelDisplayFilterEdit_Click"/>
								<Button x:Name="SaveDisplayFilterButton"
										Classes="options"
										Content="Save"
										Width="100"
										Click="SaveDisplayFilter_Click"/>
							</StackPanel>
						</StackPanel>
					</Border>
				</Border>

				<!-- Tag Edit Overlay -->
				<Border x:Name="TagEditOverlay"
						Grid.RowSpan="2"
						Background="#CC000000"
						IsVisible="False"
						ZIndex="110">
					<Border x:Name="TagEditDialogPanel"
							Background="{DynamicResource ThemeDarker}"
							BorderBrush="{DynamicResource ThemeBorder}"
							BorderThickness="1"
							CornerRadius="8"
							Padding="20"
							MaxWidth="480"
							HorizontalAlignment="Center"
							VerticalAlignment="Center">
						<StackPanel Spacing="12">
							<TextBlock x:Name="TagEditTitleText"
									   Text="Edit Tags"
									   FontSize="18"
									   FontWeight="Bold"
									   Foreground="{DynamicResource ThemeText}"/>
							<TextBlock x:Name="TagEditAppNameText"
									   FontSize="13"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   TextWrapping="Wrap"/>
							<TextBox x:Name="TagEditTextBox"
									 Watermark="Tags (comma-separated)"
									 Foreground="{DynamicResource ThemeText}"
									 Background="{DynamicResource ThemeBase}"
									 BorderBrush="{DynamicResource ThemeBorder}"
									 BorderThickness="1"
									 CornerRadius="4"
									 Padding="8"
									 AcceptsReturn="False"
									 TextWrapping="Wrap"
									 MinHeight="56"/>
							<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
								<Button x:Name="TagEditCancelButton"
										Classes="options"
										Content="Cancel"
										Width="100"
										Click="CancelTagEdit_Click"/>
								<Button x:Name="TagEditSaveButton"
										Classes="options"
										Content="Save"
										Width="100"
										Click="SaveTagEdit_Click"/>
							</StackPanel>
						</StackPanel>
					</Border>
				</Border>

			</Grid>
		</Grid>
	</Grid>
  </Border>
</Window>
