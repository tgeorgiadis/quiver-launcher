<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QuiverLauncher"
        x:Class="QuiverLauncher.MainWindow"
        Title="Quiver Launcher"
        Width="1280" Height="720"
        MinWidth="750" MinHeight="490"
        Background="{Binding WindowBackground}"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="{Binding WindowChrome}"
        ExtendClientAreaToDecorationsHint="{Binding ExtendClientAreaEnabled}">
	<local:MainView x:Name="RootView"/>
</Window>
