<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>QuiverLauncher.Core</AssemblyName>
		<RootNamespace>QuiverLauncher.Core</RootNamespace>
		<PublishSingleFile>false</PublishSingleFile>
	</PropertyGroup>
	<PropertyGroup Condition="'$(QuiverExcludeWindowsDrawing)' == 'true'">
		<OutputPath>bin\android-ref\$(Configuration)\</OutputPath>
		<IntermediateOutputPath>obj\android-ref\$(Configuration)\</IntermediateOutputPath>
		<DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="SharpCompress" Version="0.50.1" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="QuiverLauncher" />
		<InternalsVisibleTo Include="QuiverLauncher.Tests" />
	</ItemGroup>
</Project>
