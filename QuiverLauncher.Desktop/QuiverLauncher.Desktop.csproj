<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ApplicationIcon>..\icon.ico</ApplicationIcon>
		<AssemblyName>QuiverLauncher.Desktop</AssemblyName>
		<RootNamespace>QuiverLauncher.Desktop</RootNamespace>
		<AssemblyTitle>Quiver Launcher</AssemblyTitle>
		<AssemblyDescription>Quiver Launcher — download and manage GitHub-hosted game ports</AssemblyDescription>
		<Version>3.5.0</Version>
		<AssemblyVersion>3.5.0.0</AssemblyVersion>
		<FileVersion>3.5.0.0</FileVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
		<DefineConstants>$(DefineConstants);LINUX</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
		<DefineConstants>$(DefineConstants);OSX</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\icon.ico" Link="icon.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- ppy.SDL2-CS only ships an x86_64 macOS libSDL2, so Apple Silicon gets the arm64 slice of the
	     official SDL2 2.32.10 framework. Also covers RID-less `dotnet run` on an arm64 Mac. -->
	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX')) and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64')">
		<None Include="native\osx-arm64\libSDL2.dylib" Link="libSDL2.dylib">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Include="native\osx-arm64\SDL2-License.txt" Link="SDL2-License.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<!-- ppy.SDL2-CS's Windows SDL2.dll is SDL 2.0.14, whose controller database predates most recent
	     DirectInput gamepads, so 64-bit Windows gets the official SDL2 2.32.10 DLL in its place. -->
	<PropertyGroup>
		<QuiverBundledWindowsSdl2 Condition="'$(RuntimeIdentifier)' == 'win-x64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows')) and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64')">true</QuiverBundledWindowsSdl2>
	</PropertyGroup>
	<ItemGroup Condition="'$(QuiverBundledWindowsSdl2)' == 'true'">
		<None Include="native\win-x64\SDL2.dll" Link="SDL2.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Include="native\win-x64\SDL2-License.txt" Link="SDL2-License.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>
	<Target Name="DropPackagedWindowsSdl2" AfterTargets="ResolvePackageAssets" Condition="'$(QuiverBundledWindowsSdl2)' == 'true'">
		<ItemGroup>
			<NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(NuGetPackageId)' == 'ppy.SDL2-CS'" />
			<RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(NuGetPackageId)' == 'ppy.SDL2-CS' and '%(RuntimeIdentifier)' == 'win-x64'" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<ProjectReference Include="..\QuiverLauncher.App.csproj" />
	</ItemGroup>

	<!-- AppHost can be renamed; it still loads QuiverLauncher.Desktop.dll. -->
	<Target Name="AliasQuiverLauncherExe" AfterTargets="Build;Publish">
		<PropertyGroup>
			<_AliasDir Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)$(AssemblyName).exe')">$(PublishDir)</_AliasDir>
			<_AliasDir Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)$(AssemblyName)')">$(PublishDir)</_AliasDir>
			<_AliasDir Condition="'$(_AliasDir)' == ''">$(OutputPath)</_AliasDir>
		</PropertyGroup>
		<Copy SourceFiles="$(_AliasDir)$(AssemblyName).exe"
		      DestinationFiles="$(_AliasDir)QuiverLauncher.exe"
		      SkipUnchangedFiles="true"
		      Condition="Exists('$(_AliasDir)$(AssemblyName).exe')" />
		<Copy SourceFiles="$(_AliasDir)$(AssemblyName)"
		      DestinationFiles="$(_AliasDir)QuiverLauncher"
		      SkipUnchangedFiles="true"
		      Condition="Exists('$(_AliasDir)$(AssemblyName)') and !Exists('$(_AliasDir)$(AssemblyName).exe')" />
	</Target>
</Project>
