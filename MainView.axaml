	</Style>
	<Style Selector="UserControl.mobile Border#EntryFormDialogPanel CheckBox">
		<Setter Property="MinHeight" Value="44"/>
	</Style>
	<Style Selector="UserControl.mobile Button.message-prompt">
		<Setter Property="MinHeight" Value="44"/>
		<Setter Property="MinWidth" Value="88"/>
	</Style>
	<Style Selector="UserControl.mobile Button.catalog-filter">
		<Setter Property="MinHeight" Value="40"/>
	</Style>
	<Style Selector="UserControl.mobile Border.catalog-source-card">
		<Setter Property="Width" Value="NaN"/>
		<Setter Property="MinWidth" Value="0"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="Margin" Value="0,0,0,12"/>
	</Style>
	<Style Selector="UserControl.mobile Grid#LibrarySearchHost">
		<Setter Property="Width" Value="NaN"/>
		<Setter Property="MinWidth" Value="0"/>
		<Setter Property="Margin" Value="0"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
	</Style>
	<Style Selector="UserControl.mobile TextBox#CatalogSearchTextBox">
		<Setter Property="Width" Value="NaN"/>
		<Setter Property="MinWidth" Value="160"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
	</Style>
	<Style Selector="Border.header-inner">
		<Setter Property="Padding" Value="0,8,0,8"/>
	</Style>
	<Style Selector="Button#AddNewEntryButton /template/ Border">
		<Setter Property="CornerRadius" Value="4"/>
	</Style>
	<Style Selector="Button#AddNewEntryButton">
		<Setter Property="Background" Value="{DynamicResource ThemeDarker}"/>
	</Style>
	<Style Selector="Button#AddNewEntryButton:pointerover">
		<Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
	</Style>
	<Style Selector="UserControl.gamepad-chrome Button#AddNewEntryButton:pointerover">
		<Setter Property="Background" Value="{DynamicResource ThemeDarker}"/>
	</Style>
	<Style Selector="UserControl.gamepad-chrome Button#AddNewEntryButton.gamepad-focused:pointerover">
		<Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
	</Style>
	<Style Selector="Button#AddNewEntryButton:pressed">
		<Setter Property="Background" Value="{DynamicResource ThemeDarker}"/>
	</Style>
	<Style Selector="UserControl.mobile Border.header-inner">
		<Setter Property="Padding" Value="0"/>
	</Style>
	<Style Selector="UserControl.mobile TextBlock#HeaderTitleText">
		<Setter Property="FontSize" Value="18"/>
		<Setter Property="Margin" Value="0"/>
	</Style>
	<Style Selector="UserControl.mobile TextBox#LibrarySearchTextBox">
		<Setter Property="MinHeight" Value="32"/>
		<Setter Property="FontSize" Value="14"/>
	</Style>
	<Style Selector="UserControl.mobile Button.modern-icon.mobile-header-icon">
		<Setter Property="Width" Value="28"/>
		<Setter Property="Height" Value="28"/>
		<Setter Property="MinHeight" Value="28"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="Margin" Value="8,0,0,0"/>
		<Setter Property="FontSize" Value="16"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="White"/>
	</Style>
	<Style Selector="StackPanel#SidebarLogoPanel">
		<Setter Property="Margin" Value="20"/>
	</Style>
	<Style Selector="Image#SidebarLogoImage">
		<Setter Property="Width" Value="45.75"/>
		<Setter Property="Height" Value="95.25"/>
	</Style>
	<Style Selector="Button#ContinueButton">
		<Setter Property="Height" Value="64"/>
	</Style>
	<Style Selector="UserControl.mobile StackPanel#SidebarLogoPanel">
		<Setter Property="Margin" Value="8"/>
	</Style>
	<Style Selector="UserControl.mobile Image#SidebarLogoImage">
		<Setter Property="Width" Value="19.2"/>
		<Setter Property="Height" Value="40"/>
	</Style>
	<Style Selector="UserControl.mobile-landscape StackPanel#SidebarLogoPanel">
		<Setter Property="Margin" Value="8,4"/>
	</Style>
	<Style Selector="UserControl.mobile-landscape Image#SidebarLogoImage">
		<Setter Property="Width" Value="15.36"/>
		<Setter Property="Height" Value="32"/>
	</Style>
	<Style Selector="UserControl.mobile-landscape Button#ContinueButton">
		<Setter Property="Height" Value="40"/>
		<Setter Property="MinHeight" Value="40"/>
	</Style>
	<Style Selector="UserControl.mobile ScrollViewer#SidebarBodyScroller">
		<Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
		<Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
		<Setter Property="ScrollViewer.IsScrollInertiaEnabled" Value="True"/>
	</Style>

</UserControl.Styles>

<Border CornerRadius="0" ClipToBounds="True" Background="Transparent">
	<Grid>
	<SplitView x:Name="MainSplitView"
			   CompactPaneLength="0"
			   DisplayMode="Inline"
			   IsPaneOpen="True"
			   OpenPaneLength="240"
			   PaneBackground="{DynamicResource ThemeDarker}"
			   PanePlacement="Left">
		<SplitView.Pane>
		<!-- Left Sidebar Navigation -->
		<Border x:Name="SidebarPanel"
				XYFocus.NavigationModes="Gamepad,Remote"
				XYFocus.UpNavigationStrategy="Projection"
				XYFocus.DownNavigationStrategy="Projection"
				XYFocus.LeftNavigationStrategy="Projection"
				XYFocus.RightNavigationStrategy="Projection"
				Background="{DynamicResource ThemeDarker}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0">
			<Grid Margin="0">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!-- Logo/Header -->
				<StackPanel x:Name="SidebarLogoPanel"
							Grid.Row="0"
							Orientation="Horizontal"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Spacing="6">
					<Image x:Name="SidebarLogoImage"
						   Source="avares://QuiverLauncher/Assets/app.png"
						   VerticalAlignment="Center"/>
					<StackPanel Orientation="Vertical"
								VerticalAlignment="Center"
								Margin="20,0,0,0"
								Spacing="2">
						<TextBlock Text="QUIVER"
								   FontSize="18"
								   FontWeight="Bold"
								   Foreground="{DynamicResource ThemeText}"
								   LetterSpacing="2"/>
						<TextBlock Text="LAUNCHER"
								   FontSize="11"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource ThemeTextSecondary}"
								   LetterSpacing="2.5"/>
					</StackPanel>
				</StackPanel>

				<!-- Navigation Buttons -->
				<StackPanel x:Name="SidebarNavPanel" Grid.Row="1" Margin="12,0" VerticalAlignment="Top">

						<!-- Continue Button -->
						<Button x:Name="ContinueButton"
								Classes="settings"
								Margin="0,0,0,4"
								CornerRadius="8"
								Width="216"
								HorizontalAlignment="Left"
								Click="ContinueButton_Click"
								IsVisible="{Binding IsContinueVisible}">
							<Grid ColumnDefinitions="*,Auto">
								<StackPanel Grid.Column="0"
											Orientation="Horizontal"
											VerticalAlignment="Center">
									<Image Width="32" Height="32" 
										   Source="avares://QuiverLauncher/Assets/Continue.png"
										   Margin="0,0,12,0"/>
									<TextBlock Text="Continue" 
											  VerticalAlignment="Center"/>
								</StackPanel>
								<Border Grid.Column="1"
										ClipToBounds="True"
										MaxWidth="48"
										MaxHeight="44"
										Margin="8,0,0,0"
										VerticalAlignment="Center"
										HorizontalAlignment="Right">
									<asyncImageLoader:AdvancedImage Source="{Binding ContinueGameInfo.DefaultIconUrl}"
																	Stretch="Uniform"
																	MaxWidth="48"
																	MaxHeight="44"/>
								</Border>
							</Grid>
						</Button>

						<!-- Library Button -->
						<Button x:Name="LibraryNavButton"
								Classes="settings selected"
								Margin="0,0,0,4"
								CornerRadius="8"
								Width="216"
								HorizontalAlignment="Left"
								Click="LibraryNavButton_Click">
							<StackPanel Orientation="Horizontal">
								<Image Width="32" Height="32"
									   Source="avares://QuiverLauncher/Assets/DefaultGame.png"
									   Margin="0,0,12,0"/>
								<TextBlock Text="Library" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>

						<!-- App Catalog Button -->
						<Button x:Name="AppCatalogNavButton"
								Classes="settings"
								Margin="0,0,0,4"
								CornerRadius="8"
								Width="216"
								HorizontalAlignment="Left"
								Click="AppCatalogNavButton_Click">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
								<Image Width="32" Height="32"
									   Source="avares://QuiverLauncher/Assets/AppCatalog.png"
									   Margin="0,0,2,0"/>
								<TextBlock Text="App Catalog" VerticalAlignment="Center"/>
								<Border Background="{DynamicResource ThemeLighter}"
										CornerRadius="10"
										MinWidth="20"
										Height="20"
										Padding="6,0"
										VerticalAlignment="Center"
										IsVisible="{Binding CatalogReviewBadgeVisible}">
									<TextBlock Text="{Binding CatalogReviewBadgeCount}"
											   FontSize="11"
											   FontWeight="Bold"
											   HorizontalAlignment="Center"
											   VerticalAlignment="Center"/>
								</Border>
							</StackPanel>
						</Button>
					</StackPanel>

				<ScrollViewer x:Name="SidebarBodyScroller"
							  Grid.Row="2"
							  IsVisible="False"
							  HorizontalScrollBarVisibility="Disabled"
							  VerticalScrollBarVisibility="Hidden">
					<StackPanel x:Name="SidebarBodyHost"/>
				</ScrollViewer>

				<!-- Library-only filters -->
				<Grid x:Name="LibraryFiltersPanel" Grid.Row="2" RowDefinitions="Auto,*">
				<StackPanel Grid.Row="0" Margin="0,4,0,8">
					<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,0,0,8"/>
					<TextBlock Text="SHOW"
							   FontSize="10"
							   FontWeight="Bold"
							   Foreground="{DynamicResource ThemeTextSecondary}"
							   LetterSpacing="1"
							   Margin="24,0,0,4"/>
				</StackPanel>

				<!-- Filter Buttons ScrollViewer -->
				<ScrollViewer x:Name="LibraryFiltersScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="12,0,12,0">

							<Button x:Name="UnhideAllGamesButton"
									Classes="settings scope-filter"
									Width="216"
									HorizontalAlignment="Left"
									Click="UnhideAllGamesButton_Click">
								<TextBlock Text="All Apps"/>
							</Button>

							<Button x:Name="HideNonInstalledButton"
									Classes="settings scope-filter"
									Width="216"
									HorizontalAlignment="Left"
									Click="HideNonInstalledButton_Click">
								<TextBlock Text="Installed Only"/>
							</Button>

							<Button x:Name="ShowHiddenGamesButton"
									Classes="settings scope-filter"
									Width="216"
									HorizontalAlignment="Left"
									Click="ShowHiddenGamesButton_Click">
								<TextBlock Text="Hidden"/>
							</Button>

							<Border Height="1"
									Background="{DynamicResource ThemeBorder}"
									Margin="0,8,0,8"/>

							<Grid ColumnDefinitions="*,Auto" Margin="12,0,8,8">
								<TextBlock Grid.Column="0"
										   Text="TAG FILTERS"
										   FontSize="10"
										   FontWeight="Bold"
										   Foreground="{DynamicResource ThemeTextSecondary}"
										   LetterSpacing="1"
										   VerticalAlignment="Center"/>
								<Button Grid.Column="1"
										Classes="iconbutton tag-filter-add"
										Width="24"
										Height="24"
										ToolTip.Tip="Add tag filter"
										Click="AddDisplayFilter_Click">
									<TextBlock Text="+"
											   FontSize="16"
											   FontWeight="Bold"
											   HorizontalAlignment="Center"
											   VerticalAlignment="Center"
											   TextAlignment="Center"/>
								</Button>
							</Grid>

							<ItemsControl x:Name="TagDisplayFiltersItemsControl"
										  ItemsSource="{Binding TagDisplayFilters}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Button Classes="settings display-filter-row"
												Classes.selected="{Binding IsSelected}"
												Margin="0,0,0,4"
												HorizontalAlignment="Stretch"
												HorizontalContentAlignment="Stretch"
												Click="TagDisplayFilterButton_Click"
												Tag="{Binding Id}">
											<Grid ColumnDefinitions="*,Auto,Auto">
													<TextBlock Grid.Column="0"
															   Text="{Binding Name}"
															   TextTrimming="CharacterEllipsis"
															   VerticalAlignment="Center"/>
													<Border Grid.Column="1"
															Classes="display-filter-reorder"
															Width="28"
															Height="28"
															Margin="4,0,0,0"
															VerticalAlignment="Center"
															Tag="{Binding Id}"
															PointerPressed="TagDisplayFilterReorder_PointerPressed">
														<TextBlock Text="↕"
																   FontSize="14"
																   IsHitTestVisible="False"
																   HorizontalAlignment="Center"
																   VerticalAlignment="Center"/>
													</Border>
													<Button Grid.Column="2"
															Classes="options options-listview display-filter-overflow"
															Content="⋯"
															FontSize="18"
															Width="28"
															Height="28"
															Padding="0"
															Margin="2,0,0,0"
															VerticalAlignment="Center"
															Click="DisplayFilterOverflow_Click"
															Tag="{Binding Id}">
														<Button.ContextMenu>
															<ContextMenu>
																<MenuItem Header="Edit"
																		  Tag="{Binding Id}"
																		  Click="EditTagDisplayFilter_Click"/>
																<MenuItem Header="Move Up"
																		  Tag="{Binding Id}"
																		  Click="MoveTagDisplayFilterUp_Click"/>
																<MenuItem Header="Move Down"
																		  Tag="{Binding Id}"
																		  Click="MoveTagDisplayFilterDown_Click"/>
																<MenuItem Header="Delete"
																		  Tag="{Binding Id}"
																		  Click="DeleteTagDisplayFilter_Click"/>
															</ContextMenu>
														</Button.ContextMenu>
													</Button>
												</Grid>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<Button Classes="options"
									Content="Add Display Filter"
									HorizontalAlignment="Stretch"
									Margin="0,8,0,0"
									Click="AddDisplayFilter_Click"/>
						</StackPanel>
				</ScrollViewer>
				</Grid>

				<!-- Footer Links -->
				<StackPanel Grid.Row="3" Margin="12,0,12,8">
						<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="-12,0,-12,8"/>
					<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
						<Button x:Name="GitHubFooterButton"
								Classes="iconbutton"
								Width="44"
								Height="44"
								ToolTip.Tip="GitHub"
								Click="GithubButton_Click">
							<Image Width="32" Height="32"
								   Source="avares://QuiverLauncher/Assets/Github.png"/>
						</Button>
						<Button x:Name="DiscordFooterButton"
								Classes="iconbutton"
								Width="44"
								Height="44"
								ToolTip.Tip="Discord"
								Click="DiscordButton_Click">
							<Image Width="32" Height="32"
								   Source="avares://QuiverLauncher/Assets/Discord.png"/>
						</Button>
						<Button x:Name="KofiFooterButton"
								Classes="iconbutton"
								Width="44"
								Height="44"
								ToolTip.Tip="Ko-fi"
								Click="KofiButton_Click">
							<Image Width="32" Height="32"
								   Source="avares://QuiverLauncher/Assets/Kofi.png"/>
						</Button>
					</StackPanel>
				</StackPanel>
			</Grid>
		</Border>
		</SplitView.Pane>

		<!-- Main Content Area -->
		<Grid x:Name="MainGrid">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- Top Bar: drag layer is a sibling behind controls so BeginMoveDrag never captures chrome clicks -->
			<Grid Grid.Row="0" ZIndex="1">
				<Border Background="{DynamicResource ThemeDarker}"
						BorderBrush="{DynamicResource ThemeBorder}"
						BorderThickness="0,0,0,1"
						PointerPressed="TopBar_PointerPressed"/>
				<Border Classes="header-inner">
					<Grid RowDefinitions="Auto,Auto">
						<Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Top">
						<Button x:Name="MobileNavButton"
								Grid.Column="0"
								Classes="modern-icon mobile-header-icon"
								Width="28"
								Height="28"
								Margin="4,0,0,0"
								Padding="0"
								Background="Transparent"
								HorizontalContentAlignment="Stretch"
								VerticalContentAlignment="Stretch"
								VerticalAlignment="Center"
								IsVisible="{Binding IsMobile}"
								PlatformFeedback.FeedbackType="Auto"
								ToolTip.Tip="Menu"
								Click="MobileNavButton_Click">
							<Border Width="28" Height="28" CornerRadius="8" Background="#2a2a2a">
								<TextBlock Text="☰"
										   FontSize="14"
										   Foreground="White"
										   HorizontalAlignment="Center"
										   VerticalAlignment="Center"/>
							</Border>
						</Button>
						<Grid x:Name="HeaderTitleColumn"
							  Grid.Column="1"
							  ColumnDefinitions="Auto,*"
							  MinHeight="44"
							  VerticalAlignment="Center">
						<TextBlock x:Name="HeaderTitleText"
								   Text="Library"
								   FontSize="24"
								   Margin="12,0,8,0"
								   FontWeight="Bold"
								   Foreground="{DynamicResource ThemeText}"
								   VerticalAlignment="Center"
								   HorizontalAlignment="Left"
								   TextWrapping="NoWrap"
								   TextTrimming="CharacterEllipsis"
								   IsHitTestVisible="False"/>
						<TextBlock x:Name="CatalogReviewCompactSummary"
								   Grid.Column="1"
								   FontSize="13"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource ThemeTextSecondary}"
								   VerticalAlignment="Center"
								   HorizontalAlignment="Left"
								   Margin="4,0,8,0"
								   MaxLines="1"
								   TextWrapping="NoWrap"
								   TextTrimming="CharacterEllipsis"
								   IsVisible="False"/>
						</Grid>
						<StackPanel Grid.Column="2"
									Orientation="Horizontal"
									HorizontalAlignment="Right"
									VerticalAlignment="Center">
							<StackPanel x:Name="MobileHeaderActions"
										Orientation="Horizontal"
										VerticalAlignment="Center"
										IsVisible="{Binding IsMobile}">
								<Button x:Name="MobileSearchToggleButton"
										Classes="modern-icon mobile-header-icon"
										Width="28"
										Height="28"
										Margin="8,0,0,0"
										Padding="0"
										Background="Transparent"
										HorizontalContentAlignment="Stretch"
										VerticalContentAlignment="Stretch"
										IsVisible="False"
										PlatformFeedback.FeedbackType="Auto"
										ToolTip.Tip="Search"
										Click="MobileSearchToggleButton_Click">
									<Border Width="28" Height="28" CornerRadius="8" Background="#2a2a2a">
										<Viewbox Width="14" Height="14"
												 HorizontalAlignment="Center" VerticalAlignment="Center">
											<Canvas Width="24" Height="24">
												<Ellipse Width="16" Height="16"
														 Canvas.Left="1" Canvas.Top="1"
														 Stroke="White" StrokeThickness="2.2"
														 Fill="Transparent"/>
												<Line StartPoint="14,14" EndPoint="22.5,22.5"
													  Stroke="White" StrokeThickness="2.6"
													  StrokeLineCap="Round"/>
											</Canvas>
										</Viewbox>
									</Border>
								</Button>
								<Button x:Name="MobileAddButton"
										Classes="modern-icon mobile-header-icon"
										Width="28"
										Height="28"
										Margin="8,0,0,0"
										Padding="0"
										Background="Transparent"
										HorizontalContentAlignment="Stretch"
										VerticalContentAlignment="Stretch"
										IsVisible="False"
										PlatformFeedback.FeedbackType="Auto"
										ToolTip.Tip="Add New Entry"
										Click="AddNewEntryButton_Click">
									<Border Width="28" Height="28" CornerRadius="8" Background="#2a2a2a">
										<TextBlock Text="+"
												   FontSize="18"
												   FontWeight="SemiBold"
												   Foreground="White"
												   HorizontalAlignment="Center"
												   VerticalAlignment="Center"/>
									</Border>
								</Button>
								<Button x:Name="MobileSortButton"
										Classes="modern-icon mobile-header-icon"
										Width="28"
										Height="28"
										Margin="8,0,0,0"
										Padding="0"
										Background="Transparent"
										HorizontalContentAlignment="Stretch"
										VerticalContentAlignment="Stretch"
										IsVisible="False"
										PlatformFeedback.FeedbackType="Auto"
										ToolTip.Tip="Sort">
									<Button.Flyout>
										<MenuFlyout Placement="BottomEdgeAlignedRight"
													Opening="MobileLibrarySortFlyout_Opening">
											<MenuItem Header="Name (A-Z)" Tag="Name" Click="MobileLibrarySortItem_Click"/>
											<MenuItem Header="Name (Z-A)" Tag="NameDesc" Click="MobileLibrarySortItem_Click"/>
											<MenuItem Header="Installed First" Tag="Installed" Click="MobileLibrarySortItem_Click"/>
											<MenuItem Header="Not Installed First" Tag="NotInstalled" Click="MobileLibrarySortItem_Click"/>
											<MenuItem Header="Last Played" Tag="LastPlayed" Click="MobileLibrarySortItem_Click"/>
										</MenuFlyout>
									</Button.Flyout>
									<Border Width="28" Height="28" CornerRadius="8" Background="#2a2a2a">
										<TextBlock Text="↕"
												   FontSize="16"
												   Foreground="White"
												   HorizontalAlignment="Center"
												   VerticalAlignment="Center"/>
									</Border>
								</Button>
								<Button x:Name="MobileCatalogBackButton"
										Classes="modern-icon mobile-header-icon"
										Width="28"
										Height="28"
										Margin="8,0,0,0"
										Padding="0"
										Background="Transparent"
										HorizontalContentAlignment="Stretch"
										VerticalContentAlignment="Stretch"
										IsVisible="False"
										PlatformFeedback.FeedbackType="Auto"
										ToolTip.Tip="Back to sources"
										Click="CatalogReviewBack_Click">
									<Border Width="28" Height="28" CornerRadius="8" Background="#2a2a2a">
										<TextBlock Text="←"
												   FontSize="16"
												   Foreground="White"
												   HorizontalAlignment="Center"
												   VerticalAlignment="Center"/>
									</Border>
								</Button>
								<Button x:Name="MobileCatalogSortButton"
										Classes="modern-icon mobile-header-icon"
										Width="28"
										Height="28"
										Margin="8,0,0,0"
										Padding="0"
										Background="Transparent"
										HorizontalContentAlignment="Stretch"
										VerticalContentAlignment="Stretch"
										IsVisible="False"
										PlatformFeedback.FeedbackType="Auto"
										ToolTip.Tip="Sort">
									<Button.Flyout>
										<MenuFlyout Placement="BottomEdgeAlignedRight"
													Opening="MobileCatalogSortFlyout_Opening">
											<MenuItem Header="Name (A-Z)" Tag="Name" Click="MobileCatalogSortItem_Click"/>
											<MenuItem Header="Name (Z-A)" Tag="NameDesc" Click="MobileCatalogSortItem_Click"/>
											<MenuItem Header="Repository (A-Z)" Tag="Repository" Click="MobileCatalogSortItem_Click"/>
											<MenuItem Header="Status" Tag="Status" Click="MobileCatalogSortItem_Click"/>
											<MenuItem Header="List" Tag="view:list" Click="MobileCatalogViewItem_Click"/>
											<MenuItem Header="Grid" Tag="view:grid" Click="MobileCatalogViewItem_Click"/>
											<MenuItem Header="All platforms" Tag="platform:All" Click="CatalogReviewPlatformItem_Click"/>
											<MenuItem Header="Windows" Tag="platform:Windows" Click="CatalogReviewPlatformItem_Click"/>
											<MenuItem Header="Linux" Tag="platform:Linux" Click="CatalogReviewPlatformItem_Click"/>
											<MenuItem Header="Mac" Tag="platform:Mac" Click="CatalogReviewPlatformItem_Click"/>
											<MenuItem Header="Android" Tag="platform:Android" Click="CatalogReviewPlatformItem_Click"/>
										</MenuFlyout>
									</Button.Flyout>
									<Border Width="28" Height="28" CornerRadius="8" Background="#2a2a2a">
										<TextBlock Text="↕"
												   FontSize="16"
												   Foreground="White"
												   HorizontalAlignment="Center"
												   VerticalAlignment="Center"/>
									</Border>
								</Button>
							</StackPanel>
							<StackPanel x:Name="DesktopInlineTopBar"
										Orientation="Horizontal"
										IsVisible="{Binding IsDesktopPlatform}">
							<WrapPanel x:Name="LibraryTopBarPanel" Orientation="Horizontal">
							<Grid x:Name="LibrarySearchHost" Width="220" Margin="0,0,16,0" VerticalAlignment="Center">
							<TextBox x:Name="LibrarySearchTextBox"
									 Watermark="Search this list"
									 MinHeight="32"
									 FontSize="12"
									 Padding="8,0,28,0"
									 VerticalAlignment="Center"
									 VerticalContentAlignment="Center"
									 TextChanged="LibrarySearch_TextChanged"
									 LostFocus="LibrarySearchTextBox_LostFocus"/>
							<Button x:Name="LibrarySearchClearButton"
									Classes="options"
									Content="×"
									FontSize="14"
									Padding="6,0"
									MinHeight="24"
									MinWidth="24"
									HorizontalAlignment="Right"
									VerticalAlignment="Center"
									Margin="0,0,4,0"
									IsVisible="False"
									ToolTip.Tip="Clear search"
									Click="LibrarySearchClear_Click"/>
							</Grid>
							<Button x:Name="AddNewEntryButton"
									Classes="options"
									Content="+ Add"
									ToolTip.Tip="Add New Entry"
									FontSize="14"
									FontWeight="Normal"
									Foreground="{DynamicResource ThemeText}"
									Padding="12,8"
									MinHeight="32"
									VerticalAlignment="Center"
									Margin="0,0,16,0"
									Click="AddNewEntryButton_Click"/>

							<ComboBox x:Name="SortByComboBox"
									  Foreground="{DynamicResource ThemeText}"
									  Background="{DynamicResource ThemeDarker}"
									  BorderBrush="{DynamicResource ThemeBorder}"
									  MinHeight="32"
									  VerticalAlignment="Center"
									  Margin="0,0,64,0"
									  SelectionChanged="SortByComboBox_SelectionChanged">
								<ComboBoxItem Content="Name (A-Z)" Tag="Name"/>
								<ComboBoxItem Content="Name (Z-A)" Tag="NameDesc"/>
								<ComboBoxItem Content="Installed First" Tag="Installed"/>
								<ComboBoxItem Content="Not Installed First" Tag="NotInstalled"/>
								<ComboBoxItem Content="Last Played" Tag="LastPlayed"/>
							</ComboBox>
							</WrapPanel>

							<WrapPanel x:Name="CatalogReviewTopBarPanel"
										Orientation="Horizontal"
										IsVisible="False"/>

							<Button x:Name="CatalogReviewBackButton"
									Classes="options"
									Content="← Back to sources"
									FontSize="13"
									Margin="0,0,16,0"
									IsVisible="False"
									Click="CatalogReviewBack_Click"/>
							</StackPanel>

							<!-- Version text -->
							<TextBlock Text="{Binding currentVersionString}"
								   VerticalAlignment="Center"
								   HorizontalAlignment="Right"
								   Foreground="{DynamicResource ThemeText}"
								   FontSize="14"
								   IsHitTestVisible="False"
								   IsVisible="{Binding IsDesktopPlatform}"/>

							<Button x:Name="CheckForUpdatesButton"
									Classes="modern-icon"
									Width="32"
									Height="32"
									ClipToBounds="False"
									Margin="12,0,0,0"
									ToolTip.Tip="{Binding CheckForUpdatesToolTip}"
									IsEnabled="{Binding !IsCheckingUpdates}"
									Click="CheckforUpdates_Click">
								<Grid Width="32" Height="32" ClipToBounds="False">
									<Image Width="28"
										   Height="28"
										   HorizontalAlignment="Center"
										   VerticalAlignment="Center"
										   Source="avares://QuiverLauncher/Assets/CheckForUpdates.png"
										   Opacity="{Binding CheckForUpdatesIconOpacity}"/>
									<Border Width="28"
											Height="2"
											HorizontalAlignment="Center"
											VerticalAlignment="Bottom"
											ClipToBounds="True"
											CornerRadius="1"
											IsVisible="{Binding IsCheckingUpdates}">
										<ProgressBar Height="2"
													 HorizontalAlignment="Stretch"
													 VerticalAlignment="Stretch"
													 BorderThickness="0"
													 Background="Transparent"
													 IsIndeterminate="True"/>
									</Border>
									<Border Background="#FF9500"
											CornerRadius="8"
											MinWidth="16"
											MinHeight="18"
											Padding="5,2"
											HorizontalAlignment="Right"
											VerticalAlignment="Top"
											Margin="0,-2,-2,0"
											IsVisible="{Binding UpdatesBadgeVisible}">
										<TextBlock Text="{Binding UpdatesBadgeText}"
												   FontSize="9"
												   FontWeight="Bold"
												   Foreground="White"
												   HorizontalAlignment="Center"
												   VerticalAlignment="Center"/>
									</Border>
									<Border Background="{DynamicResource ThemeSuccess}"
											CornerRadius="8"
											Width="16"
											Height="16"
											HorizontalAlignment="Right"
											VerticalAlignment="Top"
											Margin="0,-2,-2,0"
											IsVisible="{Binding UpdatesUpToDateBadgeVisible}">
										<TextBlock Text="✓"
												   FontSize="10"
												   FontWeight="Bold"
												   Foreground="White"
												   HorizontalAlignment="Center"
												   VerticalAlignment="Center"/>
									</Border>
								</Grid>
							</Button>

							<Button x:Name="SettingsButton"
									Classes="modern-icon"
									Width="28"
									Height="28"
									Margin="8,0,0,0"
									ToolTip.Tip="Settings"
									Click="SettingsButton_Click">
								<Image Width="28" Height="28"
									   Source="avares://QuiverLauncher/Assets/Settings.png"/>
							</Button>

							<!-- Minimize Button -->
							<Button x:Name="MinimizeButton"
									Classes="modern-icon"
									Width="28"
									Margin="12,0,0,0"
									ClickMode="Press"
									IsVisible="{Binding ShowMinimizeButton}"
									Click="MinimizeButton_Click">
								<Image Width="28"
									   Height="28"
									   Source="avares://QuiverLauncher/Assets/Icons/button_minimize.png"/>
							</Button>

							<!-- Maximize Button -->
							<Button x:Name="ToggleMaximizeButton"
									Classes="modern-icon"
									Width="28"
									Margin="8,0,0,0"
									ClickMode="Press"
									IsVisible="{Binding IsDesktopPlatform}"
									ToolTip.Tip="{Binding MaximizeButtonTip}"
									Click="ToggleMaximize_Click">
								<Image Width="28"
									   Height="28"
									   Source="avares://QuiverLauncher/Assets/Icons/button_fullscreen.png"/>
							</Button>

							<!-- Close Button -->
							<Button x:Name="CloseLauncherButton"
									Classes="modern-icon"
									Width="28"
									Margin="8,0,10,0"
									ClickMode="Press"
									IsVisible="{Binding IsDesktopPlatform}"
									Click="CloseLauncher_Click">
								<Image Width="28"
									   Height="28"
									   Source="avares://QuiverLauncher/Assets/Icons/button_close.png"/>
							</Button>
						</StackPanel>
						</Grid>
						<Grid x:Name="MobileSecondaryTopBar"
							  Grid.Row="1"
							  Margin="8,8,8,0"
							  IsVisible="False">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>
							<Grid x:Name="MobileSearchSlot" Grid.Row="0"/>
							<DockPanel x:Name="MobileLibraryActionsSlot"
									   Grid.Row="1"
									   LastChildFill="True"
									   Margin="0,8,0,0"/>
							<DockPanel x:Name="MobileCatalogActionsSlot"
									   Grid.Row="1"
									   LastChildFill="True"
									   Margin="0,8,0,0"
									   IsVisible="False"/>
						</Grid>
					</Grid>
				</Border>
			</Grid>
			<!-- Remote announcement banner (sky blue — not focus orange / success green) -->
			<Border x:Name="AnnouncementBanner"
					Grid.Row="1"
					Classes="announcement-banner"
					IsVisible="False"
					ZIndex="1">
				<Grid ColumnDefinitions="*,Auto" Margin="12,8">
					<TextBlock x:Name="AnnouncementBannerText"
							   Grid.Column="0"
							   TextWrapping="Wrap"
							   VerticalAlignment="Center"
							   FontSize="13"
							   FontWeight="SemiBold"
							   Margin="0,0,12,0"/>
					<Button x:Name="AnnouncementBannerCloseButton"
							Grid.Column="1"
							Classes="announcement-banner-close"
							Content="✕"
							Width="32"
							Height="28"
							FontSize="14"
							FontWeight="Bold"
							VerticalAlignment="Center"
							ToolTip.Tip="Dismiss"
							Click="AnnouncementBannerClose_Click"/>
				</Grid>
			</Border>

			<!-- Apps Content with Settings Panel Overlay -->
			<Grid Grid.Row="2">
				<Control x:Name="CardGamepadFocusSink"
						 Width="1"
						 Height="1"
						 HorizontalAlignment="Left"
						 VerticalAlignment="Top"
						 Opacity="0"
						 IsHitTestVisible="False"
						 Focusable="True"
						 FocusAdorner="{x:Null}"
						 KeyboardNavigation.IsTabStop="False"
						 XYFocus.NavigationModes="Disabled"/>

				<!-- Background Image -->
				<Border Background="{DynamicResource ThemeDarker}"/>
				<Image x:Name="StaticBackgroundImage"
					Source="{Binding BackgroundImageUri}"
					Stretch="Fill"
					Opacity="{Binding BackgroundOpacity}"/>

				<!-- Main App List -->
				<Grid x:Name="LibraryViewContainer">
					<ScrollViewer x:Name="LibraryContentPanel" VerticalScrollBarVisibility="Auto" Margin="30,20,6,30">
						<Grid x:Name="LibraryItemsHost" Margin="0,0,30,0">
							<ItemsControl ItemsSource="{Binding Games}" x:Name="ListViewControl"
										  IsVisible="{Binding ElementName=UseGridViewCheckBox, Path=!IsChecked}">
								<ItemsControl.ItemTemplate>
									<StaticResource ResourceKey="ListViewTemplate"/>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<ItemsControl ItemsSource="{Binding Games}" x:Name="ClassicGridViewControl"
										  IsVisible="False">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal" />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<StaticResource ResourceKey="GridViewTemplate"/>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<ItemsControl ItemsSource="{Binding Games}" x:Name="CompactGridViewControl"
										  IsVisible="False">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal" />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<StaticResource ResourceKey="CompactGridViewTemplate"/>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Grid>
					</ScrollViewer>

					<StackPanel x:Name="EmptyLibraryPanel"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Spacing="16"
								MaxWidth="520"
								Margin="30,20,30,30"
								IsVisible="False">
						<TextBlock Text="Your library is empty"
								   FontSize="24"
								   FontWeight="Bold"
								   Foreground="{DynamicResource ThemeText}"
								   HorizontalAlignment="Center"
								   TextAlignment="Center"/>
						<TextBlock Text="Get started by adding an app yourself, or browse the Quiver Community App Catalog to add apps from the community."
								   FontSize="14"
								   Foreground="{DynamicResource ThemeTextSecondary}"
								   TextWrapping="Wrap"
								   TextAlignment="Center"/>
						<StackPanel Orientation="Horizontal"
									Spacing="12"
									HorizontalAlignment="Center"
									Margin="0,8,0,0">
							<Button Classes="options"
									Content="Add App Manually"
									FontSize="13"
									Click="EmptyLibraryAddApp_Click"/>
							<Button Classes="options"
									Content="Browse Community Catalog"
									FontSize="13"
									Click="EmptyLibraryBrowseCatalog_Click"/>
						</StackPanel>
					</StackPanel>

					<StackPanel x:Name="LibrarySearchNoMatchesPanel"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Spacing="16"
								MaxWidth="520"
								Margin="30,20,30,30"
								IsVisible="False">
						<TextBlock Text="No apps match this search"
								   FontSize="24"
								   FontWeight="Bold"
								   Foreground="{DynamicResource ThemeText}"
								   HorizontalAlignment="Center"
								   TextAlignment="Center"/>
						<TextBlock Text="Try a different search, or clear it to show your library again."
								   FontSize="14"
								   Foreground="{DynamicResource ThemeTextSecondary}"
								   TextWrapping="Wrap"
								   TextAlignment="Center"/>
						<Button Classes="options"
								Content="Clear search"
								FontSize="13"
								HorizontalAlignment="Center"
								Click="LibrarySearchClear_Click"/>
					</StackPanel>

					<!-- App updates review (in-window, replaces modal) -->
					<Grid x:Name="AppUpdatesReviewPanel"
						  IsVisible="False"
						  Margin="30,20,6,30"
						  RowDefinitions="Auto,Auto,*">
						<TextBlock x:Name="AppUpdatesReviewHeaderText"
								   Grid.Row="0"
								   FontSize="15"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource ThemeText}"
								   TextWrapping="Wrap"
								   Margin="0,0,30,12"/>
						<StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,30,12">
							<Button x:Name="AppUpdatesUpdateAllButton"
									Classes="options"
									Content="Update All"
									FontSize="11"
									Click="AppUpdatesUpdateAll_Click"/>
							<Button x:Name="AppUpdatesSkipAllButton"
									Classes="options"
									Content="Skip all"
									FontSize="11"
									Click="AppUpdatesSkipAll_Click"/>
							<Button x:Name="AppUpdatesBackToLibraryButton"
									Classes="options"
									Content="Back to Library"
									FontSize="11"
									Click="AppUpdatesBackToLibrary_Click"/>
						</StackPanel>
						<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
							<StackPanel Margin="0,0,30,0">
								<TextBlock x:Name="AppUpdatesReviewEmptyText"
										   Text="No app updates pending."
										   FontSize="12"
										   Foreground="{DynamicResource ThemeTextSecondary}"
										   IsVisible="False"
										   Margin="0,8,0,0"/>
								<ItemsControl x:Name="AppUpdatesReviewItemsControl"
											  ItemsSource="{Binding AppUpdateReviewRows}">
									<ItemsControl.ItemTemplate>
										<StaticResource ResourceKey="AppUpdateReviewCardTemplate"/>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</ScrollViewer>
					</Grid>

					<!-- Mods browser (in-window overlay on Library) -->
					<Grid x:Name="ModsPanel"
						  XYFocus.NavigationModes="Gamepad,Remote"
						  XYFocus.UpNavigationStrategy="Projection"
						  XYFocus.DownNavigationStrategy="Projection"
						  XYFocus.LeftNavigationStrategy="Projection"
						  XYFocus.RightNavigationStrategy="Projection"
						  IsVisible="False"
						  Margin="30,20,6,30"
						  RowDefinitions="Auto,Auto,Auto,Auto,*">
						<TextBlock x:Name="ModsHeaderText"
								   Grid.Row="0"
								   FontSize="15"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource ThemeText}"
								   TextWrapping="Wrap"
								   Margin="0,0,30,8"/>
						<StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,30,8">
							<Button x:Name="ModsRefreshButton"
									Classes="options"
									Content="Refresh"
									FontSize="11"
									Click="ModsRefresh_Click"/>
							<Button x:Name="ModsUpdateAllButton"
									Classes="options"
									Content="Update All"
									FontSize="11"
									Click="ModsUpdateAll_Click"/>
							<Button x:Name="ModsOpenFolderButton"
									Classes="options"
									Content="Open Mod Folder"
									FontSize="11"
									Click="ModsOpenFolder_Click"/>
							<Button x:Name="ModsCloseButton"
									Classes="options"
									Content="Back to Library"
									FontSize="11"
									Click="ModsClose_Click"/>
							<TextBlock x:Name="ModsStatusText"
									   VerticalAlignment="Center"
									   FontSize="11"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   Margin="8,0,0,0"/>
						</StackPanel>
						<StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,30,8">
							<Button x:Name="ModsTabBrowseButton"
									Classes="catalog-filter selected"
									Content="Browse"
									Tag="Browse"
									FontSize="11"
									Click="ModsTabFilter_Click"/>
							<Button x:Name="ModsTabInstalledButton"
									Classes="catalog-filter"
									Content="Installed"
									Tag="Installed"
									FontSize="11"
									Click="ModsTabFilter_Click"/>
							<TextBox x:Name="ModsSearchTextBox"
									 Watermark="Search mods"
									 Width="220"
									 FontSize="12"
									 Margin="12,0,0,0"
									 TextChanged="ModsSearch_TextChanged"/>
							<TextBlock Text="Sort:"
									   FontSize="11"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   VerticalAlignment="Center"
									   Margin="12,0,0,0"/>
							<ComboBox x:Name="ModsSortByComboBox"
									  FontSize="12"
									  MinWidth="150"
									  Foreground="{DynamicResource ThemeTextSecondary}"
									  Background="{DynamicResource ThemeDarker}"
									  BorderBrush="{DynamicResource ThemeBorder}"
									  SelectionChanged="ModsSortByComboBox_SelectionChanged">
								<ComboBoxItem Content="Installed first" Tag="InstalledFirst"/>
								<ComboBoxItem Content="Name (A-Z)" Tag="Name"/>
								<ComboBoxItem Content="Name (Z-A)" Tag="NameDesc"/>
								<ComboBoxItem Content="Updates first" Tag="UpdatesFirst"/>
								<ComboBoxItem Content="Top rated" Tag="TopRated"/>
								<ComboBoxItem Content="Newest" Tag="Newest"/>
								<ComboBoxItem Content="Last updated" Tag="LastUpdated"/>
								<ComboBoxItem Content="Most downloaded" Tag="MostDownloaded"/>
							</ComboBox>
						</StackPanel>
						<WrapPanel x:Name="ModsSourceFilterPanel"
								   Grid.Row="3"
								   Orientation="Horizontal"
								   Margin="0,0,30,8"/>
						<ScrollViewer x:Name="ModsListScrollViewer"
									  Grid.Row="4"
									  VerticalScrollBarVisibility="Auto"
									  ScrollChanged="ModsListScrollViewer_ScrollChanged">
							<StackPanel Margin="0,0,30,0">
								<StackPanel x:Name="ModsListLoadingPanel"
											IsVisible="False"
											Margin="0,8,0,0"
											Spacing="8">
									<ProgressBar Width="120"
												 Height="4"
												 HorizontalAlignment="Left"
												 Minimum="0"
												 Maximum="100"
												 BorderThickness="0"
												 Background="Transparent"
												 IsIndeterminate="True"/>
									<TextBlock x:Name="ModsListLoadingText"
											   Text="Loading mods…"
											   FontSize="12"
											   Foreground="{DynamicResource ThemeTextSecondary}"/>
								</StackPanel>
								<TextBlock x:Name="ModsEmptyText"
										   Text="No mods found."
										   FontSize="12"
										   Foreground="{DynamicResource ThemeTextSecondary}"
										   IsVisible="False"
										   Margin="0,8,0,0"/>
								<ItemsControl x:Name="ModsItemsControl"
											  ItemsSource="{Binding ModListRows}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel Orientation="Horizontal"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<StaticResource ResourceKey="ModListCardTemplate"/>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</ScrollViewer>
					</Grid>
				</Grid>

				<!-- App Catalog Content -->
				<Grid x:Name="CatalogContentPanel" IsVisible="False" Margin="30,20,6,30">
					<!-- Sources list -->
					<ScrollViewer x:Name="CatalogSourcesPanel" VerticalScrollBarVisibility="Auto">
							<StackPanel x:Name="CatalogSourcesStack" Spacing="12" Margin="0,0,30,0">
							<TextBlock Text="External catalog sources reference remote app lists. Your local apps.json is your library."
									   FontSize="12"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   TextWrapping="Wrap"/>
							<WrapPanel Orientation="Horizontal">
								<Button x:Name="AddCatalogSourceButton" Classes="options" Content="Add Source" Click="AddCatalogSource_Click" FontSize="12" Margin="0,0,8,8"/>
								<Button x:Name="RefreshCatalogSourcesButton" Classes="options" Content="Refresh All Sources" Click="RefreshCatalogSources_Click" FontSize="12" Margin="0,0,8,8"/>
							</WrapPanel>
							<WrapPanel Orientation="Horizontal">
								<Button x:Name="CatalogSourceFilterAllButton" Classes="catalog-filter" Content="All"
										Tag="All" Click="CatalogSourceListFilter_Click" Margin="0,0,6,6"/>
								<Button x:Name="CatalogSourceFilterEnabledButton" Classes="catalog-filter selected" Content="Enabled"
										Tag="Enabled" Click="CatalogSourceListFilter_Click" Margin="0,0,6,6"/>
								<Button x:Name="CatalogSourceFilterDisabledButton" Classes="catalog-filter" Content="Disabled"
										Tag="Disabled" Click="CatalogSourceListFilter_Click" Margin="0,0,6,6"/>
							</WrapPanel>
							<ItemsControl x:Name="CatalogSourcesItemsControl" ItemsSource="{Binding CatalogSources}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<StaticResource ResourceKey="CatalogSourceCardTemplate"/>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<TextBlock x:Name="CatalogSourcesEmptyText"
									   Text="No catalog sources yet. Add a source to subscribe to an external app list."
									   FontSize="12"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   TextWrapping="Wrap"
									   IsVisible="False"/>
						</StackPanel>
					</ScrollViewer>

					<!-- Source review -->
					<Grid x:Name="CatalogReviewPanel"
						  XYFocus.NavigationModes="Gamepad,Remote"
						  XYFocus.UpNavigationStrategy="Projection"
						  XYFocus.DownNavigationStrategy="Projection"
						  XYFocus.LeftNavigationStrategy="Projection"
						  XYFocus.RightNavigationStrategy="Projection"
						  IsVisible="False" RowDefinitions="Auto,*">
						<StackPanel Grid.Row="0" Spacing="8">
						<Grid ColumnDefinitions="*,Auto" MinHeight="40">
							<DockPanel LastChildFill="True">
								<Button x:Name="CatalogReviewTagsToggle"
										DockPanel.Dock="Right"
										Classes="catalog-filter"
										Content="Tags"
										Click="CatalogReviewFiltersToggle_Click"
										FontSize="11"
										MinHeight="32"
										Padding="10,0"
										VerticalAlignment="Top"
										Margin="8,0,0,0"
										ToolTip.Tip="Filter by tag: off → include → exclude"/>
								<TextBox x:Name="CatalogSearchTextBox"
										 DockPanel.Dock="Right"
										 Watermark="Search this list"
										 Width="200"
										 MinHeight="32"
										 FontSize="12"
										 VerticalAlignment="Top"
										 VerticalContentAlignment="Center"
										 Margin="12,0,0,0"
										 TextChanged="CatalogSearch_TextChanged"/>
								<ScrollViewer x:Name="CatalogReviewStatusScroller"
											  VerticalAlignment="Top"
											  VerticalScrollBarVisibility="Disabled"
											  HorizontalScrollBarVisibility="Auto">
									<StackPanel x:Name="CatalogReviewStatusChips" Orientation="Horizontal">
										<Button x:Name="CatalogFilterAllButton" Classes="catalog-filter selected" Content="All"
												Tag="All" Click="CatalogReviewFilter_Click" MinHeight="32" Margin="0,0,6,0"
												VerticalAlignment="Center"
												ToolTip.Tip="Every app in this list"/>
										<Button x:Name="CatalogFilterNeedsReviewButton" Classes="catalog-filter" Content="Needs review"
												Tag="NeedsReview" Click="CatalogReviewFilter_Click" MinHeight="32" Margin="0,0,6,0"
												VerticalAlignment="Center"
												ToolTip.Tip="New and changed apps that still need action"/>
										<Button x:Name="CatalogFilterNotInLibraryButton" Classes="catalog-filter" Content="Not in library"
												Tag="NotInLibrary" Click="CatalogReviewFilter_Click" MinHeight="32" Margin="0,0,6,0"
												VerticalAlignment="Center"
												ToolTip.Tip="Catalog entries you have not added, including ignored"/>
										<Button x:Name="CatalogFilterChangedButton" Classes="catalog-filter" Content="Changed"
												Tag="Changed" Click="CatalogReviewFilter_Click" MinHeight="32" Margin="0,0,6,0"
												VerticalAlignment="Center"
												ToolTip.Tip="In your library, but catalog name, tags, or other fields differ"/>
										<Button x:Name="CatalogFilterUpToDateButton" Classes="catalog-filter" Content="Up to date"
												Tag="UpToDate" Click="CatalogReviewFilter_Click" MinHeight="32" Margin="0,0,6,0"
												VerticalAlignment="Center"
												ToolTip.Tip="In your library and matching this list"/>
										<Button x:Name="CatalogFilterHiddenButton" Classes="catalog-filter" Content="Hidden"
												Tag="Hidden" Click="CatalogReviewFilter_Click" MinHeight="32" Margin="0,0,6,0"
												VerticalAlignment="Center"
												ToolTip.Tip="Hidden from review until you unhide them"/>
									</StackPanel>
								</ScrollViewer>
							</DockPanel>
							<StackPanel x:Name="CatalogReviewDesktopToolsRow"
										Grid.Column="1"
										Orientation="Horizontal"
										VerticalAlignment="Top"
										Margin="12,0,0,0">
								<Button x:Name="CatalogReviewPlatformButton"
										Classes="catalog-filter"
										Content="All platforms"
										FontSize="11"
										MinHeight="32"
										VerticalAlignment="Center"
										Margin="0,0,8,0"
										ToolTip.Tip="Filter apps by platforms in the latest release">
									<Button.Flyout>
										<MenuFlyout Placement="BottomEdgeAlignedRight"
													Opening="CatalogReviewPlatformFlyout_Opening">
											<MenuItem Header="All platforms" Tag="All" Click="CatalogReviewPlatformItem_Click"/>
											<MenuItem Header="Windows" Tag="Windows" Click="CatalogReviewPlatformItem_Click"/>
											<MenuItem Header="Linux" Tag="Linux" Click="CatalogReviewPlatformItem_Click"/>
											<MenuItem Header="Mac" Tag="Mac" Click="CatalogReviewPlatformItem_Click"/>
											<MenuItem Header="Android" Tag="Android" Click="CatalogReviewPlatformItem_Click"/>
										</MenuFlyout>
									</Button.Flyout>
								</Button>
								<ComboBox x:Name="CatalogReviewSortByComboBox"
										  Foreground="{DynamicResource ThemeText}"
										  Background="{DynamicResource ThemeDarker}"
										  BorderBrush="{DynamicResource ThemeBorder}"
										  MinHeight="32"
										  VerticalAlignment="Center"
										  VerticalContentAlignment="Center"
										  Margin="0,0,8,0"
										  SelectionChanged="CatalogReviewSortByComboBox_SelectionChanged">
									<ComboBoxItem Content="Name (A-Z)" Tag="Name"/>
									<ComboBoxItem Content="Name (Z-A)" Tag="NameDesc"/>
									<ComboBoxItem Content="Repository (A-Z)" Tag="Repository"/>
									<ComboBoxItem Content="Status" Tag="Status"/>
								</ComboBox>
								<Button x:Name="CatalogReviewListViewButton"
										Classes="catalog-filter selected"
										Content="List"
										Tag="list"
										FontSize="11"
										MinHeight="32"
										VerticalAlignment="Center"
										Margin="0,0,6,0"
										Click="CatalogReviewLayout_Click"/>
								<Button x:Name="CatalogReviewGridViewButton"
										Classes="catalog-filter"
										Content="Grid"
										Tag="grid"
										FontSize="11"
										MinHeight="32"
										VerticalAlignment="Center"
										Click="CatalogReviewLayout_Click"/>
							</StackPanel>
						</Grid>
						<StackPanel x:Name="CatalogReviewFiltersExtra" Spacing="6" IsVisible="False">
							<ItemsControl x:Name="CatalogTagChipsItemsControl"
										  ItemsSource="{Binding CatalogTagChips}"
										  IsVisible="{Binding HasCatalogTagChips}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Button Classes="catalog-tag-chip"
												Content="{Binding StateLabel}"
												Tag="{Binding Tag}"
												Click="CatalogTagChip_Click"
												Margin="0,0,6,4"
												Classes.selected="{Binding IsInclude}"
												Classes.excluded="{Binding IsExclude}"
												ToolTip.Tip="Off → include → exclude"/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<TextBlock x:Name="CatalogReviewHelpStatusText"
									   IsVisible="False"
									   FontSize="10"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   Opacity="0.85"/>
							<TextBlock x:Name="CatalogReviewHelpTagColorsText"
									   IsVisible="False"
									   FontSize="10"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   Opacity="0.85"/>
						</StackPanel>
						<WrapPanel x:Name="CatalogReviewBulkPanel" Orientation="Horizontal" VerticalAlignment="Center">
							<Button x:Name="CatalogSyncAddAllButton" Classes="options catalog-review-add" Content="Add all new"
									Click="CatalogSyncAddAll_Click" FontSize="11" MinHeight="32" Margin="0,0,8,0" IsVisible="False"/>
							<Button x:Name="CatalogSyncReplaceAllButton" Classes="options catalog-review-merge" Content="Merge all changed"
									Click="CatalogSyncReplaceAll_Click" FontSize="11" MinHeight="32" Margin="0,0,8,0" IsVisible="False"/>
							<Button x:Name="CatalogSyncAcknowledgeButton" Classes="options" Content="Skip &amp; mark reviewed"
									Click="CatalogSyncAcknowledge_Click" FontSize="11" MinHeight="32" Margin="0,0,8,0" IsVisible="False"/>
						</WrapPanel>
						<Border x:Name="CatalogReviewVersionBanner"
								Classes="catalog-review-version-banner"
								IsVisible="False"
								Margin="0,0,0,0">
							<TextBlock x:Name="CatalogReviewVersionText"
									   FontSize="13"
									   Foreground="{DynamicResource ThemeText}"
									   TextWrapping="Wrap"/>
						</Border>
						<Grid x:Name="CatalogReviewMobileChromeRow"
							  ColumnDefinitions="*,Auto,Auto"
							  ColumnSpacing="8"
							  IsVisible="False">
							<Button x:Name="CatalogSyncAddAllCompactButton"
									Grid.Column="1"
									Classes="options catalog-review-add"
									Content="Add all"
									Click="CatalogSyncAddAll_Click"
									FontSize="11"
									Padding="8,4"/>
							<Button x:Name="CatalogReviewFiltersToggle"
									Grid.Column="2"
									Classes="catalog-filter"
									Content="Filters"
									Click="CatalogReviewFiltersToggle_Click"
									FontSize="11"
									Padding="10,4"/>
						</Grid>
								<StackPanel x:Name="CatalogSyncNeedsReviewEmptyPanel"
											Spacing="12"
											Margin="0,8,0,0"
											IsVisible="False">
									<TextBlock Text="You're all caught up — nothing needs review."
											   FontSize="12"
											   Foreground="{DynamicResource ThemeTextSecondary}"
											   TextWrapping="Wrap"/>
									<WrapPanel>
										<Button x:Name="CatalogSyncBackToLibraryButton"
												Classes="options"
												Content="Back to Library"
												FontSize="11"
												Margin="0,0,8,8"
												Click="CatalogSyncBackToLibrary_Click"/>
										<Button x:Name="CatalogSyncBackToSourcesButton"
												Classes="options"
												Content="Back to sources"
												FontSize="11"
												Margin="0,0,8,8"
												Click="CatalogSyncBackToSources_Click"/>
									</WrapPanel>
								</StackPanel>
								<TextBlock x:Name="CatalogSyncEmptyText"
										   Text="No apps match this filter."
										   FontSize="12"
										   Foreground="{DynamicResource ThemeTextSecondary}"
										   TextWrapping="Wrap"
										   IsVisible="False"
										   Margin="0,8,0,0"/>
						<Border x:Name="CatalogReviewListDivider"
								Height="1"
								Background="{DynamicResource ThemeBorder}"
								Opacity="0.7"
								Margin="0,8,0,8"
								IsHitTestVisible="False"/>
						</StackPanel>
						<Grid x:Name="CatalogReviewItemsHost" Grid.Row="1">
						<ListBox x:Name="CatalogSyncRowsItemsControl"
								 Classes="catalog-review-list"
								 ItemsSource="{Binding CatalogSyncRows}"
								 SelectionMode="Single"
								 SelectionChanged="CatalogReviewList_SelectionChanged">
							<ListBox.ItemContainerTheme>
								<ControlTheme TargetType="ListBoxItem">
									<Setter Property="Padding" Value="0"/>
									<Setter Property="Margin" Value="0"/>
									<Setter Property="HorizontalAlignment" Value="Stretch"/>
									<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
									<Setter Property="Background" Value="Transparent"/>
									<Setter Property="BorderBrush" Value="Transparent"/>
									<Setter Property="BorderThickness" Value="0"/>
									<Setter Property="Focusable" Value="False"/>
									<Setter Property="PlatformFeedback.FeedbackType" Value="None"/>
									<Setter Property="Template">
										<ControlTemplate TargetType="ListBoxItem">
											<ContentPresenter Name="PART_ContentPresenter"
															  Background="Transparent"
															  BorderBrush="Transparent"
															  BorderThickness="0"
															  Content="{TemplateBinding Content}"
															  ContentTemplate="{TemplateBinding ContentTemplate}"
															  Padding="{TemplateBinding Padding}"
															  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
															  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
										</ControlTemplate>
									</Setter>
									<Style Selector="^:pointerover">
										<Setter Property="Background" Value="Transparent"/>
										<Setter Property="BorderBrush" Value="Transparent"/>
										<Setter Property="BorderThickness" Value="0"/>
									</Style>
									<Style Selector="^:pressed">
										<Setter Property="Background" Value="Transparent"/>
										<Setter Property="BorderBrush" Value="Transparent"/>
										<Setter Property="BorderThickness" Value="0"/>
									</Style>
									<Style Selector="^:selected">
										<Setter Property="Background" Value="Transparent"/>
										<Setter Property="BorderBrush" Value="Transparent"/>
										<Setter Property="BorderThickness" Value="0"/>
									</Style>
									<Style Selector="^:focus">
										<Setter Property="Background" Value="Transparent"/>
										<Setter Property="BorderBrush" Value="Transparent"/>
										<Setter Property="BorderThickness" Value="0"/>
									</Style>
								</ControlTheme>
							</ListBox.ItemContainerTheme>
							<ListBox.ItemsPanel>
								<ItemsPanelTemplate>
									<VirtualizingStackPanel CacheLength="2"/>
								</ItemsPanelTemplate>
							</ListBox.ItemsPanel>
							<ListBox.ItemTemplate>
								<StaticResource ResourceKey="CatalogReviewCardTemplate"/>
							</ListBox.ItemTemplate>
						</ListBox>
						<ScrollViewer x:Name="CatalogReviewGridScrollViewer"
									  IsVisible="False"
									  VerticalScrollBarVisibility="Auto">
							<ItemsControl x:Name="CatalogReviewGridItemsControl"
										  ItemsSource="{Binding CatalogSyncRows}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<StaticResource ResourceKey="CatalogReviewGridCardTemplate"/>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
						</Grid>
					</Grid>
				</Grid>

				<TextBlock x:Name="GamepadHintsBar"
						   FontSize="11"
						   Foreground="{DynamicResource ThemeTextSecondary}"
						   HorizontalAlignment="Center"
						   VerticalAlignment="Bottom"
						   Margin="0,0,0,8"
						   IsVisible="{Binding GamepadHintsVisible}"/>

				<!-- Settings Panel Overlay -->
				<Border x:Name="SettingsPanel"
						XYFocus.NavigationModes="Gamepad,Remote"
						XYFocus.UpNavigationStrategy="Projection"
						XYFocus.DownNavigationStrategy="Projection"
						XYFocus.LeftNavigationStrategy="Projection"
						XYFocus.RightNavigationStrategy="Projection"
						HorizontalAlignment="Right"
						VerticalAlignment="Stretch"
						Width="400"
						Background="{DynamicResource ThemeDarker}"
						BorderBrush="{DynamicResource ThemeBorder}"
						BorderThickness="1,0,0,0"
						IsVisible="False"
						Opacity="0.97"
						ZIndex="10">
					<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
						<StackPanel x:Name="SettingsContent">

							<!-- Settings Header -->
							<Border Background="{DynamicResource ThemeBase}"
									Padding="20,14,20,14"
									BorderThickness="0,0,0,1"
									BorderBrush="{DynamicResource ThemeBorder}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0"
											   Text="Settings"
											   FontSize="20"
											   FontWeight="Bold"
											   Foreground="{DynamicResource ThemeText}"
											   VerticalAlignment="Center"/>
									<Button x:Name="CloseSettingsButton"
											Grid.Column="1"
											Classes="modern-icon"
											Width="28"
											Height="28"
											ToolTip.Tip="Close settings"
											Click="CloseSettingsPanel_Click">
										<Image Width="28"
											   Height="28"
											   Source="avares://QuiverLauncher/Assets/Icons/button_close.png"/>
									</Button>
								</Grid>
							</Border>

							<!-- Tab Control -->
							<TabControl x:Name="SettingsTabControl"
										Background="Transparent"
										Foreground="{DynamicResource ThemeText}"
										Padding="4,4,4,0"
										Margin="0">
								<TabControl.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel Orientation="Horizontal"/>
									</ItemsPanelTemplate>
								</TabControl.ItemsPanel>
								<TabControl.Styles>
									<Style Selector="TabItem">
										<Setter Property="Theme">
											<ControlTheme TargetType="TabItem">
												<Setter Property="Background" Value="Transparent"/>
												<Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
												<Setter Property="BorderBrush" Value="Transparent"/>
												<Setter Property="BorderThickness" Value="0"/>
												<Setter Property="CornerRadius" Value="6"/>
												<Setter Property="Padding" Value="8,4"/>
												<Setter Property="Margin" Value="1,8,1,0"/>
												<Setter Property="FontSize" Value="11"/>
												<Setter Property="FontWeight" Value="SemiBold"/>
												<Setter Property="MinHeight" Value="36"/>
												<Setter Property="Cursor" Value="Hand"/>
												<Setter Property="HorizontalContentAlignment" Value="Center"/>
												<Setter Property="VerticalContentAlignment" Value="Center"/>
												<Setter Property="Template">
													<ControlTemplate TargetType="TabItem">
														<Border Background="{TemplateBinding Background}"
																BorderBrush="{TemplateBinding BorderBrush}"
																BorderThickness="{TemplateBinding BorderThickness}"
																CornerRadius="{TemplateBinding CornerRadius}"
																Padding="{TemplateBinding Padding}">
															<ContentPresenter Content="{TemplateBinding Header}"
																			  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
																			  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
														</Border>
													</ControlTemplate>
												</Setter>
												<Style Selector="^:selected">
													<Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
													<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
												</Style>
												<Style Selector="^:pointerover">
													<Setter Property="Background" Value="{DynamicResource ThemeBase}"/>
													<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
												</Style>
												<Style Selector="^:selected:pointerover">
													<Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
													<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
												</Style>
												<Style Selector="^.gamepad-focused, ^:focus">
													<Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
													<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
													<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
													<Setter Property="BorderThickness" Value="2"/>
												</Style>
												<Style Selector="^:selected.gamepad-focused, ^:selected:focus">
													<Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
													<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
													<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
													<Setter Property="BorderThickness" Value="2"/>
												</Style>
											</ControlTheme>
										</Setter>
									</Style>
								</TabControl.Styles>

								<!-- General Tab -->
								<TabItem Header="General">
									<StackPanel Margin="16,12,16,16" Spacing="4">

										<!-- Behaviour -->
										<TextBlock Text="BEHAVIOUR"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="2">
											<CheckBox x:Name="CloseAfterLaunchCheckBox"
													  Content="Close After Launch"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsCheckedChanged="CloseAfterLaunchCheckBox_IsCheckedChanged"/>
											<TextBlock Text="Close the launcher automatically after starting an app"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0" IsVisible="{Binding IsDesktopPlatform}">
											<CheckBox x:Name="CloseToTrayCheckBox"
													  Content="Close to system tray"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsCheckedChanged="CloseToTrayCheckBox_IsCheckedChanged"/>
											<TextBlock Text="Keep Quiver Launcher running in the notification area when the window is closed"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0">
											<CheckBox x:Name="IgnoreArticlesWhenSortingCheckBox"
													  Content="Ignore The/A/An when sorting by name"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsCheckedChanged="IgnoreArticlesWhenSortingCheckBox_IsCheckedChanged"/>
											<TextBlock Text="Alphabetical sorts skip leading The, A, and An (e.g. The Legend of Zelda under L)"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<StackPanel Spacing="2" Margin="0,0,0,0">
											<CheckBox x:Name="AutoUpdateNewlyAddedAppsCheckBox"
													  Content="Enable Auto Update for newly added apps"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsCheckedChanged="AutoUpdateNewlyAddedAppsCheckBox_IsCheckedChanged"/>
											<TextBlock Text="New apps from the catalog or Add Entry start with Auto Update enabled"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0">
											<CheckBox x:Name="BackgroundUpdateCheckCheckBox"
													  Content="Check for app updates in the background"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsCheckedChanged="BackgroundUpdateCheckCheckBox_IsCheckedChanged"/>
											<TextBlock Text="Scan for updates on a schedule while Quiver Launcher is running (including in the tray)"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0">
											<TextBlock Text="Background check interval"
													   FontSize="13" FontWeight="SemiBold"
													   Foreground="{DynamicResource ThemeText}"/>
											<ComboBox x:Name="BackgroundUpdateIntervalComboBox"
													  HorizontalAlignment="Stretch"
													  Margin="0,4,0,0"
													  SelectionChanged="BackgroundUpdateIntervalComboBox_SelectionChanged">
												<ComboBoxItem Content="Every 15 minutes" Tag="15"/>
												<ComboBoxItem Content="Every 30 minutes" Tag="30"/>
												<ComboBoxItem Content="Every hour" Tag="60"/>
												<ComboBoxItem Content="Every 3 hours" Tag="180"/>
												<ComboBoxItem Content="Every 6 hours" Tag="360"/>
												<ComboBoxItem Content="Every 12 hours" Tag="720"/>
												<ComboBoxItem Content="Every day" Tag="1440"/>
											</ComboBox>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0">
											<CheckBox x:Name="PromptCatalogUpdatesCheckBox"
													  Content="Prompt when catalog updates are available"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsCheckedChanged="PromptCatalogUpdatesCheckBox_IsCheckedChanged"/>
											<TextBlock Text="Show a popup when catalog sources have changes to review (off by default; open App Catalog anytime)"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0">
											<CheckBox x:Name="PromptAppUpdateReviewsCheckBox"
													  Content="Prompt when library apps have updates"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsCheckedChanged="PromptAppUpdateReviewsCheckBox_IsCheckedChanged"/>
											<TextBlock Text="Show a popup for pending app updates (Quiver Launcher self-update prompts still appear)"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<StackPanel Spacing="4" IsVisible="{Binding IsDesktopPlatform}">
											<!-- Divider -->
											<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

											<!-- Install Path -->
											<TextBlock Text="APP INSTALL PATH"
													   FontSize="10" FontWeight="Bold"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   LetterSpacing="1"
													   Margin="0,0,0,4"/>

											<TextBlock Text="Leave blank to use the default location"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="0,0,0,4"/>

											<Panel HorizontalAlignment="Stretch">
												<TextBox x:Name="GamePathTextBox"
														 Foreground="{DynamicResource ThemeText}"
														 Background="{DynamicResource ThemeBase}"
														 BorderBrush="{DynamicResource ThemeBorder}"
														 BorderThickness="1"
														 Padding="12,10"
														 CornerRadius="4"
														 Margin="0,0,44,0"
														 TextChanged="GamePathTextBox_TextChanged"
														 Text="{Binding Settings.GamesPath, Mode=TwoWay}"/>
												<Button Classes="options"
														HorizontalAlignment="Right"
														Width="40"
														Height="40"
														Content="📁"
														Click="BrowseGamePath_Click"/>
											</Panel>

											<Button Classes="options"
													Content="Reset to Default"
													HorizontalAlignment="Stretch"
													Click="ClearGamePath_Click"
													FontSize="12"/>

											<!-- Divider -->
											<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>
										</StackPanel>

										<!-- Platform & Cache -->
										<TextBlock Text="PLATFORM &amp; CACHE"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<TextBlock Text="{Binding PlatformString}"
												   FontSize="11"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   Margin="0,0,0,4"/>

										<Button Classes="options"
												Content="Change Platform"
												HorizontalAlignment="Stretch"
												Click="OptionsButton_Click"
												Tag="{Binding}"
												FontSize="12">
											<Button.ContextMenu>
												<ContextMenu>
													<MenuItem Header="Automatic"   Click="PlatformAuto_Click"/>
													<MenuItem Header="Windows"     Click="PlatformWindows_Click"/>
													<MenuItem Header="MacOS"       Click="PlatformMacOS_Click"/>
													<MenuItem Header="Linux X64"   Click="PlatformLinuxX64_Click"/>
													<MenuItem Header="Linux ARM64" Click="PlatformLinuxARM64_Click"/>
													<MenuItem Header="Android"     Click="PlatformAndroid_Click"/>
												</ContextMenu>
											</Button.ContextMenu>
										</Button>

										<Button Classes="options"
												Content="Clear Icon Cache"
												HorizontalAlignment="Stretch"
												Click="ClearIconCache_Click"
												FontSize="12"/>

										<StackPanel Spacing="2" IsVisible="{Binding IsLinuxPlatform}">
											<TextBlock Text="LINUX WINDOWS RUNNER"
													   FontSize="10" FontWeight="Bold"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   LetterSpacing="1"
													   Margin="0,8,0,4"/>
											<TextBox x:Name="LinuxWindowsLaunchCommandTextBox"
													 Foreground="{DynamicResource ThemeText}"
													 Background="{DynamicResource ThemeBase}"
													 BorderBrush="{DynamicResource ThemeBorder}"
													 BorderThickness="1"
													 Padding="12,10"
													 CornerRadius="4"
													 Watermark="Example: flatpak run com.usebottles.bottles -e {exe}"
													 Text="{Binding Settings.LinuxWindowsLaunchCommand, Mode=TwoWay}"
													 TextChanged="LinuxWindowsLaunchCommandTextBox_TextChanged"/>
											<TextBlock Text="Global override for Windows-only apps on Linux when an app uses Auto. Use {exe}, {gamePath}, or {exeDir}. Per-app runner/prefix is under Launch Options → Windows Runner. Leave blank to auto-detect Proton then Wine."
													   FontSize="11"
													   TextWrapping="Wrap"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="0,0,0,4"/>
										</StackPanel>

									</StackPanel>
								</TabItem>

								<!-- Controls Tab -->
								<TabItem Header="Controls" IsVisible="{Binding IsDesktopPlatform}">
									<StackPanel Margin="16,12,16,16" Spacing="4">

										<TextBlock Text="ENABLE"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="2">
											<CheckBox x:Name="EnableGamepadCheckBox"
													  Content="Enable Gamepad Input"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsCheckedChanged="EnableGamepadCheckBox_IsCheckedChanged"/>
											<TextBlock Text="Navigate with the bound controls. The selected app is highlighted."
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<TextBlock Text="CONNECTED CONTROLLERS"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<TextBlock x:Name="ConnectedGamepadsText"
												   Text="No controllers detected"
												   FontSize="12"
												   Foreground="{DynamicResource ThemeText}"
												   TextWrapping="Wrap"
												   Margin="0,0,0,4"/>

										<TextBlock Text="All connected controllers are used. No exclusive selection."
												   FontSize="11"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   TextWrapping="Wrap"
												   Margin="0,0,0,4"/>

										<Button Classes="options"
												Content="Refresh Controllers"
												HorizontalAlignment="Stretch"
												Click="RefreshConnectedGamepads_Click"
												FontSize="12"/>

										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<TextBlock Text="BINDINGS"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<TextBlock x:Name="GamepadRebindStatusText"
												   FontSize="11"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   TextWrapping="Wrap"
												   Margin="0,0,0,4"
												   IsVisible="False"/>

										<StackPanel x:Name="GamepadBindingsPanel" Spacing="6"/>

										<Button Classes="options"
												Content="Reset Bindings to Defaults"
												HorizontalAlignment="Stretch"
												Click="ResetGamepadBindings_Click"
												FontSize="12"
												Margin="0,8,0,0"/>

									</StackPanel>
								</TabItem>

								<!-- Appearance Tab -->
								<TabItem Header="Appearance">
									<StackPanel Margin="16,12,16,16" Spacing="4">

										<StackPanel Spacing="4" IsVisible="{Binding IsDesktopPlatform}">
											<!-- Window -->
											<TextBlock Text="WINDOW"
													   FontSize="10" FontWeight="Bold"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   LetterSpacing="1"
													   Margin="0,0,0,4"/>

											<StackPanel Spacing="2" IsVisible="{Binding ShowStartFullscreenSetting}">
												<CheckBox x:Name="StartFullscreenCheckBox"
														  Content="Start in Fullscreen"
														  Foreground="{DynamicResource ThemeText}"
														  FontSize="13" FontWeight="SemiBold"
														  IsCheckedChanged="StartFullscreenCheckBox_IsCheckedChanged"/>
												<TextBlock Text="Launch the application in fullscreen mode"
														   FontSize="11"
														   Foreground="{DynamicResource ThemeTextSecondary}"
														   Margin="20,0,0,0"/>
											</StackPanel>

											<StackPanel Spacing="2">
												<CheckBox x:Name="ShowOSTopBarCheckBox"
														  Content="Show OS Top Bar"
														  Foreground="{DynamicResource ThemeText}"
														  FontSize="13" FontWeight="SemiBold"
														  IsCheckedChanged="ShowOSTopBarCheckBox_IsCheckedChanged"/>
												<TextBlock Text="Display your operating system's title bar"
														   FontSize="11"
														   Foreground="{DynamicResource ThemeTextSecondary}"
														   Margin="20,0,0,0"/>
											</StackPanel>

											<!-- Divider -->
											<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>
										</StackPanel>

										<!-- Theme Colors -->
										<TextBlock Text="THEME COLORS"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<Button Classes="options"
												Content="Primary Color"
												HorizontalAlignment="Stretch"
												Click="ThemeColorPicker_Click"
												FontSize="12"/>
										<Button Classes="options"
												Content="Secondary Color"
												HorizontalAlignment="Stretch"
												Click="SecondaryColorPicker_Click"
												FontSize="12"/>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<!-- Background Image -->
										<TextBlock Text="BACKGROUND IMAGE"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<TextBlock Text="PNG, JPG, and GIF formats supported"
												   FontSize="11"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   Margin="0,0,0,4"/>

										<Button Classes="options"
												Content="Select Image"
												HorizontalAlignment="Stretch"
												Click="SelectBackgroundImage_Click"
												FontSize="12"/>
										<Button Classes="options"
												Content="Clear Background"
												HorizontalAlignment="Stretch"
												Click="ClearBackgroundImage_Click"
												IsEnabled="{Binding BackgroundImagePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
												FontSize="12"/>

										<StackPanel Spacing="4" Margin="0,4,0,0">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Opacity:"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeText}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=BackgroundOpacitySlider, Path=Value, StringFormat={}{0:F2}}"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeTextSecondary}"/>
											</StackPanel>
											<Slider x:Name="BackgroundOpacitySlider"
													Minimum="0" Maximum="1"
													Value="{Binding BackgroundOpacity}"
													TickFrequency="0.01"
													IsSnapToTickEnabled="True"
													ValueChanged="BackgroundOpacitySlider_ValueChanged"/>
										</StackPanel>

										<StackPanel Spacing="4" IsVisible="{Binding IsDesktopPlatform}">
											<!-- Divider -->
											<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

											<!-- Background Music -->
											<TextBlock Text="BACKGROUND MUSIC"
													   FontSize="10" FontWeight="Bold"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   LetterSpacing="1"
													   Margin="0,0,0,4"/>

											<TextBlock Text="MP3, WAV, and OGG formats supported"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="0,0,0,4"/>

											<Button Classes="options"
													Content="Select Music"
													HorizontalAlignment="Stretch"
													Click="SelectLauncherMusic_Click"
													FontSize="12"/>
											<Button Classes="options"
													Content="Clear Music"
													HorizontalAlignment="Stretch"
													Click="ClearLauncherMusic_Click"
													IsEnabled="{Binding LauncherMusicPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
													FontSize="12"/>

											<StackPanel Spacing="4" Margin="0,4,0,0">
												<StackPanel Orientation="Horizontal" Spacing="8">
													<TextBlock Text="Volume:"
															   FontSize="12"
															   Foreground="{DynamicResource ThemeText}"
															   VerticalAlignment="Center"/>
													<TextBlock Text="{Binding ElementName=MusicVolumeSlider, Path=Value, StringFormat={}{0:F2}}"
															   FontSize="12"
															   Foreground="{DynamicResource ThemeTextSecondary}"/>
												</StackPanel>
												<Slider x:Name="MusicVolumeSlider"
														Minimum="0" Maximum="1"
														Value="{Binding MusicVolume}"
														TickFrequency="0.01"
														IsSnapToTickEnabled="True"
														ValueChanged="MusicVolumeSlider_ValueChanged"/>
											</StackPanel>
										</StackPanel>

									</StackPanel>
								</TabItem>

								<!-- App Cards Tab -->
								<TabItem Header="App Cards">
									<StackPanel Margin="16,12,16,16" Spacing="4">

										<!-- Layout -->
										<TextBlock Text="LAYOUT"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="2">
											<CheckBox x:Name="UseGridViewCheckBox"
													  Content="Grid View"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsCheckedChanged="UseGridViewCheckBox_IsCheckedChanged"/>
											<TextBlock Text="Display apps in a grid instead of a list"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,4,0,0">
											<CheckBox x:Name="GridCompactCardsCheckBox"
													  Content="Details in card"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsEnabled="{Binding ElementName=UseGridViewCheckBox, Path=IsChecked}"
													  IsCheckedChanged="GridCompactCardsCheckBox_IsCheckedChanged"/>
											<TextBlock Text="Keep name, status, and buttons inside each grid card"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"/>
										</StackPanel>

										<StackPanel Spacing="6" Margin="0,4,0,0">
											<TextBlock Text="Presets"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"/>
											<StackPanel Orientation="Horizontal" Spacing="8">
												<Button Classes="modern-icon" Width="52" Height="52"
														Click="LayoutPreset_Landscape_Click"
														ToolTip.Tip="Landscape">
													<Image Width="52" Height="52" Source="avares://QuiverLauncher/Assets/Icons/preset_landscape.png"/>
												</Button>
												<Button Classes="modern-icon" Width="52" Height="52"
														Click="LayoutPreset_Square_Click"
														ToolTip.Tip="Square">
													<Image Width="52" Height="52" Source="avares://QuiverLauncher/Assets/Icons/preset_square.png"/>
												</Button>
												<Button Classes="modern-icon" Width="52" Height="52"
														Click="LayoutPreset_SquareAlt_Click"
														ToolTip.Tip="Square Alt">
													<Image Width="52" Height="52" Source="avares://QuiverLauncher/Assets/Icons/preset_square_alt.png"/>
												</Button>
												<Button Classes="modern-icon" Width="52" Height="52"
														Click="LayoutPreset_Portrait_Click"
														ToolTip.Tip="Portrait">
													<Image Width="52" Height="52" Source="avares://QuiverLauncher/Assets/Icons/preset_portrait.png"/>
												</Button>
												<Button Classes="modern-icon" Width="52" Height="52"
														Click="LayoutPreset_List_Click"
														ToolTip.Tip="List">
													<Image Width="52" Height="52" Source="avares://QuiverLauncher/Assets/Icons/preset_list.png"/>
												</Button>
											</StackPanel>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<!-- Card Content -->
										<TextBlock Text="CARD CONTENT"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="2" Margin="0,0,0,0">
											<TextBlock Text="Library name style"
													   FontSize="13"
													   FontWeight="SemiBold"
													   Foreground="{DynamicResource ThemeText}"/>
											<ComboBox x:Name="LibraryNameStyleComboBox"
													  Foreground="{DynamicResource ThemeText}"
													  Background="{DynamicResource ThemeBase}"
													  BorderBrush="{DynamicResource ThemeBorder}"
													  BorderThickness="1"
													  CornerRadius="4"
													  Padding="8"
													  Margin="0,4,0,0"
													  SelectionChanged="LibraryNameStyleComboBox_SelectionChanged">
												<ComboBoxItem Content="Name only" Tag="NameOnly"/>
												<ComboBoxItem Content="Name + project below" Tag="NameAndProject"/>
												<ComboBoxItem Content="Name (project) in title" Tag="NameAndProjectInTitle"/>
												<ComboBoxItem Content="Project only" Tag="ProjectOnly"/>
											</ComboBox>
											<TextBlock Text="How names and projects appear in the Library. “Below” shows the project name under the title. Custom display names always win when set."
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0">
											<CheckBox x:Name="TruncateLibraryCardTitlesCheckBox"
													  Content="Truncate name, project, and versions on library cards"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsCheckedChanged="TruncateLibraryCardTitlesCheckBox_IsCheckedChanged"/>
											<TextBlock Text="Idle cards show an ellipsis. Hover or gamepad/keyboard focus slides the full name, project, and version text."
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0">
											<TextBlock Text="Tag lines on library cards"
													   FontSize="13"
													   FontWeight="SemiBold"
													   Foreground="{DynamicResource ThemeText}"/>
											<ComboBox x:Name="LibraryCardTagMaxLinesComboBox"
													  Foreground="{DynamicResource ThemeText}"
													  Background="{DynamicResource ThemeBase}"
													  BorderBrush="{DynamicResource ThemeBorder}"
													  BorderThickness="1"
													  CornerRadius="4"
													  Padding="8"
													  Margin="0,4,0,0"
													  SelectionChanged="LibraryCardTagMaxLinesComboBox_SelectionChanged">
												<ComboBoxItem Content="0 lines" Tag="0"/>
												<ComboBoxItem Content="1 line" Tag="1"/>
												<ComboBoxItem Content="2 lines" Tag="2"/>
												<ComboBoxItem Content="3 lines" Tag="3"/>
												<ComboBoxItem Content="4 lines" Tag="4"/>
												<ComboBoxItem Content="No limit" Tag="99"/>
											</ComboBox>
											<TextBlock Text="How many wrapped lines of tags each library card can show. 0 hides tags on cards; filters still work."
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<StackPanel Spacing="2" Margin="0,8,0,0">
											<CheckBox x:Name="ShowLibraryAppUpdateBadgesCheckBox"
													  Content="Show catalog update badges on library cards"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsCheckedChanged="ShowLibraryAppUpdateBadgesCheckBox_IsCheckedChanged"/>
											<TextBlock Text="Small badge when catalog metadata for an app has changes to review (app version updates use the orange update button)"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<!-- Card Size -->
										<TextBlock Text="CARD SIZE"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Size:"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeText}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=SlotSizeSlider, Path=Value, StringFormat={}{0:0}}"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeTextSecondary}"/>
											</StackPanel>
											<Slider x:Name="SlotSizeSlider"
													Minimum="120" Maximum="400"
													Value="180"
													TickFrequency="4"
													IsSnapToTickEnabled="True"
													ValueChanged="SlotSizeSlider_ValueChanged"/>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<!-- Action Buttons -->
										<TextBlock Text="ACTION BUTTONS"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Size:"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeText}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=ActionButtonSizeSlider, Path=Value, StringFormat={}{0:0}}"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeTextSecondary}"/>
											</StackPanel>
											<Slider x:Name="ActionButtonSizeSlider"
													Minimum="32" Maximum="80"
													Value="36"
													TickFrequency="4"
													IsSnapToTickEnabled="True"
													ValueChanged="ActionButtonSizeSlider_ValueChanged"/>
											<TextBlock Text="Size of Play, Download, and Update buttons"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"/>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<!-- App Images -->
										<TextBlock Text="GAME IMAGES"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<!-- Size -->
										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Size:"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeText}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=IconSizeSlider, Path=Value, StringFormat={}{0:0}}"
														   FontSize="11"
														   Foreground="{DynamicResource ThemeTextSecondary}"/>
											</StackPanel>
											<Slider x:Name="IconSizeSlider"
													Minimum="64" Maximum="512"
													Value="124"
													TickFrequency="4"
													IsSnapToTickEnabled="True"
													ValueChanged="IconSizeSlider_ValueChanged"/>
										</StackPanel>

										<!-- Custom Image Fill -->
										<StackPanel Spacing="2">
											<CheckBox x:Name="IconFillCheckBox"
													  Content="Fill Cards"
													  IsChecked="False"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsCheckedChanged="IconFillCheckBox_IsCheckedChanged"/>
											<TextBlock Text="Stretch images to fill entire cards"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"/>
										</StackPanel>

										<!-- Image Opacity -->
										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Card Image Opacity:"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeText}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=IconOpacitySlider, Path=Value, StringFormat={}{0:F1}}"
														   FontSize="11"
														   Foreground="{DynamicResource ThemeTextSecondary}"/>
											</StackPanel>
											<Slider x:Name="IconOpacitySlider"
													Minimum="0.0" Maximum="1.0"
													Value="0.2"
													TickFrequency="0.1"
													IsSnapToTickEnabled="True"
													ValueChanged="IconOpacitySlider_ValueChanged"/>
											<TextBlock Text="Control image transparency"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"/>
										</StackPanel>

										<!-- Left Padding -->
										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Left Padding:"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeText}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=IconMarginSlider, Path=Value, StringFormat={}{0:0}}"
														   FontSize="11"
														   Foreground="{DynamicResource ThemeTextSecondary}"/>
											</StackPanel>
											<Slider x:Name="IconMarginSlider"
													Minimum="0" Maximum="512"
													Value="0"
													TickFrequency="8"
													IsSnapToTickEnabled="True"
													ValueChanged="IconMarginSlider_ValueChanged"/>
										</StackPanel>

										<!-- Divider -->
										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

										<!-- Text -->
										<TextBlock Text="TEXT"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<StackPanel Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="Text Padding:"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeText}"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding ElementName=TextMarginSlider, Path=Value, StringFormat={}{0:0}}"
														   FontSize="12"
														   Foreground="{DynamicResource ThemeTextSecondary}"/>
											</StackPanel>
											<Slider x:Name="TextMarginSlider"
													Minimum="0" Maximum="256"
													Value="0"
													TickFrequency="8"
													IsSnapToTickEnabled="True"
													ValueChanged="TextMarginSlider_ValueChanged"/>
											<TextBlock Text="Adjust the left spacing of text labels"
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"/>
										</StackPanel>

									</StackPanel>
								</TabItem>

								<!-- Advanced Tab -->
								<TabItem Header="Advanced">
									<StackPanel Margin="16,12,16,16" Spacing="4">

										<!-- GitHub API Token -->
										<TextBlock Text="GITHUB API TOKEN"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<TextBlock Text="Increases API rate limits for faster and more reliable downloads"
												   FontSize="11"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   TextWrapping="Wrap"
												   Margin="0,0,0,6"/>

										<TextBox x:Name="GitHubTokenTextBox"
												 Foreground="{DynamicResource ThemeText}"
												 Background="{DynamicResource ThemeBase}"
												 BorderBrush="{DynamicResource ThemeBorder}"
												 BorderThickness="1"
												 Padding="12,10"
												 CornerRadius="4"
												 TextChanged="GitHubTokenTextBox_TextChanged"
												 Text="{Binding Settings.GitHubApiToken, Mode=TwoWay}"/>

										<Button Classes="options"
												Content="Create GitHub Token"
												HorizontalAlignment="Stretch"
												Click="CreateGitHubToken_Click"
												FontSize="12"/>

										<Button Classes="options"
												Content="Clear Token"
												HorizontalAlignment="Stretch"
												Click="ClearGitHubToken_Click"
												FontSize="12"/>

										<TextBlock Text="Visit GitHub's token documentation for more information on generating a personal access token."
												   FontSize="10"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   FontStyle="Italic"
												   TextWrapping="Wrap"
												   Margin="0,8,0,0"/>

										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,12,0,8"/>

										<!-- GitLab API Token -->
										<TextBlock Text="GITLAB API TOKEN"
												   FontSize="10" FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   Margin="0,0,0,4"/>

										<TextBlock Text="Optional. Raises GitLab API rate limits and allows private gitlab.com projects"
												   FontSize="11"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   TextWrapping="Wrap"
												   Margin="0,0,0,6"/>

										<TextBox x:Name="GitLabTokenTextBox"
												 Foreground="{DynamicResource ThemeText}"
												 Background="{DynamicResource ThemeBase}"
												 BorderBrush="{DynamicResource ThemeBorder}"
												 BorderThickness="1"
												 Padding="12,10"
												 CornerRadius="4"
												 TextChanged="GitLabTokenTextBox_TextChanged"
												 Text="{Binding Settings.GitLabApiToken, Mode=TwoWay}"/>

										<Button Classes="options"
												Content="Create GitLab Token"
												HorizontalAlignment="Stretch"
												Click="CreateGitLabToken_Click"
												FontSize="12"/>

										<Button Classes="options"
												Content="Clear GitLab Token"
												HorizontalAlignment="Stretch"
												Click="ClearGitLabToken_Click"
												FontSize="12"/>

										<TextBlock Text="Visit GitLab's personal access token settings to create a token (read_api is enough for public releases)."
												   FontSize="10"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   FontStyle="Italic"
												   TextWrapping="Wrap"
												   Margin="0,8,0,0"/>

										<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,12,0,8"/>

										<StackPanel Spacing="2">
											<CheckBox x:Name="AllowPrereleaseLauncherUpdatesCheckBox"
													  Content="Include prerelease Quiver Launcher updates"
													  Foreground="{DynamicResource ThemeText}"
													  FontSize="13" FontWeight="SemiBold"
													  IsCheckedChanged="AllowPrereleaseLauncherUpdatesCheckBox_IsCheckedChanged"/>
											<TextBlock Text="For development, to allow updates from Quiver Launcher GitHub prereleases. Not for normal users. Use at your own risk."
													   FontSize="11"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   Margin="20,0,0,0"
													   TextWrapping="Wrap"/>
										</StackPanel>

									</StackPanel>
								</TabItem>

							</TabControl>
						</StackPanel>
					</ScrollViewer>
				</Border>
				
				<!-- Changelog Panel -->
				<Border x:Name="ChangelogPanel"
						Grid.RowSpan="2"
						Background="{DynamicResource ThemeBase}"
						IsVisible="False"
						ZIndex="100">
					<Grid RowDefinitions="Auto,*">
						<Border Grid.Row="0"
								Background="{DynamicResource ThemeDarker}"
								BorderBrush="{DynamicResource ThemeBorder}"
								BorderThickness="0,0,0,1"
								Padding="40,16,40,16">
							<Grid ColumnDefinitions="*,Auto">
								<TextBlock x:Name="ChangelogTitle"
										   Grid.Column="0"
										   Text="Changelog"
										   FontSize="28"
										   FontWeight="Bold"
										   Foreground="{DynamicResource ThemeText}"
										   VerticalAlignment="Center"/>
								<Button x:Name="CloseChangelogButton"
										Grid.Column="1"
										Classes="options"
										Content="Close"
										Width="100"
										Click="CloseChangelog_Click"/>
							</Grid>
						</Border>
						<ScrollViewer x:Name="ChangelogScrollViewer"
									  Grid.Row="1"
									  VerticalScrollBarVisibility="Auto"
									  Margin="40,20,40,40">
							<StackPanel MaxWidth="900">
								<ItemsControl x:Name="ChangelogContent"
											  ItemsSource="{Binding}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<ContentControl Content="{Binding}"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</ScrollViewer>
					</Grid>
				</Border>

				<!-- Catalog review row details (diffs + secondary actions) -->
				<Border x:Name="CatalogReviewDetailsPanel"
						XYFocus.NavigationModes="Gamepad,Remote"
						XYFocus.UpNavigationStrategy="Projection"
						XYFocus.DownNavigationStrategy="Projection"
						XYFocus.LeftNavigationStrategy="Projection"
						XYFocus.RightNavigationStrategy="Projection"
						Grid.RowSpan="2"
						Background="{DynamicResource ThemeBase}"
						IsVisible="False"
						ZIndex="110">
					<Grid RowDefinitions="Auto,*">
						<Border x:Name="CatalogReviewDetailsHeaderChrome"
								Grid.Row="0"
								Background="{DynamicResource ThemeDarker}"
								BorderBrush="{DynamicResource ThemeBorder}"
								BorderThickness="0,0,0,1"
								Padding="24,12,24,12">
							<StackPanel Spacing="8">
							<Grid x:Name="CatalogReviewDetailsCompactBar"
								  ColumnDefinitions="Auto,*,Auto,Auto"
								  IsVisible="{x:Static services:PlatformCapabilities.IsMobile}">
								<Panel Width="48"
									   Height="48"
									   Margin="0,0,8,0"
									   VerticalAlignment="Center">
									<Border CornerRadius="6"
											ClipToBounds="True"
											Background="{DynamicResource ThemeLighter}">
										<asyncImageLoader:AdvancedImage Source="{Binding IconUrl}"
																		Stretch="Uniform"
																		HorizontalAlignment="Center"
																		VerticalAlignment="Center"/>
									</Border>
									<Border Classes="mod-status-chip"
											Classes.catalog-status-changed="{Binding IsChangedBadge}"
											CornerRadius="3"
											Padding="3,1"
											Margin="2"
											HorizontalAlignment="Right"
											VerticalAlignment="Top"
											IsVisible="{Binding HasStatusBadge}">
										<TextBlock Text="{Binding StatusShortLabel}" FontSize="8"/>
									</Border>
								</Panel>
								<StackPanel Grid.Column="1"
											Spacing="1"
											Margin="0,0,8,0"
											VerticalAlignment="Center"
											MinWidth="0">
									<TextBlock Text="{Binding TitleName}"
											   FontSize="16"
											   FontWeight="Bold"
											   Foreground="{DynamicResource ThemeText}"
											   TextWrapping="NoWrap"
											   TextTrimming="CharacterEllipsis"
											   MaxLines="1"/>
									<TextBlock Text="{Binding Subtitle}"
											   FontSize="11"
											   Foreground="{DynamicResource ThemeTextSecondary}"
											   TextWrapping="NoWrap"
											   TextTrimming="CharacterEllipsis"
											   MaxLines="1"/>
								</StackPanel>
								<Button x:Name="CatalogReviewDetailsAboutButton"
										Grid.Column="2"
										Classes="options"
										Content="About"
										Margin="0,0,6,0"
										VerticalAlignment="Center"
										Click="CatalogReviewDetailsAbout_Click"/>
								<Button x:Name="CatalogReviewDetailsCloseMobileButton"
										Grid.Column="3"
										Classes="options"
										Content="Close"
										VerticalAlignment="Center"
										Click="CloseCatalogReviewDetails_Click"/>
							</Grid>
							<DockPanel x:Name="CatalogReviewDetailsHero"
									   LastChildFill="True"
									   IsVisible="{x:Static services:PlatformCapabilities.IsDesktop}">
								<Panel x:Name="CatalogReviewDetailsIconHost"
									   DockPanel.Dock="Left"
									   Width="160"
									   Height="160"
									   Margin="0,0,16,0"
									   VerticalAlignment="Top">
									<Border CornerRadius="8"
											ClipToBounds="True"
											Background="{DynamicResource ThemeLighter}">
										<asyncImageLoader:AdvancedImage Source="{Binding IconUrl}"
																		Stretch="Uniform"
																		HorizontalAlignment="Center"
																		VerticalAlignment="Center"/>
									</Border>
									<Border Classes="mod-status-chip"
											Classes.catalog-status-changed="{Binding IsChangedBadge}"
											CornerRadius="3"
											Padding="5,2"
											Margin="8"
											HorizontalAlignment="Right"
											VerticalAlignment="Top"
											IsVisible="{Binding HasStatusBadge}">
										<TextBlock Text="{Binding StatusShortLabel}" FontSize="9"/>
									</Border>
								</Panel>
								<Grid MinWidth="0" MinHeight="160" VerticalAlignment="Stretch">
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="*"/>
										<RowDefinition Height="Auto"/>
									</Grid.RowDefinitions>
									<Grid ColumnDefinitions="*,Auto">
										<StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
											<TextBlock x:Name="CatalogReviewDetailsTitle"
													   Text="App details"
													   FontSize="22"
													   FontWeight="Bold"
													   Foreground="{DynamicResource ThemeText}"
													   TextWrapping="Wrap"
													   TextTrimming="CharacterEllipsis"
													   MaxLines="2"/>
											<TextBlock x:Name="CatalogReviewDetailsSubtitle"
													   FontSize="12"
													   Foreground="{DynamicResource ThemeTextSecondary}"
													   TextTrimming="CharacterEllipsis"/>
										</StackPanel>
										<StackPanel Grid.Column="1"
													Orientation="Horizontal"
													Spacing="8"
													VerticalAlignment="Top">
											<Button x:Name="CatalogReviewDetailsOpenRepoButton"
													Classes="options"
													Content="Open Repo"
													Click="CatalogReviewDetailsOpenRepo_Click"/>
											<Button x:Name="CloseCatalogReviewDetailsButton"
													Classes="options"
													Content="Close"
													Width="100"
													Click="CloseCatalogReviewDetails_Click"/>
										</StackPanel>
									</Grid>
									<StackPanel x:Name="CatalogReviewDetailsDiffsHost"
												Grid.Row="1"
												Spacing="4"
												Margin="0,8,0,8"
												VerticalAlignment="Top"
												IsVisible="False">
										<ItemsControl x:Name="CatalogReviewDetailsDiffs">
											<ItemsControl.ItemTemplate>
												<StaticResource ResourceKey="CatalogFieldDiffTemplate"/>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</StackPanel>
									<StackPanel Grid.Row="2" Spacing="8">
										<TextBlock x:Name="CatalogReviewDetailsBlockedReason"
												   FontSize="12"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   TextWrapping="Wrap"
												   IsVisible="False"/>
										<WrapPanel x:Name="CatalogReviewDetailsActions"
												   Orientation="Horizontal">
											<Button Classes="options catalog-review-add" Content="Add" Tag="{Binding IdentityKey}" Click="CatalogSyncRowAdd_Click"
													FontSize="11" Padding="10,6" Margin="0,0,8,4" IsVisible="{Binding CanAdd}"/>
											<Button Classes="options catalog-review-merge" Content="Merge" Tag="{Binding IdentityKey}" Click="CatalogSyncRowMerge_Click"
													FontSize="11" Padding="10,6" Margin="0,0,8,4" IsVisible="{Binding CanMerge}"/>
											<Button Classes="options" Content="Replace" Tag="{Binding IdentityKey}" Click="CatalogSyncRowReplace_Click"
													FontSize="11" Padding="10,6" Margin="0,0,8,4" IsVisible="{Binding CanReplace}"/>
											<Button Classes="options" Content="Ignore" Tag="{Binding IdentityKey}" Click="CatalogSyncRowIgnore_Click"
													FontSize="11" Padding="10,6" Margin="0,0,8,4" IsVisible="{Binding CanIgnore}"/>
											<Button Classes="options" Content="Hide" Tag="{Binding IdentityKey}" Click="CatalogSyncRowHide_Click"
													FontSize="11" Padding="10,6" Margin="0,0,8,4"
													ToolTip.Tip="Hide this app from this catalog list. It will not appear in Needs Review or count as a catalog update until you Unhide it. Find it again under Hidden."
													IsVisible="{Binding ShowHideButton}"/>
											<Button Classes="options" Content="Unhide" Tag="{Binding IdentityKey}" Click="CatalogSyncRowUnhide_Click"
													FontSize="11" Padding="10,6" Margin="0,0,8,4" IsVisible="{Binding ShowUnhideButton}"/>
											<Button Classes="options catalog-remove-from-library"
													Content="Remove"
													Tag="{Binding IdentityKey}"
													Click="CatalogSyncRowRemoveFromLibrary_Click"
													FontSize="11" Padding="10,6" Margin="0,0,8,4"
													ToolTip.Tip="Remove from Library"
													IsVisible="{Binding ShowRemoveFromLibrary}"/>
										</WrapPanel>
									</StackPanel>
								</Grid>
							</DockPanel>
							<ScrollViewer x:Name="CatalogReviewDetailsHeroExpanded"
										  MaxHeight="200"
										  VerticalScrollBarVisibility="Auto"
										  HorizontalScrollBarVisibility="Disabled"
										  IsVisible="False">
								<StackPanel Spacing="8">
									<Button x:Name="CatalogReviewDetailsOpenRepoMobileButton"
											Classes="options"
											Content="Open Repo"
											HorizontalAlignment="Left"
											Click="CatalogReviewDetailsOpenRepo_Click"/>
									<ItemsControl ItemsSource="{Binding DetailsFields}">
										<ItemsControl.ItemTemplate>
											<StaticResource ResourceKey="CatalogFieldDiffTemplate"/>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</ScrollViewer>
							<StackPanel x:Name="CatalogReviewDetailsMobileActionsHost"
										Spacing="8"
										IsVisible="{x:Static services:PlatformCapabilities.IsMobile}">
								<TextBlock Text="{Binding AddBlockedReason}"
										   FontSize="12"
										   Foreground="{DynamicResource ThemeTextSecondary}"
										   TextWrapping="Wrap"
										   IsVisible="{Binding HasAddBlockedReason}"/>
								<WrapPanel x:Name="CatalogReviewDetailsActionsMobile"
										   Orientation="Horizontal">
									<Button Classes="options catalog-review-add" Content="Add" Tag="{Binding IdentityKey}" Click="CatalogSyncRowAdd_Click"
											FontSize="11" Padding="10,6" Margin="0,0,8,4" IsVisible="{Binding CanAdd}"/>
									<Button Classes="options catalog-review-merge" Content="Merge" Tag="{Binding IdentityKey}" Click="CatalogSyncRowMerge_Click"
											FontSize="11" Padding="10,6" Margin="0,0,8,4" IsVisible="{Binding CanMerge}"/>
									<Button Classes="options" Content="Replace" Tag="{Binding IdentityKey}" Click="CatalogSyncRowReplace_Click"
											FontSize="11" Padding="10,6" Margin="0,0,8,4" IsVisible="{Binding CanReplace}"/>
									<Button Classes="options" Content="Ignore" Tag="{Binding IdentityKey}" Click="CatalogSyncRowIgnore_Click"
											FontSize="11" Padding="10,6" Margin="0,0,8,4" IsVisible="{Binding CanIgnore}"/>
									<Button Classes="options" Content="Hide" Tag="{Binding IdentityKey}" Click="CatalogSyncRowHide_Click"
											FontSize="11" Padding="10,6" Margin="0,0,8,4"
											ToolTip.Tip="Hide this app from this catalog list. It will not appear in Needs Review or count as a catalog update until you Unhide it. Find it again under Hidden."
											IsVisible="{Binding ShowHideButton}"/>
									<Button Classes="options" Content="Unhide" Tag="{Binding IdentityKey}" Click="CatalogSyncRowUnhide_Click"
											FontSize="11" Padding="10,6" Margin="0,0,8,4" IsVisible="{Binding ShowUnhideButton}"/>
									<Button Classes="options catalog-remove-from-library"
											Content="Remove"
											Tag="{Binding IdentityKey}"
											Click="CatalogSyncRowRemoveFromLibrary_Click"
											FontSize="11" Padding="10,6" Margin="0,0,8,4"
											ToolTip.Tip="Remove from Library"
											IsVisible="{Binding ShowRemoveFromLibrary}"/>
								</WrapPanel>
							</StackPanel>
							</StackPanel>
						</Border>
						<ScrollViewer x:Name="CatalogReviewDetailsScrollViewer"
									  Grid.Row="1"
									  VerticalScrollBarVisibility="Auto"
									  Margin="24,12,24,24">
							<StackPanel MaxWidth="900" Spacing="4" HorizontalAlignment="Stretch">
								<TextBlock x:Name="CatalogReviewDetailsReadmeHeading"
										   Text="README"
										   FontSize="16"
										   FontWeight="SemiBold"
										   Foreground="{DynamicResource ThemeText}"
										   IsVisible="False"/>
								<StackPanel x:Name="CatalogReviewDetailsReadmeLoading"
											Spacing="8"
											IsVisible="False">
									<ProgressBar Width="120"
												 Height="4"
												 HorizontalAlignment="Left"
												 Minimum="0"
												 Maximum="100"
												 BorderThickness="0"
												 Background="Transparent"
												 IsIndeterminate="True"/>
									<TextBlock Text="Loading README…"
											   FontSize="12"
											   Foreground="{DynamicResource ThemeTextSecondary}"/>
								</StackPanel>
								<ItemsControl x:Name="CatalogReviewDetailsReadmeContent"
											  HorizontalAlignment="Stretch">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel HorizontalAlignment="Stretch"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<ContentControl Content="{Binding}"
															HorizontalAlignment="Stretch"
															HorizontalContentAlignment="Stretch"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</ScrollViewer>
					</Grid>
				</Border>

				<!-- Mod details (README / Changelog) -->
				<Border x:Name="ModDetailsPanel"
						XYFocus.NavigationModes="Gamepad,Remote"
						XYFocus.UpNavigationStrategy="Projection"
						XYFocus.DownNavigationStrategy="Projection"
						XYFocus.LeftNavigationStrategy="Projection"
						XYFocus.RightNavigationStrategy="Projection"
						Grid.RowSpan="2"
						Background="{DynamicResource ThemeBase}"
						IsVisible="False"
						ZIndex="110">
					<Grid RowDefinitions="Auto,Auto,*">
						<Border Grid.Row="0"
								Background="{DynamicResource ThemeDarker}"
								BorderBrush="{DynamicResource ThemeBorder}"
								BorderThickness="0,0,0,1"
								Padding="40,16,40,16">
							<Grid ColumnDefinitions="*,Auto">
								<TextBlock x:Name="ModDetailsTitle"
										   Grid.Column="0"
										   Text="Mod Details"
										   FontSize="24"
										   FontWeight="Bold"
										   Foreground="{DynamicResource ThemeText}"
										   VerticalAlignment="Center"
										   TextTrimming="CharacterEllipsis"
										   Margin="0,0,16,0"/>
								<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
									<Button x:Name="ModDetailsOpenPageButton"
											Classes="options"
											Content="Open Page"
											Click="ModDetailsOpenPage_Click"/>
									<Button x:Name="CloseModDetailsButton"
											Classes="options"
											Content="Close"
											Width="100"
											Click="CloseModDetails_Click"/>
								</StackPanel>
							</Grid>
						</Border>
						<StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="40,16,40,0">
							<Button x:Name="ModDetailsTabDetailsButton"
									Classes="catalog-filter selected"
									Content="Details"
									Tag="Details"
									FontSize="11"
									Click="ModDetailsTab_Click"/>
							<Button x:Name="ModDetailsTabChangelogButton"
									Classes="catalog-filter"
									Content="Changelog"
									Tag="Changelog"
									FontSize="11"
									Click="ModDetailsTab_Click"/>
						</StackPanel>
						<ScrollViewer x:Name="ModDetailsScrollViewer"
									  Grid.Row="2"
									  VerticalScrollBarVisibility="Auto"
									  Margin="40,16,40,40">
							<StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
								<ItemsControl x:Name="ModDetailsContent" HorizontalAlignment="Stretch">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel HorizontalAlignment="Stretch"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<ContentControl Content="{Binding}"
															HorizontalAlignment="Stretch"
															HorizontalContentAlignment="Stretch"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</ScrollViewer>
					</Grid>
				</Border>

				<!-- Entry Form Overlay -->
				<Border x:Name="EntryFormOverlay"
						XYFocus.NavigationModes="Gamepad,Remote"
						XYFocus.UpNavigationStrategy="Projection"
						XYFocus.DownNavigationStrategy="Projection"
						XYFocus.LeftNavigationStrategy="Projection"
						XYFocus.RightNavigationStrategy="Projection"
						Grid.RowSpan="2"
						Background="#CC000000"
						IsVisible="False"
						ZIndex="100">
					<Border x:Name="EntryFormDialogPanel"
							Background="{DynamicResource ThemeDarker}"
							BorderBrush="{DynamicResource ThemeBorder}"
							BorderThickness="1"
							CornerRadius="8"
							Padding="20"
							MaxWidth="480">
						<DockPanel>
							<TextBlock x:Name="FormTitleText"
									   DockPanel.Dock="Top"
									   Text="Create New Entry"
									   FontSize="18"
									   FontWeight="Bold"
									   Foreground="{DynamicResource ThemeText}"
									   Margin="0,0,0,12"/>
							<StackPanel DockPanel.Dock="Bottom" Spacing="12" Margin="0,16,0,0">
								<Border x:Name="ValidationStatusBorder"
										Background="{DynamicResource ThemeBase}"
										BorderBrush="{DynamicResource ThemeBorder}"
										BorderThickness="1"
										CornerRadius="4"
										Padding="12"
										IsVisible="False">
									<TextBlock x:Name="ValidationStatusText"
											   Text=""
											   Foreground="{DynamicResource ThemeText}"
											   FontSize="12"
											   TextWrapping="Wrap"/>
								</Border>
								<StackPanel Orientation="Horizontal"
											Spacing="8"
											HorizontalAlignment="Right">
									<Button x:Name="CancelButton"
											Classes="options"
											Content="Cancel"
											Width="100"
											Click="CancelForm_Click"/>
									<Button x:Name="CreateEditButton"
											Classes="options"
											Content="Create Entry"
											Width="120"
											Click="CreateNewEntry_Click"/>
								</StackPanel>
							</StackPanel>
							<ScrollViewer x:Name="EntryFormFieldsScroll"
										  Padding="0,0,4,0"
										  VerticalScrollBarVisibility="Auto"
										  HorizontalScrollBarVisibility="Disabled">
								<StackPanel Spacing="12" Margin="0,0,16,0">
									<TextBlock Text="Name"
											   FontSize="13"
											   FontWeight="SemiBold"
											   Foreground="{DynamicResource ThemeText}"/>
									<TextBox x:Name="NewGameNameTextBox"
											 Foreground="{DynamicResource ThemeText}"
											 Background="{DynamicResource ThemeBase}"
											 BorderBrush="{DynamicResource ThemeBorder}"
											 BorderThickness="1"
											 CornerRadius="4"
											 Padding="8"
											 TextChanged="GameNameTextBox_TextChanged"/>

									<TextBlock Text="Project"
											   FontSize="13"
											   FontWeight="SemiBold"
											   Foreground="{DynamicResource ThemeText}"/>
									<TextBox x:Name="NewGameProjectTextBox"
											 Watermark="Team / project / author (optional)"
											 Foreground="{DynamicResource ThemeText}"
											 Background="{DynamicResource ThemeBase}"
											 BorderBrush="{DynamicResource ThemeBorder}"
											 BorderThickness="1"
											 CornerRadius="4"
											 Padding="8"/>

									<TextBlock Text="Custom Name"
											   FontSize="13"
											   FontWeight="SemiBold"
											   Foreground="{DynamicResource ThemeText}"/>
									<TextBox x:Name="NewGameCustomDisplayNameTextBox"
											 Watermark="Overrides library name style when set"
											 Foreground="{DynamicResource ThemeText}"
											 Background="{DynamicResource ThemeBase}"
											 BorderBrush="{DynamicResource ThemeBorder}"
											 BorderThickness="1"
											 CornerRadius="4"
											 Padding="8"/>

									<CheckBox x:Name="NewGameManuallyManagedCheckBox"
											  Content="Manually managed (no repository or updates)"
											  Foreground="{DynamicResource ThemeText}"
											  VerticalAlignment="Center"
											  IsCheckedChanged="ManuallyManagedCheckBox_Changed"/>

									<TextBlock x:Name="NewGameRepositorySourceLabel"
											   Text="Repository Source"
											   FontSize="13"
											   FontWeight="SemiBold"
											   Foreground="{DynamicResource ThemeText}"/>
									<ComboBox x:Name="NewGameRepositorySourceComboBox"
											  Foreground="{DynamicResource ThemeText}"
											  Background="{DynamicResource ThemeBase}"
											  BorderBrush="{DynamicResource ThemeBorder}"
											  BorderThickness="1"
											  CornerRadius="4"
											  Padding="8"
											  HorizontalAlignment="Stretch"
											  SelectedIndex="0">
										<ComboBoxItem Content="GitHub" Tag="github"/>
										<ComboBoxItem Content="GitLab" Tag="gitlab"/>
									</ComboBox>

									<TextBlock x:Name="NewGameRepositoryLabel"
											   Text="Repository"
											   FontSize="13"
											   FontWeight="SemiBold"
											   Foreground="{DynamicResource ThemeText}"/>
									<TextBox x:Name="NewGameRepoTextBox"
											 Foreground="{DynamicResource ThemeText}"
											 Background="{DynamicResource ThemeBase}"
											 BorderBrush="{DynamicResource ThemeBorder}"
											 BorderThickness="1"
											 CornerRadius="4"
											 Padding="8"
											 TextChanged="GameRepoTextBox_TextChanged"/>

									<TextBlock x:Name="NewGameReleaseAssetFilterLabel"
											   Text="Release asset filter"
											   FontSize="13"
											   FontWeight="SemiBold"
											   Foreground="{DynamicResource ThemeText}"/>
									<TextBox x:Name="NewGameReleaseAssetFilterTextBox"
											 Watermark="If this repo ships more than one game, text that appears only in this game’s filenames (e.g. EXIT1)"
											 Foreground="{DynamicResource ThemeText}"
											 Background="{DynamicResource ThemeBase}"
											 BorderBrush="{DynamicResource ThemeBorder}"
											 BorderThickness="1"
											 CornerRadius="4"
											 Padding="8"/>

									<TextBlock Text="Folder Name"
											   FontSize="13"
											   FontWeight="SemiBold"
											   Foreground="{DynamicResource ThemeText}"/>
									<TextBox x:Name="NewGameFolderTextBox"
											 Foreground="{DynamicResource ThemeText}"
											 Background="{DynamicResource ThemeBase}"
											 BorderBrush="{DynamicResource ThemeBorder}"
											 BorderThickness="1"
											 CornerRadius="4"
											 Padding="8"
											 TextChanged="GameFolderTextBox_TextChanged"/>

									<TextBlock Text="Tags"
											   FontSize="13"
											   FontWeight="SemiBold"
											   Foreground="{DynamicResource ThemeText}"/>
									<TextBox x:Name="NewGameTagsTextBox"
											 Watermark="e.g. n64, recomp"
											 Foreground="{DynamicResource ThemeText}"
											 Background="{DynamicResource ThemeBase}"
											 BorderBrush="{DynamicResource ThemeBorder}"
											 BorderThickness="1"
											 CornerRadius="4"
											 Padding="8"
											 AcceptsReturn="False"
											 TextWrapping="Wrap"
											 MinHeight="56"/>

									<TextBlock Text="Icon URL"
											   FontSize="13"
											   FontWeight="SemiBold"
											   Foreground="{DynamicResource ThemeText}"/>
									<TextBox x:Name="NewGameIconTextBox"
											 Foreground="{DynamicResource ThemeText}"
											 Background="{DynamicResource ThemeBase}"
											 BorderBrush="{DynamicResource ThemeBorder}"
											 BorderThickness="1"
											 CornerRadius="4"
											 Padding="8"
											 TextChanged="GameIconTextBox_TextChanged"/>

									<TextBlock Text="Files To Add"
											   FontSize="13"
											   FontWeight="SemiBold"
											   Foreground="{DynamicResource ThemeText}"/>
									<TextBox x:Name="NewGameFilesToAddTextBox"
											 Watermark="e.g. portable.txt"
											 Foreground="{DynamicResource ThemeText}"
											 Background="{DynamicResource ThemeBase}"
											 BorderBrush="{DynamicResource ThemeBorder}"
											 BorderThickness="1"
											 CornerRadius="4"
											 Padding="8"/>

									<TextBlock Text="Mods Path"
											   FontSize="13"
											   FontWeight="SemiBold"
											   Foreground="{DynamicResource ThemeText}"/>
									<TextBox x:Name="NewGameModsPathTextBox"
											 Watermark="e.g. mods"
											 Foreground="{DynamicResource ThemeText}"
											 Background="{DynamicResource ThemeBase}"
											 BorderBrush="{DynamicResource ThemeBorder}"
											 BorderThickness="1"
											 CornerRadius="4"
											 Padding="8"/>

									<CheckBox x:Name="NewGameModsFolderPerModCheckBox"
											  Content="Install each mod into its own folder"
											  Foreground="{DynamicResource ThemeText}"
											  VerticalAlignment="Center"/>

									<TextBlock Text="Mod Sources"
											   FontSize="13"
											   FontWeight="SemiBold"
											   Foreground="{DynamicResource ThemeText}"/>
									<TextBox x:Name="NewGameModsSourcesTextBox"
											 Watermark="Thunderstore URL/slug or GameBanana mods/games/{id} (one per line)"
											 Foreground="{DynamicResource ThemeText}"
											 Background="{DynamicResource ThemeBase}"
											 BorderBrush="{DynamicResource ThemeBorder}"
											 BorderThickness="1"
											 CornerRadius="4"
											 Padding="8"
											 AcceptsReturn="True"
											 TextWrapping="Wrap"
											 MinHeight="72"/>
								</StackPanel>
							</ScrollViewer>
						</DockPanel>
					</Border>
				</Border>

				<!-- Display Filter Overlay -->
				<Border x:Name="DisplayFilterOverlay"
						XYFocus.NavigationModes="Gamepad,Remote"
						XYFocus.UpNavigationStrategy="Projection"
						XYFocus.DownNavigationStrategy="Projection"
						XYFocus.LeftNavigationStrategy="Projection"
						XYFocus.RightNavigationStrategy="Projection"
						Grid.RowSpan="2"
						Background="#CC000000"
						IsVisible="False"
						ZIndex="110">
					<Border Background="{DynamicResource ThemeDarker}"
							BorderBrush="{DynamicResource ThemeBorder}"
							BorderThickness="1"
							CornerRadius="8"
							Padding="20"
							MaxWidth="480"
							HorizontalAlignment="Center"
							VerticalAlignment="Center">
						<StackPanel Spacing="12">
							<TextBlock x:Name="DisplayFilterOverlayTitle"
									   Text="Add Display Filter"
									   FontSize="18"
									   FontWeight="Bold"
									   Foreground="{DynamicResource ThemeText}"/>
							<TextBox x:Name="DisplayFilterNameTextBox"
									 Watermark="Filter name"
									 Foreground="{DynamicResource ThemeText}"
									 Background="{DynamicResource ThemeBase}"
									 BorderBrush="{DynamicResource ThemeBorder}"
									 BorderThickness="1"
									 CornerRadius="4"
									 Padding="8"/>
							<TextBlock Text="Include tags"
									   FontSize="13"
									   FontWeight="SemiBold"
									   Foreground="{DynamicResource ThemeText}"/>
							<TextBox x:Name="DisplayFilterTagsTextBox"
									 Watermark="Tags (comma-separated, e.g. n64, favorites)"
									 Foreground="{DynamicResource ThemeText}"
									 Background="{DynamicResource ThemeBase}"
									 BorderBrush="{DynamicResource ThemeBorder}"
									 BorderThickness="1"
									 CornerRadius="4"
									 Padding="8"
									 AcceptsReturn="False"
									 TextWrapping="Wrap"
									 MinHeight="56"/>
							<TextBlock Text="Include match mode"
									   FontSize="13"
									   FontWeight="SemiBold"
									   Foreground="{DynamicResource ThemeText}"/>
							<ComboBox x:Name="DisplayFilterMatchModeComboBox"
									  SelectionChanged="DisplayFilterMatchModeComboBox_SelectionChanged">
								<ComboBoxItem Content="Any tag"/>
								<ComboBoxItem Content="All tags"/>
							</ComboBox>
							<TextBlock x:Name="DisplayFilterMatchModeHelpText"
									   FontSize="11"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   TextWrapping="Wrap"/>
							<TextBlock Text="Exclude tags"
									   FontSize="13"
									   FontWeight="SemiBold"
									   Foreground="{DynamicResource ThemeText}"/>
							<TextBox x:Name="DisplayFilterExcludeTagsTextBox"
									 Watermark="Tags to hide (comma-separated, optional, e.g. ai)"
									 Foreground="{DynamicResource ThemeText}"
									 Background="{DynamicResource ThemeBase}"
									 BorderBrush="{DynamicResource ThemeBorder}"
									 BorderThickness="1"
									 CornerRadius="4"
									 Padding="8"
									 AcceptsReturn="False"
									 TextWrapping="Wrap"
									 MinHeight="56"/>
							<TextBlock Text="Exclude match mode"
									   FontSize="13"
									   FontWeight="SemiBold"
									   Foreground="{DynamicResource ThemeText}"/>
							<ComboBox x:Name="DisplayFilterExcludeMatchModeComboBox"
									  SelectionChanged="DisplayFilterExcludeMatchModeComboBox_SelectionChanged">
								<ComboBoxItem Content="Any tag"/>
								<ComboBoxItem Content="All tags"/>
							</ComboBox>
							<TextBlock x:Name="DisplayFilterExcludeMatchModeHelpText"
									   FontSize="11"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   TextWrapping="Wrap"/>
							<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
								<Button x:Name="CancelDisplayFilterButton"
										Classes="options"
										Content="Cancel"
										Width="100"
										Click="CancelDisplayFilterEdit_Click"/>
								<Button x:Name="SaveDisplayFilterButton"
										Classes="options"
										Content="Save"
										Width="100"
										Click="SaveDisplayFilter_Click"/>
							</StackPanel>
						</StackPanel>
					</Border>
				</Border>

				<!-- Tag Edit Overlay -->
				<Border x:Name="TagEditOverlay"
						XYFocus.NavigationModes="Gamepad,Remote"
						XYFocus.UpNavigationStrategy="Projection"
						XYFocus.DownNavigationStrategy="Projection"
						XYFocus.LeftNavigationStrategy="Projection"
						XYFocus.RightNavigationStrategy="Projection"
						Grid.RowSpan="2"
						Background="#CC000000"
						IsVisible="False"
						ZIndex="110">
					<Border x:Name="TagEditDialogPanel"
							Background="{DynamicResource ThemeDarker}"
							BorderBrush="{DynamicResource ThemeBorder}"
							BorderThickness="1"
							CornerRadius="8"
							Padding="20"
							MaxWidth="480"
							HorizontalAlignment="Center"
							VerticalAlignment="Center">
						<StackPanel Spacing="12">
							<TextBlock x:Name="TagEditTitleText"
									   Text="Edit Tags"
									   FontSize="18"
									   FontWeight="Bold"
									   Foreground="{DynamicResource ThemeText}"/>
							<TextBlock x:Name="TagEditAppNameText"
									   FontSize="13"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   TextWrapping="Wrap"/>
							<TextBox x:Name="TagEditTextBox"
									 Watermark="Tags (comma-separated)"
									 Foreground="{DynamicResource ThemeText}"
									 Background="{DynamicResource ThemeBase}"
									 BorderBrush="{DynamicResource ThemeBorder}"
									 BorderThickness="1"
									 CornerRadius="4"
									 Padding="8"
									 AcceptsReturn="False"
									 TextWrapping="Wrap"
									 MinHeight="56"/>
							<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
								<Button x:Name="TagEditCancelButton"
										Classes="options"
										Content="Cancel"
										Width="100"
										Click="CancelTagEdit_Click"/>
								<Button x:Name="TagEditSaveButton"
										Classes="options"
										Content="Save"
										Width="100"
										Click="SaveTagEdit_Click"/>
							</StackPanel>
						</StackPanel>
					</Border>
				</Border>

			</Grid>
		</Grid>
	</SplitView>
		<Grid x:Name="MobileNavOverlay"
			  IsVisible="False"
			  ZIndex="30">
			<Border Background="#99000000"
					PointerPressed="MobileNavDimmer_PointerPressed"/>
			<Border Width="264"
					HorizontalAlignment="Left"
					Background="{DynamicResource ThemeDarker}"
					BorderBrush="{DynamicResource ThemeBorder}"
					BorderThickness="0,0,1,0">
				<Grid x:Name="MobileNavDrawerHost"/>
			</Border>
		</Grid>
		<Grid x:Name="MessagePromptOverlay"
			  IsVisible="False"
			  ZIndex="200">
			<Border Background="#CC000000"
					PointerPressed="MessagePromptDimmer_PointerPressed"/>
			<Border x:Name="MessagePromptCard"
					Background="{DynamicResource ThemeDarker}"
					BorderBrush="{DynamicResource ThemeBorder}"
					BorderThickness="1"
					CornerRadius="8"
					Padding="20"
					MaxWidth="480"
					Margin="24"
					HorizontalAlignment="Center"
					VerticalAlignment="Center">
				<StackPanel Spacing="12">
					<TextBlock x:Name="MessagePromptTitleText"
							   FontSize="18"
							   FontWeight="Bold"
							   Foreground="{DynamicResource ThemeText}"
							   TextWrapping="Wrap"/>
					<ScrollViewer MaxHeight="360"
								  VerticalScrollBarVisibility="Auto">
						<TextBlock x:Name="MessagePromptBodyText"
								   FontSize="13"
								   Foreground="{DynamicResource ThemeText}"
								   TextWrapping="Wrap"/>
					</ScrollViewer>
					<StackPanel Orientation="Horizontal"
								Spacing="8"
								HorizontalAlignment="Right">
						<Button x:Name="MessagePromptYesButton"
								Classes="options message-prompt"
								Content="Yes"
								MinWidth="100"
								Click="MessagePromptYesButton_Click"/>
						<Button x:Name="MessagePromptNoButton"
								Classes="options message-prompt"
								Content="No"
								MinWidth="100"
								Click="MessagePromptNoButton_Click"/>
						<Button x:Name="MessagePromptCancelButton"
								Classes="options message-prompt"
								Content="Cancel"
								MinWidth="100"
								IsVisible="False"
								Click="MessagePromptCancelButton_Click"/>
						<Button x:Name="MessagePromptOkButton"
								Classes="options message-prompt"
								Content="OK"
								MinWidth="100"
								Click="MessagePromptOkButton_Click"/>
					</StackPanel>
				</StackPanel>
			</Border>
		</Grid>
	</Grid>
  </Border>
</UserControl>
