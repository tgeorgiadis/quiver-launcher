<UserControl x:Class="QuiverLauncher.MainView"
		xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:QuiverLauncher"
		xmlns:services="clr-namespace:QuiverLauncher.Services"
		xmlns:mods="clr-namespace:QuiverLauncher.Services.Mods"
		xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
		TopLevel.AutoSafeAreaPadding="False"
		XYFocus.NavigationModes="Gamepad,Remote"
		XYFocus.UpNavigationStrategy="Projection"
		XYFocus.DownNavigationStrategy="Projection"
		XYFocus.LeftNavigationStrategy="Projection"
		XYFocus.RightNavigationStrategy="Projection"
		FocusAdorner="{x:Null}"
        Background="{Binding WindowBackground}">

	<UserControl.Resources>
		<local:BooleanToStretchConverter x:Key="BooleanToStretchConverter"/>
		<local:ThicknessConverter x:Key="ThicknessConverter"/>
		<local:DoubleScaleConverter x:Key="DoubleScaleConverter"/>

		<!-- Theme Color Resources -->
		<SolidColorBrush x:Key="ThemeBase" Color="#18181b"/>
		<SolidColorBrush x:Key="ThemeLighter" Color="#252527"/>
		<SolidColorBrush x:Key="ThemeDarker" Color="#0e0e10"/>
		<SolidColorBrush x:Key="ThemeBorder" Color="#2d2d30"/>
		<SolidColorBrush x:Key="ThemeText" Color="White"/>
		<SolidColorBrush x:Key="ThemeTextSecondary" Color="#B8B8B8"/>
		<SolidColorBrush x:Key="ThemeFocusRing" Color="#38bdf8"/>

		<!-- list view -->
		<DataTemplate x:Key="ListViewTemplate">
			<Border Classes="gamecard" Classes.gamepad-focused="{Binding IsGamepadFocused}"
					Height="{Binding ElementName=SlotSizeSlider, Path=Value}" Margin="0,0,0,12"
					PlatformFeedback.FeedbackType="Auto"
					InputElement.IsHoldingEnabled="True"
					PointerEntered="LibraryCard_PointerEntered"
					PointerExited="LibraryCard_PointerExited"
					PointerPressed="GameCard_PointerPressed"
					PointerMoved="GameCard_PointerMoved"
					PointerReleased="GameCard_PointerReleased"
					PointerCaptureLost="GameCard_PointerCaptureLost"
					Tapped="GameCard_Tapped"
					Holding="GameCard_Holding"
					ContextRequested="GameCard_ContextRequested">
				<Grid ClipToBounds="True">
					<Panel ClipToBounds="True">
						<Border CornerRadius="12" ClipToBounds="True">
							<asyncImageLoader:AdvancedImage Source="{Binding IconUrl}"
								ClipToBounds="True"
								Height="{Binding ElementName=IconSizeSlider, Path=Value}"
								VerticalAlignment="Center"
								HorizontalAlignment="Left"
								Opacity="{Binding ElementName=IconOpacitySlider, Path=Value}"
								Margin="{Binding ElementName=IconMarginSlider, Path=Value, Converter={StaticResource ThicknessConverter}}"
								Stretch="{Binding Path=IsChecked, ElementName=IconFillCheckBox, Converter={StaticResource BooleanToStretchConverter}}" />
						</Border>
						<Button Classes="library-update-badge"
								IsVisible="{Binding ShowUpdateBadge}"
								ToolTip.Tip="Catalog update available — click for details"
								HorizontalAlignment="Left"
								VerticalAlignment="Bottom"
								Margin="16,0,0,12"
								ZIndex="10"
								Cursor="Hand"
								CommandParameter="{Binding}"
								Click="ReviewCatalogChanges_Click">
							<TextBlock Text="↑"/>
						</Button>
					</Panel>
					<Grid Margin="24">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0" Margin="{Binding ElementName=TextMarginSlider, Path=Value, Converter={StaticResource ThicknessConverter}}" VerticalAlignment="Center">
							<TextBlock Text="{Binding DisplayName}"
									   FontSize="22"
									   FontWeight="Bold"
									   Foreground="{DynamicResource ThemeText}"
									   IsVisible="{Binding !TruncateLibraryCardTitles}"/>
							<services:HoverScrollText Text="{Binding DisplayName}"
													  IsActive="{Binding ShouldScrollTitle}"
													  FontSize="22"
													  FontWeight="Bold"
													  Foreground="{DynamicResource ThemeText}"
													  IsVisible="{Binding TruncateLibraryCardTitles}"/>
							<TextBlock Text="{Binding ProjectSubtitle}"
									   FontSize="12"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   IsVisible="{Binding ShowWrappedProjectSubtitle}"
									   Margin="0,4,0,0"
									   TextWrapping="Wrap"/>
							<services:HoverScrollText Text="{Binding ProjectSubtitle}"
													  IsActive="{Binding ShouldScrollTitle}"
													  FontSize="12"
													  Foreground="{DynamicResource ThemeTextSecondary}"
													  IsVisible="{Binding ShowTruncatedProjectSubtitle}"
													  Margin="0,4,0,0"/>
							<Border IsVisible="{Binding HasLibraryCardTags}"
									MaxHeight="{Binding LibraryCardTagsMaxHeight}"
									ClipToBounds="True"
									Margin="0,6,0,0">
								<ItemsControl ItemsSource="{Binding LibraryCardTags}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel Orientation="Horizontal"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border Background="{DynamicResource ThemeLighter}"
													CornerRadius="3"
													Padding="5,1"
													Margin="0,0,4,3">
												<TextBlock Text="{Binding}"
														   FontSize="9"
														   Foreground="{DynamicResource ThemeTextSecondary}"/>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</Border>
							
							<TextBlock Text="{Binding StatusText}"
									   FontSize="13"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   Margin="0,6,0,0"
									   IsVisible="{Binding !TruncateLibraryCardTitles}"/>
							<services:HoverScrollText Text="{Binding StatusText}"
													  IsActive="{Binding ShouldScrollTitle}"
													  FontSize="13"
													  Foreground="{DynamicResource ThemeTextSecondary}"
													  Margin="0,6,0,0"
													  IsVisible="{Binding TruncateLibraryCardTitles}"/>
							
							<StackPanel Orientation="Horizontal"
										IsVisible="{Binding ShowWrappedReleaseVersion}">
								<TextBlock Text="Latest: "
										   FontSize="12"
										   Foreground="{DynamicResource ThemeTextSecondary}"/>
								
								<TextBlock Text="{Binding LatestVersion}"
										   FontSize="12"
										   Foreground="{DynamicResource ThemeTextSecondary}"/>
							</StackPanel>
							<services:HoverScrollText Text="{Binding LatestVersionLabel}"
													  IsActive="{Binding ShouldScrollTitle}"
													  FontSize="12"
													  Foreground="{DynamicResource ThemeTextSecondary}"
													  IsVisible="{Binding ShowTruncatedReleaseVersion}"/>
							<StackPanel Orientation="Horizontal"
										IsVisible="{Binding ShowWrappedPreferredVersion}">
								<TextBlock Text="Preferred: "
										   FontSize="12"
										   Foreground="{DynamicResource ThemeTextSecondary}"/>

								<TextBlock Text="{Binding PreferredVersion}"
										   FontSize="12"
										   Foreground="{DynamicResource ThemeTextSecondary}"/>
							</StackPanel>
							<services:HoverScrollText Text="{Binding PreferredVersionLabel}"
													  IsActive="{Binding ShouldScrollTitle}"
													  FontSize="12"
													  Foreground="{DynamicResource ThemeTextSecondary}"
													  IsVisible="{Binding ShowTruncatedPreferredVersion}"/>
							<TextBlock Text="Mod updates available"
									   FontSize="11"
									   Foreground="#E8A838"
									   IsVisible="{Binding HasModUpdates}"/>
						</StackPanel>
						
						<!-- Gamecard: Options -->
						<StackPanel Grid.Column="1" 
									Orientation="Horizontal" 
									VerticalAlignment="Center"
									Spacing="12">
							<Button Classes="modern"
									Content="{Binding ButtonText}"
									FontSize="15"
									MinWidth="{Binding ElementName=ActionButtonSizeSlider, Path=Value, Converter={StaticResource DoubleScaleConverter}, ConverterParameter=3.333333}"
									Height="{Binding ElementName=ActionButtonSizeSlider, Path=Value}"
									IsEnabled="{Binding !IsLoading}"
									PlatformFeedback.FeedbackType="Auto"
									Click="GameButton_Click"
									Tag="{Binding}"/>

							<Button Classes="options options-listview"
									Content="⋯"
									FontSize="20"
									Height="{Binding ElementName=ActionButtonSizeSlider, Path=Value}"
									Width="{Binding ElementName=ActionButtonSizeSlider, Path=Value}"
									IsEnabled="{Binding !IsLoading}"
									Click="OptionsButton_Click"
									Tag="{Binding}">
								<Button.ContextMenu>
									<ContextMenu>
										<MenuItem Header="Launch"
												  Click="LaunchGameMenu_Click"
												  CommandParameter="{Binding}"
												  IsVisible="{Binding CanLaunch}"/>
										<MenuItem Header="Download"
												  Click="LaunchGameMenu_Click"
												  CommandParameter="{Binding}"
												  IsVisible="{Binding CanDownload}"/>
										<MenuItem Header="Locate Existing Install"
												  Click="LocateExistingInstall_Click"
												  CommandParameter="{Binding}"
												  IsVisible="{Binding CanLocateInstall}"/>
										<MenuItem Header="Update Now"
												  Click="UpdateNowMenu_Click"
												  CommandParameter="{Binding}"
												  IsVisible="{Binding CanUpdate}"/>
										<MenuItem Header="Review Catalog Changes"
												  Click="ReviewCatalogChanges_Click"
												  CommandParameter="{Binding}"
												  IsVisible="{Binding ShowUpdateBadge}"/>
										<MenuItem Header="Auto Update"
												  ToggleType="CheckBox"
												  IsChecked="{Binding AutoUpdate, Mode=OneWay}"
												  IsVisible="{Binding CanToggleAutoUpdate}"
												  Click="AutoUpdateMenu_Click"
												  CommandParameter="{Binding}"/>
										<MenuItem Header="Open Folder"
												  Click="OpenFolder_Click"
												  IsVisible="{Binding CanOpenFolder}"
												  CommandParameter="{Binding}"/>
										<MenuItem Header="Versions"
												  IsVisible="{Binding CanVersionOptions}">
											<MenuItem Header="Change Version"
													  Click="ChangeVersion_Click"
													  CommandParameter="{Binding}"
													  IsVisible="{Binding CanChangeVersion}"/>
											<MenuItem Header="Skip Update"
													  Click="SkipUpdate_Click"
													  CommandParameter="{Binding}"
													  IsVisible="{Binding CanSkipUpdate}"/>
											<MenuItem Header="Force Update"
													  Click="ForceUpdate_Click"
													  IsVisible="{Binding IsInstalled}"
													  CommandParameter="{Binding}"/>
										</MenuItem>
											<MenuItem Header="Launch Options"
												  IsVisible="{Binding CanLaunchOptions}">
											<MenuItem Header="Select Different Executable" 
													  CommandParameter="{Binding}" 
													  Click="SelectDifferentExecutable_Click"
													  IsVisible="{Binding HasExecutableChoice}"/>
											<MenuItem Header="Windows Runner…"
													  Click="ConfigureWindowsRunner_Click"
													  IsVisible="{Binding ShowWindowsRunnerOptions}"
													  CommandParameter="{Binding}"/>
											<MenuItem Header="Create Desktop Shortcut"
													  Click="CreateShortcut_Click"
													  IsVisible="{Binding ShowDesktopOnlyActions}"
													  CommandParameter="{Binding}"/>
											<MenuItem Header="Add to Steam"
													  Click="AddToSteam_Click"
													  IsVisible="{Binding CanAddToSteam}"
													  CommandParameter="{Binding}"/>
										</MenuItem>
										<MenuItem Header="Mods"
												  Click="OpenMods_Click"
												  CommandParameter="{Binding}"
												  IsVisible="{Binding CanOpenMods}"/>
										<MenuItem Header="Customize">
											<MenuItem Header="Edit Entry"
													  Click="EditGameEntry_Click"
													  CommandParameter="{Binding}"/>
											<MenuItem Header="Edit Tags"
													  Click="EditTagsMenu_Click"
													  CommandParameter="{Binding}"/>
											<MenuItem Header="Custom Display Name"
													  Click="EditCustomDisplayNameMenu_Click"
													  CommandParameter="{Binding}"/>
											<MenuItem Header="Add Custom Image"
													  Click="SetCustomIcon_Click"
													  CommandParameter="{Binding}"/>
											<MenuItem Header="Remove Custom Image"
													  Click="RemoveCustomIcon_Click"
													  CommandParameter="{Binding}"
													  IsVisible="{Binding HasCustomIcon}"/>
											<MenuItem Header="Hide App"
													  Click="HideGame_Click"
													  CommandParameter="{Binding}"
													  IsVisible="{Binding !IsManuallyHidden}"/>
											<MenuItem Header="Unhide App"
													  Click="HideGame_Click"
													  CommandParameter="{Binding}"
													  IsVisible="{Binding IsManuallyHidden}"/>
											<MenuItem Header="Remove from List"
													  Click="RemoveGameEntry_Click"
													  CommandParameter="{Binding}"
													  IsVisible="{Binding IsInLocalAppsJson}"/>
										</MenuItem>
										<MenuItem Header="About"
												  IsVisible="{Binding CanInfoOptions}">
											<MenuItem Header="View README"
													  Click="ShowReadme_Click"
													  CommandParameter="{Binding}"/>
											<MenuItem Header="Show Changelog"
													  Click="ShowChangelog_Click"
													  CommandParameter="{Binding}"/>
											<MenuItem Header="Open Repository"
													  Click="OpenGitHubPage_Click"
													  CommandParameter="{Binding}"/>
										</MenuItem>
										<MenuItem Header="Delete"
												  Click="DeleteGameFromLibrary_Click"
												  IsVisible="{Binding IsInstalled}"
												  CommandParameter="{Binding}"/>
									</ContextMenu>
								</Button.ContextMenu>
							</Button>
						</StackPanel>
						<!-- Progress Bar -->
						<Border Grid.ColumnSpan="2"
								VerticalAlignment="Bottom"
								Height="4"
								CornerRadius="0,0,12,12"
								ClipToBounds="True"
								IsVisible="{Binding IsDownloading}">
							<ProgressBar Value="{Binding DownloadProgress}"
										 Minimum="0"
										 Maximum="100"
										 Height="4"
										 Background="Transparent"
										 Foreground="{Binding ProgressBarColor}"
										 BorderThickness="0"/>
						</Border>
					</Grid>
				</Grid>
			</Border>
		</DataTemplate>

		<!-- grid view -->
		<DataTemplate x:Key="GridViewTemplate">
			<StackPanel Classes="library-grid-item"
						Background="Transparent"
						PlatformFeedback.FeedbackType="Auto"
						InputElement.IsHoldingEnabled="True"
						PointerEntered="LibraryCard_PointerEntered"
						PointerExited="LibraryCard_PointerExited"
						PointerPressed="GameCard_PointerPressed"
						PointerMoved="GameCard_PointerMoved"
						PointerReleased="GameCard_PointerReleased"
						PointerCaptureLost="GameCard_PointerCaptureLost"
						Tapped="GameCard_Tapped"
						Holding="GameCard_Holding"
						ContextRequested="GameCard_ContextRequested">
				<Border Classes="gamecardgrid" Classes.gamepad-focused="{Binding IsGamepadFocused}">
					<Border.Width>
						<Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="LibraryCardPixelSize"/>
					</Border.Width>
					<Grid ClipToBounds="True">
						<!-- Background Image -->
						<Panel ClipToBounds="True"
							Margin="{Binding ElementName=IconMarginSlider, Path=Value}"
							VerticalAlignment="Top"
							HorizontalAlignment="Center">
							<Border CornerRadius="12" ClipToBounds="True">
								<asyncImageLoader:AdvancedImage Source="{Binding IconUrl}"
								ClipToBounds="True"
								VerticalAlignment="Center"
								Opacity="{Binding ElementName=IconOpacitySlider, Path=Value}"
								Height="{Binding ElementName=IconSizeSlider, Path=Value}"
								Stretch="{Binding Path=IsChecked, ElementName=IconFillCheckBox, Converter={StaticResource BooleanToStretchConverter}}" />
							</Border>
							<Button Classes="library-update-badge"
									IsVisible="{Binding ShowUpdateBadge}"
									ToolTip.Tip="Catalog update available — click for details"
									HorizontalAlignment="Right"
									VerticalAlignment="Bottom"
									Margin="0,0,4,4"
									ZIndex="10"
									Cursor="Hand"
									CommandParameter="{Binding}"
									Click="ReviewCatalogChanges_Click">
								<TextBlock Text="↑"/>
							</Button>
						</Panel>
						
						<!-- Options Button - Top Right -->
						<Button Classes="options-grid"
								FontSize="18"
								VerticalAlignment="Top"
								HorizontalAlignment="Right"
								Margin="12"
								IsEnabled="{Binding !IsLoading}"
								Click="OptionsButton_Click"
								Tag="{Binding}">
							<TextBlock Text="⋯" Foreground="{DynamicResource ThemeText}" TextAlignment="Center" VerticalAlignment="Center"/>
							<Button.ContextMenu>
								<ContextMenu>
									<MenuItem Header="Launch"
											  Click="LaunchGameMenu_Click"
											  CommandParameter="{Binding}"
											  IsVisible="{Binding CanLaunch}"/>
									<MenuItem Header="Download"
											  Click="LaunchGameMenu_Click"
											  CommandParameter="{Binding}"
											  IsVisible="{Binding CanDownload}"/>
									<MenuItem Header="Locate Existing Install"
											  Click="LocateExistingInstall_Click"
											  CommandParameter="{Binding}"
											  IsVisible="{Binding CanLocateInstall}"/>
									<MenuItem Header="Update Now"
											  Click="UpdateNowMenu_Click"
											  CommandParameter="{Binding}"
											  IsVisible="{Binding CanUpdate}"/>
									<MenuItem Header="Review Catalog Changes"
											  Click="ReviewCatalogChanges_Click"
											  CommandParameter="{Binding}"
											  IsVisible="{Binding ShowUpdateBadge}"/>
									<MenuItem Header="Auto Update"
											  ToggleType="CheckBox"
											  IsChecked="{Binding AutoUpdate, Mode=OneWay}"
											  IsVisible="{Binding CanToggleAutoUpdate}"
											  Click="AutoUpdateMenu_Click"
											  CommandParameter="{Binding}"/>
									<MenuItem Header="Open Folder"
											  Click="OpenFolder_Click"
											  IsVisible="{Binding CanOpenFolder}"
											  CommandParameter="{Binding}"/>
									<MenuItem Header="Versions"
											  IsVisible="{Binding CanVersionOptions}">
										<MenuItem Header="Change Version"
												  Click="ChangeVersion_Click"
												  CommandParameter="{Binding}"
												  IsVisible="{Binding CanChangeVersion}"/>
										<MenuItem Header="Skip Update"
												  Click="SkipUpdate_Click"
												  CommandParameter="{Binding}"
												  IsVisible="{Binding CanSkipUpdate}"/>
										<MenuItem Header="Force Update"
												  Click="ForceUpdate_Click"
												  IsVisible="{Binding IsInstalled}"
												  CommandParameter="{Binding}"/>
									</MenuItem>
									<MenuItem Header="Launch Options"
											  IsVisible="{Binding CanLaunchOptions}">
										<MenuItem Header="Select Different Executable" 
												  CommandParameter="{Binding}" 
												  Click="SelectDifferentExecutable_Click"
												  IsVisible="{Binding HasExecutableChoice}"/>
										<MenuItem Header="Windows Runner…"
												  Click="ConfigureWindowsRunner_Click"
												  IsVisible="{Binding ShowWindowsRunnerOptions}"
												  CommandParameter="{Binding}"/>
										<MenuItem Header="Create Desktop Shortcut"
												  Click="CreateShortcut_Click"
												  IsVisible="{Binding ShowDesktopOnlyActions}"
												  CommandParameter="{Binding}"/>
										<MenuItem Header="Add to Steam"
												  Click="AddToSteam_Click"
												  IsVisible="{Binding CanAddToSteam}"
												  CommandParameter="{Binding}"/>
									</MenuItem>
									<MenuItem Header="Mods"
											  Click="OpenMods_Click"
											  CommandParameter="{Binding}"
											  IsVisible="{Binding CanOpenMods}"/>
									<MenuItem Header="Customize">
										<MenuItem Header="Edit Entry"
												  Click="EditGameEntry_Click"
												  CommandParameter="{Binding}"/>
										<MenuItem Header="Edit Tags"
												  Click="EditTagsMenu_Click"
												  CommandParameter="{Binding}"/>
										<MenuItem Header="Custom Display Name"
												  Click="EditCustomDisplayNameMenu_Click"
												  CommandParameter="{Binding}"/>
										<MenuItem Header="Add Custom Image"
												  Click="SetCustomIcon_Click"
												  CommandParameter="{Binding}"/>
										<MenuItem Header="Remove Custom Image"
												  Click="RemoveCustomIcon_Click"
												  CommandParameter="{Binding}"
												  IsVisible="{Binding HasCustomIcon}"/>
										<MenuItem Header="Hide App"
												  Click="HideGame_Click"
												  CommandParameter="{Binding}"
												  IsVisible="{Binding !IsManuallyHidden}"/>
										<MenuItem Header="Unhide App"
												  Click="HideGame_Click"
												  CommandParameter="{Binding}"
												  IsVisible="{Binding IsManuallyHidden}"/>
										<MenuItem Header="Remove from List"
												  Click="RemoveGameEntry_Click"
												  CommandParameter="{Binding}"
												  IsVisible="{Binding IsInLocalAppsJson}"/>
									</MenuItem>
									<MenuItem Header="About"
											  IsVisible="{Binding CanInfoOptions}">
										<MenuItem Header="View README"
												  Click="ShowReadme_Click"
												  CommandParameter="{Binding}"/>
										<MenuItem Header="Show Changelog"
												  Click="ShowChangelog_Click"
												  CommandParameter="{Binding}"/>
										<MenuItem Header="Open Repository"
												  Click="OpenGitHubPage_Click"
												  CommandParameter="{Binding}"/>
									</MenuItem>
									<MenuItem Header="Delete"
											  Click="DeleteGameFromLibrary_Click"
											  IsVisible="{Binding IsInstalled}"
											  CommandParameter="{Binding}"/>
								</ContextMenu>
							</Button.ContextMenu>
						</Button>

						<!-- Progress Bar -->
						<Border VerticalAlignment="Bottom"
								Height="4"
								CornerRadius="0,0,12,12"
								ClipToBounds="True"
								IsVisible="{Binding IsDownloading}">
							<ProgressBar Value="{Binding DownloadProgress}"
										 Minimum="0"
										 Maximum="100"
										 Height="4"
										 Background="Transparent"
										 Foreground="{Binding ProgressBarColor}"
										 BorderThickness="0"/>
						</Border>
					</Grid>
				</Border>
				
				<!-- Info Bar Below Card -->
				<Grid>
					<Grid.Width>
						<Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="LibraryCardPixelSize"/>
					</Grid.Width>
					<Grid Margin="10,0,10,20">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<!-- App name (full width) -->
						<StackPanel Grid.Row="0"
									Grid.ColumnSpan="2"
									Margin="0,0,0,4">
							<TextBlock Text="{Binding DisplayName}"
									   FontSize="14"
									   FontWeight="Bold"
									   Foreground="{DynamicResource ThemeText}"
									   TextAlignment="Left"
									   TextWrapping="Wrap"
									   IsVisible="{Binding !TruncateLibraryCardTitles}"/>
							<services:HoverScrollText Text="{Binding DisplayName}"
													  IsActive="{Binding ShouldScrollTitle}"
													  FontSize="14"
													  FontWeight="Bold"
													  Foreground="{DynamicResource ThemeText}"
													  IsVisible="{Binding TruncateLibraryCardTitles}"/>
							<TextBlock Text="{Binding ProjectSubtitle}"
									   FontSize="11"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   IsVisible="{Binding ShowWrappedProjectSubtitle}"
									   Margin="0,2,0,0"
									   TextWrapping="Wrap"/>
							<services:HoverScrollText Text="{Binding ProjectSubtitle}"
													  IsActive="{Binding ShouldScrollTitle}"
													  FontSize="11"
													  Foreground="{DynamicResource ThemeTextSecondary}"
													  IsVisible="{Binding ShowTruncatedProjectSubtitle}"
													  Margin="0,2,0,0"/>
							<Border IsVisible="{Binding HasLibraryCardTags}"
									MaxHeight="{Binding LibraryCardTagsMaxHeight}"
									ClipToBounds="True"
									Margin="0,4,0,0">
								<ItemsControl ItemsSource="{Binding LibraryCardTags}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel Orientation="Horizontal"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border Background="{DynamicResource ThemeLighter}"
													CornerRadius="3"
													Padding="5,1"
													Margin="0,0,4,3">
												<TextBlock Text="{Binding}"
														   FontSize="9"
														   Foreground="{DynamicResource ThemeTextSecondary}"/>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</Border>
						</StackPanel>

						<!-- Download/Launch Button -->
						<Button Grid.Row="1"
							Grid.Column="0"
							Classes="modern-icon"
							VerticalAlignment="Top"
							Width="{Binding ElementName=ActionButtonSizeSlider, Path=Value}"
							Height="{Binding ElementName=ActionButtonSizeSlider, Path=Value}"
							Margin="0,0,12,0"
							IsEnabled="{Binding !IsLoading}"
							PlatformFeedback.FeedbackType="Auto"
							Click="GameButton_Click"
							Tag="{Binding}">
							<Image Width="{Binding ElementName=ActionButtonSizeSlider, Path=Value}"
								   Source="{Binding ButtonImage}"/>
						</Button>

						<!-- Status and versions -->
						<StackPanel Grid.Row="1"
									Grid.Column="1"
									VerticalAlignment="Center">
							<TextBlock Text="{Binding StatusText}"
									   FontSize="11"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   TextAlignment="Left"
									   TextWrapping="Wrap"
									   Margin="0,0,0,2"
									   IsVisible="{Binding !TruncateLibraryCardTitles}"/>
							<services:HoverScrollText Text="{Binding StatusText}"
													  IsActive="{Binding ShouldScrollTitle}"
													  FontSize="11"
													  Foreground="{DynamicResource ThemeTextSecondary}"
													  Margin="0,0,0,2"
													  IsVisible="{Binding TruncateLibraryCardTitles}"/>

							<TextBlock FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" TextAlignment="Left"
									   IsVisible="{Binding ShowWrappedReleaseVersion}">
								<Run Text="Latest: "/>
								<Run Text="{Binding LatestVersion}" Foreground="{DynamicResource ThemeTextSecondary}"/>
							</TextBlock>
							<services:HoverScrollText Text="{Binding LatestVersionLabel}"
													  IsActive="{Binding ShouldScrollTitle}"
													  FontSize="10"
													  Foreground="{DynamicResource ThemeTextSecondary}"
													  IsVisible="{Binding ShowTruncatedReleaseVersion}"/>
							<TextBlock FontSize="10"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   TextWrapping="Wrap"
									   TextAlignment="Left"
									   IsVisible="{Binding ShowWrappedPreferredVersion}">
								<Run Text="Preferred: "/>
								<Run Text="{Binding PreferredVersion}" Foreground="{DynamicResource ThemeTextSecondary}"/>
							</TextBlock>
							<services:HoverScrollText Text="{Binding PreferredVersionLabel}"
													  IsActive="{Binding ShouldScrollTitle}"
													  FontSize="10"
													  Foreground="{DynamicResource ThemeTextSecondary}"
													  IsVisible="{Binding ShowTruncatedPreferredVersion}"/>
							<TextBlock Text="Mod updates available"
									   FontSize="10"
									   Foreground="#E8A838"
									   IsVisible="{Binding HasModUpdates}"/>
						</StackPanel>
					</Grid>
				</Grid>
			</StackPanel>
		</DataTemplate>

		<!-- compact grid view (in-card content) -->
		<DataTemplate x:Key="CompactGridViewTemplate">
			<Border Classes="gamecardcompact" Classes.gamepad-focused="{Binding IsGamepadFocused}"
					ClipToBounds="True"
					PlatformFeedback.FeedbackType="Auto"
					InputElement.IsHoldingEnabled="True"
					PointerEntered="LibraryCard_PointerEntered"
					PointerExited="LibraryCard_PointerExited"
					PointerPressed="GameCard_PointerPressed"
					PointerMoved="GameCard_PointerMoved"
					PointerReleased="GameCard_PointerReleased"
					PointerCaptureLost="GameCard_PointerCaptureLost"
					Tapped="GameCard_Tapped"
					Holding="GameCard_Holding"
					ContextRequested="GameCard_ContextRequested">
				<Border.Width>
					<Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="LibraryCardPixelSize"/>
				</Border.Width>
				<Border.MinHeight>
					<Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="LibraryCardPixelSize"/>
				</Border.MinHeight>
				<Grid ClipToBounds="True">
					<Grid.RowDefinitions>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<!-- Image well: full-width ThemeLighter band (mod/catalog poster) -->
					<Border Grid.Row="0"
							Background="{DynamicResource ThemeLighter}"
							CornerRadius="14,14,0,0"
							ClipToBounds="True"
							HorizontalAlignment="Stretch">
						<Panel ClipToBounds="True"
							   Margin="{Binding ElementName=IconMarginSlider, Path=Value}">
							<asyncImageLoader:AdvancedImage Source="{Binding IconUrl}"
								ClipToBounds="True"
								VerticalAlignment="Center"
								HorizontalAlignment="Center"
								Opacity="{Binding ElementName=IconOpacitySlider, Path=Value}"
								Height="{Binding ElementName=IconSizeSlider, Path=Value}"
								Stretch="{Binding Path=IsChecked, ElementName=IconFillCheckBox, Converter={StaticResource BooleanToStretchConverter}}" />
							<Button Classes="library-update-badge"
									IsVisible="{Binding ShowUpdateBadge}"
									ToolTip.Tip="Catalog update available — click for details"
									HorizontalAlignment="Right"
									VerticalAlignment="Bottom"
									Margin="0,0,4,4"
									ZIndex="10"
									Cursor="Hand"
									CommandParameter="{Binding}"
									Click="ReviewCatalogChanges_Click">
								<TextBlock Text="↑"/>
							</Button>
						</Panel>
					</Border>

					<!-- Options Button - Top Right -->
					<Button Grid.Row="0"
							Classes="options-grid"
							ZIndex="11"
							FontSize="18"
							VerticalAlignment="Top"
							HorizontalAlignment="Right"
							Margin="12"
							IsEnabled="{Binding !IsLoading}"
							Click="OptionsButton_Click"
							Tag="{Binding}">
						<TextBlock Text="⋯" Foreground="{DynamicResource ThemeText}" TextAlignment="Center" VerticalAlignment="Center"/>
						<Button.ContextMenu>
							<ContextMenu>
								<MenuItem Header="Launch"
										  Click="LaunchGameMenu_Click"
										  CommandParameter="{Binding}"
										  IsVisible="{Binding CanLaunch}"/>
								<MenuItem Header="Download"
										  Click="LaunchGameMenu_Click"
										  CommandParameter="{Binding}"
										  IsVisible="{Binding CanDownload}"/>
								<MenuItem Header="Locate Existing Install"
										  Click="LocateExistingInstall_Click"
										  CommandParameter="{Binding}"
										  IsVisible="{Binding CanLocateInstall}"/>
								<MenuItem Header="Update Now"
										  Click="UpdateNowMenu_Click"
										  CommandParameter="{Binding}"
										  IsVisible="{Binding CanUpdate}"/>
								<MenuItem Header="Review Catalog Changes"
										  Click="ReviewCatalogChanges_Click"
										  CommandParameter="{Binding}"
										  IsVisible="{Binding ShowUpdateBadge}"/>
								<MenuItem Header="Auto Update"
										  ToggleType="CheckBox"
										  IsChecked="{Binding AutoUpdate, Mode=OneWay}"
										  IsVisible="{Binding CanToggleAutoUpdate}"
										  Click="AutoUpdateMenu_Click"
										  CommandParameter="{Binding}"/>
								<MenuItem Header="Open Folder"
										  Click="OpenFolder_Click"
										  IsVisible="{Binding CanOpenFolder}"
										  CommandParameter="{Binding}"/>
								<MenuItem Header="Versions"
										  IsVisible="{Binding CanVersionOptions}">
									<MenuItem Header="Change Version"
											  Click="ChangeVersion_Click"
											  CommandParameter="{Binding}"
											  IsVisible="{Binding CanChangeVersion}"/>
									<MenuItem Header="Skip Update"
											  Click="SkipUpdate_Click"
											  CommandParameter="{Binding}"
											  IsVisible="{Binding CanSkipUpdate}"/>
									<MenuItem Header="Force Update"
											  Click="ForceUpdate_Click"
											  IsVisible="{Binding IsInstalled}"
											  CommandParameter="{Binding}"/>
								</MenuItem>
								<MenuItem Header="Launch Options"
										  IsVisible="{Binding CanLaunchOptions}">
									<MenuItem Header="Select Different Executable"
											  CommandParameter="{Binding}"
											  Click="SelectDifferentExecutable_Click"
											  IsVisible="{Binding HasExecutableChoice}"/>
									<MenuItem Header="Windows Runner…"
											  Click="ConfigureWindowsRunner_Click"
											  IsVisible="{Binding ShowWindowsRunnerOptions}"
											  CommandParameter="{Binding}"/>
									<MenuItem Header="Create Desktop Shortcut"
											  Click="CreateShortcut_Click"
											  IsVisible="{Binding ShowDesktopOnlyActions}"
											  CommandParameter="{Binding}"/>
									<MenuItem Header="Add to Steam"
											  Click="AddToSteam_Click"
											  IsVisible="{Binding CanAddToSteam}"
											  CommandParameter="{Binding}"/>
								</MenuItem>
								<MenuItem Header="Mods"
										  Click="OpenMods_Click"
										  CommandParameter="{Binding}"
										  IsVisible="{Binding CanOpenMods}"/>
								<MenuItem Header="Customize">
									<MenuItem Header="Edit Entry"
											  Click="EditGameEntry_Click"
											  CommandParameter="{Binding}"/>
									<MenuItem Header="Edit Tags"
											  Click="EditTagsMenu_Click"
											  CommandParameter="{Binding}"/>
									<MenuItem Header="Custom Display Name"
											  Click="EditCustomDisplayNameMenu_Click"
											  CommandParameter="{Binding}"/>
									<MenuItem Header="Add Custom Image"
											  Click="SetCustomIcon_Click"
											  CommandParameter="{Binding}"/>
									<MenuItem Header="Remove Custom Image"
											  Click="RemoveCustomIcon_Click"
											  CommandParameter="{Binding}"
											  IsVisible="{Binding HasCustomIcon}"/>
									<MenuItem Header="Hide App"
											  Click="HideGame_Click"
											  CommandParameter="{Binding}"
											  IsVisible="{Binding !IsManuallyHidden}"/>
									<MenuItem Header="Unhide App"
											  Click="HideGame_Click"
											  CommandParameter="{Binding}"
											  IsVisible="{Binding IsManuallyHidden}"/>
									<MenuItem Header="Remove from List"
											  Click="RemoveGameEntry_Click"
											  CommandParameter="{Binding}"
											  IsVisible="{Binding IsInLocalAppsJson}"/>
								</MenuItem>
								<MenuItem Header="About"
										  IsVisible="{Binding CanInfoOptions}">
									<MenuItem Header="View README"
											  Click="ShowReadme_Click"
											  CommandParameter="{Binding}"/>
									<MenuItem Header="Show Changelog"
											  Click="ShowChangelog_Click"
											  CommandParameter="{Binding}"/>
									<MenuItem Header="Open Repository"
											  Click="OpenGitHubPage_Click"
											  CommandParameter="{Binding}"/>
								</MenuItem>
								<MenuItem Header="Delete"
										  Click="DeleteGameFromLibrary_Click"
										  IsVisible="{Binding IsInstalled}"
										  CommandParameter="{Binding}"/>
							</ContextMenu>
						</Button.ContextMenu>
					</Button>

					<!-- App name, status, and action button -->
					<Grid Grid.Row="1"
						  Background="{DynamicResource ThemeBase}"
						  Margin="10,8,10,10">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Row="0"
									Grid.ColumnSpan="2"
									Margin="0,0,0,4">
							<TextBlock Text="{Binding DisplayName}"
									   FontSize="14"
									   FontWeight="Bold"
									   Foreground="{DynamicResource ThemeText}"
									   TextWrapping="Wrap"
									   IsVisible="{Binding !TruncateLibraryCardTitles}"/>
							<services:HoverScrollText Text="{Binding DisplayName}"
													  IsActive="{Binding ShouldScrollTitle}"
													  FontSize="14"
													  FontWeight="Bold"
													  Foreground="{DynamicResource ThemeText}"
													  IsVisible="{Binding TruncateLibraryCardTitles}"/>
							<TextBlock Text="{Binding ProjectSubtitle}"
									   FontSize="11"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   IsVisible="{Binding ShowWrappedProjectSubtitle}"
									   Margin="0,2,0,0"
									   TextWrapping="Wrap"/>
							<services:HoverScrollText Text="{Binding ProjectSubtitle}"
													  IsActive="{Binding ShouldScrollTitle}"
													  FontSize="11"
													  Foreground="{DynamicResource ThemeTextSecondary}"
													  IsVisible="{Binding ShowTruncatedProjectSubtitle}"
													  Margin="0,2,0,0"/>
							<Border IsVisible="{Binding HasLibraryCardTags}"
									MaxHeight="{Binding LibraryCardTagsMaxHeight}"
									ClipToBounds="True"
									Margin="0,4,0,0">
								<ItemsControl ItemsSource="{Binding LibraryCardTags}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel Orientation="Horizontal"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border Background="{DynamicResource ThemeLighter}"
													CornerRadius="3"
													Padding="5,1"
													Margin="0,0,4,3">
												<TextBlock Text="{Binding}"
														   FontSize="9"
														   Foreground="{DynamicResource ThemeTextSecondary}"/>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</Border>
						</StackPanel>

						<Button Grid.Row="1"
								Grid.Column="0"
								Classes="modern-icon"
								VerticalAlignment="Top"
								Width="{Binding ElementName=ActionButtonSizeSlider, Path=Value}"
								Height="{Binding ElementName=ActionButtonSizeSlider, Path=Value}"
								Margin="0,0,12,0"
								IsEnabled="{Binding !IsLoading}"
								PlatformFeedback.FeedbackType="Auto"
								Click="GameButton_Click"
								Tag="{Binding}">
							<Image Width="{Binding ElementName=ActionButtonSizeSlider, Path=Value}"
								   Source="{Binding ButtonImage}"/>
						</Button>

						<StackPanel Grid.Row="1"
									Grid.Column="1"
									VerticalAlignment="Center">
							<TextBlock Text="{Binding StatusText}"
									   FontSize="11"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   TextWrapping="Wrap"
									   Margin="0,0,0,2"
									   IsVisible="{Binding !TruncateLibraryCardTitles}"/>
							<services:HoverScrollText Text="{Binding StatusText}"
													  IsActive="{Binding ShouldScrollTitle}"
													  FontSize="11"
													  Foreground="{DynamicResource ThemeTextSecondary}"
													  Margin="0,0,0,2"
													  IsVisible="{Binding TruncateLibraryCardTitles}"/>

							<TextBlock FontSize="10"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   TextWrapping="Wrap"
									   IsVisible="{Binding ShowWrappedReleaseVersion}">
								<Run Text="Latest: "/>
								<Run Text="{Binding LatestVersion}" Foreground="{DynamicResource ThemeTextSecondary}"/>
							</TextBlock>
							<services:HoverScrollText Text="{Binding LatestVersionLabel}"
													  IsActive="{Binding ShouldScrollTitle}"
													  FontSize="10"
													  Foreground="{DynamicResource ThemeTextSecondary}"
													  IsVisible="{Binding ShowTruncatedReleaseVersion}"/>
							<TextBlock FontSize="10"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   TextWrapping="Wrap"
									   IsVisible="{Binding ShowWrappedPreferredVersion}">
								<Run Text="Preferred: "/>
								<Run Text="{Binding PreferredVersion}" Foreground="{DynamicResource ThemeTextSecondary}"/>
							</TextBlock>
							<services:HoverScrollText Text="{Binding PreferredVersionLabel}"
													  IsActive="{Binding ShouldScrollTitle}"
													  FontSize="10"
													  Foreground="{DynamicResource ThemeTextSecondary}"
													  IsVisible="{Binding ShowTruncatedPreferredVersion}"/>
							<TextBlock Text="Mod updates available"
									   FontSize="10"
									   Foreground="#E8A838"
									   IsVisible="{Binding HasModUpdates}"/>
						</StackPanel>
					</Grid>

					<!-- Progress Bar -->
					<Border Grid.Row="1"
							VerticalAlignment="Bottom"
							Height="4"
							CornerRadius="0,0,12,12"
							ClipToBounds="True"
							ZIndex="12"
							IsVisible="{Binding IsDownloading}">
						<ProgressBar Value="{Binding DownloadProgress}"
									 Minimum="0"
									 Maximum="100"
									 Height="4"
									 Background="Transparent"
									 Foreground="{Binding ProgressBarColor}"
									 BorderThickness="0"/>
					</Border>
				</Grid>
			</Border>
		</DataTemplate>

		<!-- Catalog sync field diff (shared) -->
		<DataTemplate x:Key="CatalogFieldDiffTemplate" DataType="services:CatalogSyncFieldDiffItem">
			<Grid ColumnDefinitions="52,*" Margin="0,0,0,2">
				<TextBlock Grid.Column="0"
						   Text="{Binding FieldLabel}"
						   FontSize="10"
						   FontWeight="SemiBold"
						   Foreground="{DynamicResource ThemeTextSecondary}"
						   VerticalAlignment="Top"
						   Margin="0,1,6,0"/>
				<StackPanel Grid.Column="1" Spacing="1">
					<!-- Text: local → external on one row -->
					<WrapPanel IsVisible="{Binding IsTextValueDiff}" Orientation="Horizontal">
						<TextBlock Text="{Binding LocalValue}"
								   FontSize="10"
								   Foreground="#F0A080"
								   TextDecorations="Strikethrough"
								   TextWrapping="Wrap"
								   Margin="0,0,6,0"
								   IsVisible="{Binding HasLocalValue}"/>
						<TextBlock Text="(empty)"
								   FontSize="10"
								   Foreground="#F0A080"
								   FontStyle="Italic"
								   Margin="0,0,6,0"
								   IsVisible="{Binding ShowEmptyLocal}"/>
						<TextBlock Text="→"
								   FontSize="10"
								   Foreground="{DynamicResource ThemeTextSecondary}"
								   Margin="0,0,6,0"
								   VerticalAlignment="Center"
								   IsVisible="{Binding ShowArrow}"/>
						<TextBlock Text="{Binding ExternalValue}"
								   FontSize="10"
								   Foreground="#6EE7A0"
								   TextWrapping="Wrap"
								   IsVisible="{Binding ShowIncomingValue}"/>
						<TextBlock Text="{Binding ExternalValue}"
								   FontSize="10"
								   Foreground="{DynamicResource ThemeText}"
								   TextWrapping="Wrap"
								   IsVisible="{Binding IsSnapshot}"/>
						<TextBlock Text="(empty)"
								   FontSize="10"
								   Foreground="#6EE7A0"
								   FontStyle="Italic"
								   IsVisible="{Binding ShowEmptyExternal}"/>
					</WrapPanel>
					<!-- Icon: compact side-by-side, URLs in tooltips only -->
					<StackPanel IsVisible="{Binding IsIconDiff}" Orientation="Horizontal" Spacing="6">
						<Border BorderBrush="#F0A080" BorderThickness="1" CornerRadius="3" Padding="1"
								Background="#1A1A1A" IsVisible="{Binding HasLocalValue}"
								ToolTip.Tip="{Binding LocalValue}">
							<asyncImageLoader:AdvancedImage Source="{Binding LocalValue}" Width="24" Height="24" Stretch="Uniform"/>
						</Border>
						<TextBlock Text="→" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"
								   VerticalAlignment="Center" IsVisible="{Binding ShowArrow}"/>
						<Border BorderBrush="#6EE7A0" BorderThickness="1" CornerRadius="3" Padding="1"
								Background="#1A1A1A" IsVisible="{Binding HasExternalValue}"
								ToolTip.Tip="{Binding ExternalValue}">
							<asyncImageLoader:AdvancedImage Source="{Binding ExternalValue}" Width="24" Height="24" Stretch="Uniform"/>
						</Border>
					</StackPanel>
					<ItemsControl IsVisible="{Binding IsTagDiff}" ItemsSource="{Binding TagDiffs}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel Orientation="Horizontal"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="services:CatalogSyncTagDiffItem">
								<Border Background="{Binding BackgroundBrush}" CornerRadius="3" Padding="4,1" Margin="0,0,3,2" ToolTip.Tip="{Binding Tooltip}">
									<TextBlock Text="{Binding Tag}" FontSize="9" Foreground="{Binding ForegroundBrush}"/>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</Grid>
		</DataTemplate>

		<!-- App updates review card -->
		<DataTemplate x:Key="AppUpdateReviewCardTemplate">
			<Border Classes="catalog-focus-card"
					CornerRadius="6"
					Padding="8,6"
					Margin="0,0,0,6"
					Classes.gamepad-focused="{Binding IsGamepadFocused}">
				<Grid RowDefinitions="Auto,Auto">
					<Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
						<Border Grid.Column="0" CornerRadius="6" ClipToBounds="True" Width="44" Height="44" Margin="0,0,10,0">
							<asyncImageLoader:AdvancedImage Source="{Binding IconUrl}" Width="44" Height="44" Stretch="Uniform"/>
						</Border>
						<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
							<TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
									   Foreground="{DynamicResource ThemeText}"
									   TextTrimming="CharacterEllipsis"/>
							<TextBlock FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}">
								<Run Text="{Binding InstalledVersion}"/>
								<Run Text=" → "/>
								<Run Text="{Binding LatestVersion}"/>
							</TextBlock>
						</StackPanel>
						<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
							<Button Classes="options" Content="Update" FontSize="10" Padding="6,2"
									IsEnabled="{Binding CanUpdate}"
									Click="AppUpdateReviewRowUpdate_Click"/>
							<Button Classes="options" Content="Skip" FontSize="10" Padding="6,2"
									IsEnabled="{Binding CanSkipUpdate}"
									Click="AppUpdateReviewRowSkip_Click"/>
							<Button Classes="options" Content="Versions" FontSize="10" Padding="6,2"
									IsEnabled="{Binding CanVersionOptions}"
									Click="AppUpdateReviewRowVersions_Click"/>
						</StackPanel>
					</Grid>
					<StackPanel Grid.Row="1"
								Spacing="4"
								Margin="54,8,0,0"
								IsVisible="{Binding IsDownloading}">
						<TextBlock FontSize="11"
								   Foreground="{DynamicResource ThemeTextSecondary}">
							<Run Text="{Binding StatusText}"/>
							<Run Text=" ("/>
							<Run Text="{Binding DownloadProgress, StringFormat={}{0:F0}}"/>
							<Run Text="%)"/>
						</TextBlock>
						<ProgressBar Value="{Binding DownloadProgress}"
									 Minimum="0"
									 Maximum="100"
									 Height="4"
									 Background="{DynamicResource ThemeBorder}"
									 Foreground="{Binding ProgressBarColor}"
									 BorderThickness="0"/>
					</StackPanel>
				</Grid>
			</Border>
		</DataTemplate>

		<!-- Mod browser card -->
		<DataTemplate x:Key="ModListCardTemplate" DataType="mods:ModListItem">
			<Border Classes="catalog-focus-card"
					Width="228"
					CornerRadius="8"
					Padding="0"
					Margin="0,0,12,12"
					Classes.gamepad-focused="{Binding IsGamepadFocused}"
					Classes.mod-update-available="{Binding HasUpdateAvailable}"
					Background="{DynamicResource ThemeDarker}"
					BorderBrush="{DynamicResource ThemeBorder}"
					BorderThickness="1"
					ClipToBounds="True">
				<Grid>
					<Grid RowDefinitions="Auto,*,Auto">
						<!-- Thumbnail -->
						<Border Grid.Row="0"
								Height="148"
								CornerRadius="8,8,0,0"
								ClipToBounds="True"
								Background="{DynamicResource ThemeLighter}">
							<Grid>
								<asyncImageLoader:AdvancedImage Source="{Binding IconUrl}"
																Stretch="UniformToFill"
																HorizontalAlignment="Stretch"
																VerticalAlignment="Stretch"/>
								<Border Classes="mod-update-accent"
										Width="4"
										HorizontalAlignment="Left"
										IsVisible="{Binding HasUpdateAvailable}"
										Background="{DynamicResource ThemeSuccess}"/>
								<Border Classes="mod-status-chip"
										Classes.mod-update-available="{Binding HasUpdateAvailable}"
										CornerRadius="3"
										Padding="5,2"
										Margin="8"
										HorizontalAlignment="Right"
										VerticalAlignment="Top"
										IsVisible="{Binding ShowStatusBadge}">
									<TextBlock Text="{Binding StatusLabel}" FontSize="9"/>
								</Border>
							</Grid>
						</Border>

						<!-- Text -->
						<StackPanel Grid.Row="1" Margin="10,8,10,6" Spacing="3">
							<TextBlock Text="{Binding DisplayName}"
									   FontSize="13"
									   FontWeight="SemiBold"
									   Foreground="{DynamicResource ThemeText}"
									   TextWrapping="Wrap"
									   MaxLines="2"
									   TextTrimming="CharacterEllipsis"/>
							<TextBlock Text="{Binding AuthorLine}"
									   FontSize="11"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   TextTrimming="CharacterEllipsis"/>
							<TextBlock Text="{Binding DescriptionPreview}"
									   FontSize="11"
									   Foreground="{DynamicResource ThemeText}"
									   Opacity="0.85"
									   TextWrapping="Wrap"
									   MaxLines="2"
									   TextTrimming="CharacterEllipsis"
									   IsVisible="{Binding HasDescriptionPreview}"
									   MinHeight="0"/>
							<TextBlock Text="{Binding VersionLine}"
									   FontSize="10"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   TextTrimming="CharacterEllipsis"/>

							<!-- Stats -->
							<WrapPanel Orientation="Horizontal" Margin="0,4,0,0" IsVisible="{Binding HasStatsRow}">
								<StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,2"
											IsVisible="{Binding HasDownloadCount}">
									<TextBlock Text="↓" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
									<TextBlock Text="{Binding DownloadCountText}" FontSize="11"
											   Foreground="{DynamicResource ThemeTextSecondary}"/>
								</StackPanel>
								<StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,2"
											IsVisible="{Binding HasRatingScore}">
									<TextBlock Text="★" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
									<TextBlock Text="{Binding RatingText}" FontSize="11"
											   Foreground="{DynamicResource ThemeTextSecondary}"/>
								</StackPanel>
								<StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,2"
											IsVisible="{Binding HasUpdatedText}">
									<TextBlock Text="⏱" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
									<TextBlock Text="{Binding UpdatedText}" FontSize="11"
											   Foreground="{DynamicResource ThemeTextSecondary}"
											   TextTrimming="CharacterEllipsis"/>
								</StackPanel>
							</WrapPanel>
						</StackPanel>

						<!-- Actions -->
						<WrapPanel Grid.Row="2"
								   Orientation="Horizontal"
								   Margin="8,0,8,8">
							<Button Classes="options" Content="{Binding InstallButtonLabel}" FontSize="10" Padding="6,2" Margin="0,0,4,4"
									IsVisible="{Binding CanInstall}"
									CommandParameter="{Binding}"
									Click="ModRowInstall_Click"/>
							<Button Classes="options mod-update" Content="Update" FontSize="10" Padding="6,2" Margin="0,0,4,4"
									IsVisible="{Binding CanUpdate}"
									CommandParameter="{Binding}"
									Click="ModRowUpdate_Click"/>
							<Button Classes="options" Content="Uninstall" FontSize="10" Padding="6,2" Margin="0,0,4,4"
									IsVisible="{Binding CanUninstall}"
									CommandParameter="{Binding}"
									Click="ModRowUninstall_Click"/>
							<Button Classes="options" Content="Details" FontSize="10" Padding="6,2" Margin="0,0,4,4"
									CommandParameter="{Binding}"
									Click="ModRowDetails_Click"/>
							<Button Classes="options" Content="Open" FontSize="10" Padding="6,2" Margin="0,0,0,4"
									CommandParameter="{Binding}"
									Click="ModRowOpenPage_Click"/>
						</WrapPanel>
					</Grid>

					<!-- Progress bar (same pattern as library game cards) -->
					<Border VerticalAlignment="Bottom"
							Height="4"
							CornerRadius="0,0,8,8"
							ClipToBounds="True"
							IsVisible="{Binding IsBusy}">
						<ProgressBar Value="{Binding DownloadProgress}"
									 Minimum="0"
									 Maximum="100"
									 Height="4"
									 Background="Transparent"
									 Foreground="{Binding ProgressBarColor}"
									 BorderThickness="0"
									 IsIndeterminate="{Binding IsProgressIndeterminate}"/>
					</Border>
				</Grid>
			</Border>
		</DataTemplate>

		<!-- Catalog review app card -->
		<DataTemplate x:Key="CatalogReviewCardTemplate">
			<Border Classes="catalog-focus-card"
					CornerRadius="6"
					Padding="8,5"
					Margin="0,0,0,4"
					Classes.gamepad-focused="{Binding IsGamepadFocused}"
					Tapped="CatalogReviewCard_Tapped">
				<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
					<Border Grid.Column="0"
							Classes="catalog-review-icon"
							Background="{DynamicResource ThemeLighter}"
							CornerRadius="8"
							ClipToBounds="True"
							Width="64"
							Height="64"
							VerticalAlignment="Center"
							HorizontalAlignment="Left">
						<asyncImageLoader:AdvancedImage Source="{Binding IconUrl}"
														Width="64"
														Height="64"
														Stretch="UniformToFill"
														HorizontalAlignment="Stretch"
														VerticalAlignment="Stretch"/>
					</Border>

					<Grid Grid.Column="1" IsSharedSizeScope="True">
						<StackPanel Spacing="2">
							<Grid ColumnSpacing="8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto" SharedSizeGroup="CatalogReviewActions"/>
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0" Spacing="2">
									<WrapPanel Orientation="Horizontal">
										<TextBlock Classes="catalog-review-title"
												   Text="{Binding DisplayName}"
												   FontSize="13"
												   FontWeight="SemiBold"
												   Foreground="{DynamicResource ThemeText}"
												   TextWrapping="Wrap"
												   TextTrimming="CharacterEllipsis"
												   MaxLines="2"
												   VerticalAlignment="Center"
												   Margin="0,0,6,0"/>
										<Border Background="{DynamicResource ThemeLighter}"
												CornerRadius="3"
												Padding="4,1"
												VerticalAlignment="Center">
											<TextBlock Text="{Binding StatusShortLabel}" FontSize="9" Foreground="{DynamicResource ThemeTextSecondary}"/>
										</Border>
									</WrapPanel>
									<TextBlock Text="{Binding Subtitle}"
											   FontSize="10"
											   Foreground="{DynamicResource ThemeTextSecondary}"
											   TextWrapping="Wrap"
											   TextTrimming="CharacterEllipsis"
											   MaxLines="2"/>
								</StackPanel>
							</Grid>
							<StackPanel Classes="catalog-review-actions"
										Orientation="Horizontal"
										Spacing="4"
										IsVisible="{x:Static services:PlatformCapabilities.IsMobile}">
								<Button Classes="options catalog-review-add" Content="Add" Tag="{Binding IdentityKey}" Click="CatalogSyncRowAdd_Click"
										FontSize="10" Padding="8,4" MinHeight="32" HorizontalAlignment="Stretch" IsVisible="{Binding CanAdd}"/>
								<Button Classes="options catalog-review-merge" Content="Merge" Tag="{Binding IdentityKey}" Click="CatalogSyncRowMerge_Click"
										FontSize="10" Padding="8,4" MinHeight="32" HorizontalAlignment="Stretch" IsVisible="{Binding CanMerge}"/>
								<Button Classes="options" Content="Details" Tag="{Binding IdentityKey}" Click="CatalogReviewDetails_Click"
										FontSize="10" Padding="8,4" MinHeight="32" HorizontalAlignment="Stretch"/>
								<Button Classes="options" Content="Replace" Tag="{Binding IdentityKey}" Click="CatalogSyncRowReplace_Click"
										FontSize="10" Padding="8,4" MinHeight="32" HorizontalAlignment="Stretch" IsVisible="{Binding CanReplace}"/>
								<Button Classes="options" Content="Ignore" Tag="{Binding IdentityKey}" Click="CatalogSyncRowIgnore_Click"
										FontSize="10" Padding="8,4" MinHeight="32" HorizontalAlignment="Stretch" IsVisible="{Binding CanIgnore}"/>
								<Button Classes="options" Content="Hide" Tag="{Binding IdentityKey}" Click="CatalogSyncRowHide_Click"
										FontSize="10" Padding="8,4" MinHeight="32" HorizontalAlignment="Stretch"
										ToolTip.Tip="Hide this app from this catalog list. It will not appear in Needs Review or count as a catalog update until you Unhide it. Find it again under Hidden."
										IsVisible="{Binding ShowCardHideButton}"/>
								<Button Classes="options" Content="Unhide" Tag="{Binding IdentityKey}" Click="CatalogSyncRowUnhide_Click"
										FontSize="10" Padding="8,4" MinHeight="32" HorizontalAlignment="Stretch" IsVisible="{Binding ShowUnhideButton}"/>
								<Button Classes="options catalog-remove-from-library"
										Content="Remove"
										Tag="{Binding IdentityKey}"
										Click="CatalogSyncRowRemoveFromLibrary_Click"
										FontSize="10" Padding="8,4" MinHeight="32" HorizontalAlignment="Stretch"
										ToolTip.Tip="Remove from Library"
										IsVisible="{Binding ShowRemoveFromLibrary}"/>
							</StackPanel>
							<StackPanel Spacing="3"
										IsVisible="{Binding HasReviewCardFooter}">
								<TextBlock Text="{Binding AddBlockedReason}"
										   IsVisible="{Binding HasAddBlockedReason}"
										   FontSize="10"
										   Foreground="{DynamicResource ThemeTextSecondary}"
										   TextWrapping="Wrap"/>
								<Border IsVisible="{Binding HasInlineDiff}"
										BorderBrush="{DynamicResource ThemeBorder}"
										BorderThickness="0,1,0,0"
										Padding="0,3,0,0">
									<ItemsControl ItemsSource="{Binding FieldDiffs}">
										<ItemsControl.ItemTemplate>
											<StaticResource ResourceKey="CatalogFieldDiffTemplate"/>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</Border>
							</StackPanel>
						</StackPanel>

						<Grid HorizontalAlignment="Right" VerticalAlignment="Top">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" SharedSizeGroup="CatalogReviewActions"/>
							</Grid.ColumnDefinitions>
							<StackPanel Classes="catalog-review-actions"
									   Orientation="Horizontal"
									   Spacing="4"
									   IsVisible="{x:Static services:PlatformCapabilities.IsDesktop}">
								<Button Classes="options catalog-review-add" Content="Add" Tag="{Binding IdentityKey}" Click="CatalogSyncRowAdd_Click"
										FontSize="10" Padding="8,4" IsVisible="{Binding CanAdd}"/>
								<Button Classes="options catalog-review-merge" Content="Merge" Tag="{Binding IdentityKey}" Click="CatalogSyncRowMerge_Click"
										FontSize="10" Padding="8,4" IsVisible="{Binding CanMerge}"/>
								<Button Classes="options" Content="Details" Tag="{Binding IdentityKey}" Click="CatalogReviewDetails_Click"
										FontSize="10" Padding="8,4"/>
								<Button Classes="options" Content="Replace" Tag="{Binding IdentityKey}" Click="CatalogSyncRowReplace_Click"
										FontSize="10" Padding="8,4" IsVisible="{Binding CanReplace}"/>
								<Button Classes="options" Content="Ignore" Tag="{Binding IdentityKey}" Click="CatalogSyncRowIgnore_Click"
										FontSize="10" Padding="8,4" IsVisible="{Binding CanIgnore}"/>
								<Button Classes="options" Content="Hide" Tag="{Binding IdentityKey}" Click="CatalogSyncRowHide_Click"
										FontSize="10" Padding="8,4"
										ToolTip.Tip="Hide this app from this catalog list. It will not appear in Needs Review or count as a catalog update until you Unhide it. Find it again under Hidden."
										IsVisible="{Binding ShowCardHideButton}"/>
								<Button Classes="options" Content="Unhide" Tag="{Binding IdentityKey}" Click="CatalogSyncRowUnhide_Click"
										FontSize="10" Padding="8,4" IsVisible="{Binding ShowUnhideButton}"/>
								<Button Classes="options catalog-remove-from-library"
										Content="Remove"
										Tag="{Binding IdentityKey}"
										Click="CatalogSyncRowRemoveFromLibrary_Click"
										FontSize="10" Padding="8,4"
										ToolTip.Tip="Remove from Library"
										IsVisible="{Binding ShowRemoveFromLibrary}"/>
							</StackPanel>
						</Grid>
					</Grid>
				</Grid>
			</Border>
		</DataTemplate>

		<!-- Catalog review browse grid card (no inline diffs) -->
		<DataTemplate x:Key="CatalogReviewGridCardTemplate">
			<Border Classes="catalog-focus-card catalog-review-grid-card"
					CornerRadius="8"
					Padding="0"
					ClipToBounds="True"
					PlatformFeedback.FeedbackType="Auto"
					Classes.gamepad-focused="{Binding IsGamepadFocused}"
					PointerEntered="CatalogReviewGridCard_PointerEntered"
					PointerExited="CatalogReviewGridCard_PointerExited"
					Tapped="CatalogReviewCard_Tapped">
				<Border.Width>
					<Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="CatalogReviewGridCardPixelSize"/>
				</Border.Width>
				<StackPanel>
					<Panel>
						<Border Classes="catalog-review-icon"
								Background="{DynamicResource ThemeLighter}"
								CornerRadius="8,8,0,0"
								ClipToBounds="True"
								HorizontalAlignment="Stretch">
							<asyncImageLoader:AdvancedImage Source="{Binding IconUrl}"
															Stretch="Uniform"
															HorizontalAlignment="Center"
															VerticalAlignment="Center"/>
						</Border>
						<Border Classes="mod-status-chip"
								Classes.catalog-status-changed="{Binding IsChangedBadge}"
								CornerRadius="3"
								Padding="5,2"
								Margin="8"
								HorizontalAlignment="Right"
								VerticalAlignment="Top"
								IsVisible="{Binding HasStatusBadge}">
							<TextBlock Text="{Binding StatusShortLabel}" FontSize="9"/>
						</Border>
					</Panel>
					<StackPanel Classes="catalog-review-grid-body" Spacing="2">
						<services:HoverScrollText Classes="catalog-review-title"
												  Text="{Binding TitleName}"
												  IsActive="{Binding ShouldScrollTitle}"
												  FontWeight="Bold"
												  Foreground="{DynamicResource ThemeText}"/>
						<services:HoverScrollText Text="{Binding ProjectSubtitle}"
												  IsActive="{Binding ShouldScrollTitle}"
												  FontSize="11"
												  Foreground="{DynamicResource ThemeTextSecondary}"
												  IsVisible="{Binding HasProjectSubtitle}"/>
						<ItemsControl Classes="catalog-review-grid-actions"
									  ItemsSource="{Binding GridCardDesktopChrome}"
									  Margin="0,6,0,0"
									  IsVisible="{x:Static services:PlatformCapabilities.IsDesktop}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<UniformGrid Rows="1"/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Panel HorizontalAlignment="Stretch">
										<Button Classes="options"
												Classes.catalog-review-add="{Binding IsAddStyle}"
												Classes.catalog-review-merge="{Binding IsMergeStyle}"
												Classes.catalog-remove-from-library="{Binding IsRemoveStyle}"
												Content="{Binding Label}"
												Tag="{Binding IdentityKey}"
												FontSize="10"
												HorizontalAlignment="Stretch"
												IsVisible="{Binding !IsMore}"
												Click="CatalogReviewGridChrome_Click"/>
										<Button Classes="options catalog-review-more"
												Content="More"
												Tag="{Binding IdentityKey}"
												FontSize="10"
												HorizontalAlignment="Stretch"
												IsVisible="{Binding IsMore}">
											<Button.Flyout>
												<MenuFlyout Placement="BottomEdgeAlignedLeft">
													<MenuItem Header="Details" Tag="{Binding IdentityKey}" Click="CatalogReviewDetails_Click"
															  IsVisible="{Binding MenuDetails}"/>
													<MenuItem Header="Hide" Tag="{Binding IdentityKey}" Click="CatalogSyncRowHide_Click"
															  IsVisible="{Binding MenuHide}"/>
													<MenuItem Header="Unhide" Tag="{Binding IdentityKey}" Click="CatalogSyncRowUnhide_Click"
															  IsVisible="{Binding MenuUnhide}"/>
													<MenuItem Header="Remove" Tag="{Binding IdentityKey}" Click="CatalogSyncRowRemoveFromLibrary_Click"
															  IsVisible="{Binding MenuRemove}"/>
													<MenuItem Header="Add" Tag="{Binding IdentityKey}" Click="CatalogSyncRowAdd_Click"
															  IsVisible="{Binding MenuAdd}"/>
													<MenuItem Header="Merge" Tag="{Binding IdentityKey}" Click="CatalogSyncRowMerge_Click"
															  IsVisible="{Binding MenuMerge}"/>
												</MenuFlyout>
											</Button.Flyout>
										</Button>
									</Panel>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<StackPanel Classes="catalog-review-more-row"
									Orientation="Horizontal"
									Margin="0,6,0,0"
									IsVisible="{x:Static services:PlatformCapabilities.IsMobile}">
							<Button Classes="options catalog-review-add" Content="Add" Tag="{Binding IdentityKey}" Click="CatalogSyncRowAdd_Click"
									FontSize="10" Margin="0,0,6,4" IsVisible="{Binding ShowGridCardPrimaryAdd}"/>
							<Button Classes="options catalog-review-merge" Content="Merge" Tag="{Binding IdentityKey}" Click="CatalogSyncRowMerge_Click"
									FontSize="10" Margin="0,0,6,4" IsVisible="{Binding ShowGridCardPrimaryMerge}"/>
							<Button Classes="options catalog-review-more" Content="More"
									FontSize="10" Margin="0,0,6,4">
								<Button.Flyout>
									<MenuFlyout Placement="BottomEdgeAlignedLeft">
										<MenuItem Header="Details" Tag="{Binding IdentityKey}" Click="CatalogReviewDetails_Click"/>
										<MenuItem Header="Hide" Tag="{Binding IdentityKey}" Click="CatalogSyncRowHide_Click"
												  IsVisible="{Binding ShowCardHideButton}"/>
										<MenuItem Header="Unhide" Tag="{Binding IdentityKey}" Click="CatalogSyncRowUnhide_Click"
												  IsVisible="{Binding ShowUnhideButton}"/>
										<MenuItem Header="Remove" Tag="{Binding IdentityKey}" Click="CatalogSyncRowRemoveFromLibrary_Click"
												  IsVisible="{Binding ShowRemoveFromLibrary}"/>
										<MenuItem Header="Add" Tag="{Binding IdentityKey}" Click="CatalogSyncRowAdd_Click"
												  IsVisible="{Binding ShowMenuAdd}"/>
										<MenuItem Header="Merge" Tag="{Binding IdentityKey}" Click="CatalogSyncRowMerge_Click"
												  IsVisible="{Binding ShowMenuMerge}"/>
									</MenuFlyout>
								</Button.Flyout>
							</Button>
						</StackPanel>
					</StackPanel>
				</StackPanel>
			</Border>
		</DataTemplate>

		<!-- Catalog source card -->
		<DataTemplate x:Key="CatalogSourceCardTemplate">
			<Border Classes="catalog-focus-card catalog-source-card"
					CornerRadius="8"
					Padding="10"
					PlatformFeedback.FeedbackType="Auto"
					Classes.gamepad-focused="{Binding IsGamepadFocused}">
				<StackPanel Spacing="4">
					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
						<TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
								   Foreground="{DynamicResource ThemeText}"
								   TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center"
								   ToolTip.Tip="{Binding TitleToolTip}"/>
						<Border Grid.Column="1" Classes="catalog-all-reviewed-chip" VerticalAlignment="Center"
								IsVisible="{Binding AllReviewedVisible}" ToolTip.Tip="All reviewed">
							<TextBlock Text="✓ Reviewed" Classes="catalog-all-reviewed"/>
						</Border>
					</Grid>
					<TextBlock Text="{Binding Description}" FontSize="12"
							   Foreground="{DynamicResource ThemeTextSecondary}"
							   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"
							   ToolTip.Tip="{Binding Description}"
							   IsVisible="{Binding DescriptionVisible}"/>
					<Border Classes="catalog-source-meta" IsVisible="{Binding MetaStripVisible}">
						<StackPanel Spacing="2">
							<Grid ColumnDefinitions="*,Auto">
								<TextBlock Grid.Column="0" Text="{Binding UsageStatsShort}"
										   FontSize="12" FontWeight="SemiBold"
										   Foreground="{DynamicResource ThemeText}"
										   TextTrimming="CharacterEllipsis"
										   Classes.catalog-usage-full="{Binding UsageStatsFullLibrary}"
										   IsVisible="{Binding UsageStatsVisible}"/>
								<TextBlock Grid.Column="1" Text="{Binding FetchStatusText}"
										   FontSize="11"
										   Foreground="{DynamicResource ThemeTextSecondary}"
										   HorizontalAlignment="Right"
										   TextTrimming="CharacterEllipsis"
										   IsVisible="{Binding FetchStatusVisible}"/>
								<TextBlock Grid.Column="1" Text="{Binding StatusWarningText}"
										   FontSize="11" FontWeight="SemiBold"
										   HorizontalAlignment="Right"
										   TextTrimming="CharacterEllipsis"
										   Classes.catalog-status-warning="{Binding StatusWarningIsWarning}"
										   Classes.catalog-status-error="{Binding StatusWarningIsError}"
										   IsVisible="{Binding StatusWarningVisible}"/>
							</Grid>
							<TextBlock Text="{Binding VersionLineText}"
									   FontSize="11"
									   Foreground="{DynamicResource ThemeTextSecondary}"
									   TextTrimming="CharacterEllipsis"
									   Classes.catalog-version-unreviewed="{Binding VersionLineUnreviewed}"
									   IsVisible="{Binding VersionLineVisible}"/>
						</StackPanel>
					</Border>
					<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
						<CheckBox Grid.Column="0" Content="Enabled" IsChecked="{Binding Enabled}" Foreground="{DynamicResource ThemeText}"
								  Tag="{Binding SourceId}" IsCheckedChanged="CatalogSourceEnabled_Changed"/>
						<Button Grid.Column="1" Classes="options" Classes.catalog-review-pending="{Binding ShowReviewPendingStyle}"
								Content="{Binding ReviewButtonText}" HorizontalAlignment="Stretch"
								Tag="{Binding SourceId}" Click="ReviewCatalogSource_Click" FontSize="12" Padding="10,4"/>
						<Button Grid.Column="2" Classes="options" Content="Remove" Tag="{Binding SourceId}"
								Click="RemoveCatalogSource_Click" FontSize="11" Padding="8,4"/>
					</Grid>
				</StackPanel>
			</Border>
		</DataTemplate>
	</UserControl.Resources>

	<UserControl.Styles>
	<Style Selector="Button.modern">
		<Setter Property="Background" Value="{Binding ButtonColor}"/>
		<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Padding" Value="20,10"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Template">
			<ControlTemplate TargetType="Button">
				<Border Background="{TemplateBinding Background}"
						CornerRadius="6"
						Padding="{TemplateBinding Padding}">
					<ContentPresenter
						Name="PART_ContentPresenter"
						Content="{TemplateBinding Content}"
						ContentTemplate="{TemplateBinding ContentTemplate}"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Foreground="{TemplateBinding Foreground}"
						FontSize="{TemplateBinding FontSize}"
						FontWeight="{TemplateBinding FontWeight}"/>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<!-- ComboBox Style -->
	<Style Selector="ComboBox">
		<Setter Property="Background" Value="{DynamicResource ThemeDarker}"/>
		<Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="4"/>
		<Setter Property="Padding" Value="12,8"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>

	<Style Selector="ComboBox:pointerover /template/ Border#Background">
		<Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
	</Style>

	<Style Selector="ComboBox:focus /template/ Border#Background">
		<Setter Property="Background" Value="{DynamicResource ThemeDarker}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="2"/>
	</Style>

	<Style Selector="UserControl.gamepad-chrome ComboBox.gamepad-focused /template/ Border#Background">
		<Setter Property="Background" Value="{DynamicResource ThemeDarker}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="2"/>
	</Style>

	<Style Selector="ComboBoxItem">
		<Setter Property="Background" Value="{DynamicResource ThemeDarker}"/>
		<Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
		<Setter Property="Padding" Value="12,8"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>

	<Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
	</Style>

	<Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource ThemeBase}"/>
		<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
	</Style>

	<Style Selector="ComboBoxItem:focus /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="1"/>
	</Style>

	<Style Selector="Button.modern:pointerover">
		<Setter Property="Opacity" Value="0.85"/>
		<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
	</Style>
	<Style Selector="UserControl.gamepad-chrome Button.modern:pointerover">
		<Setter Property="Opacity" Value="1"/>
	</Style>
	<Style Selector="UserControl.gamepad-chrome Button.modern.gamepad-focused:pointerover">
		<Setter Property="Opacity" Value="1"/>
	</Style>

	<Style Selector="Button.modern:pressed">
		<Setter Property="Opacity" Value="0.7"/>
		<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
	</Style>

	<Style Selector="Button.modern /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="Transparent"/>
	</Style>

	<Style Selector="Button.modern:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="Transparent"/>
	</Style>

	<Style Selector="Button.modern:pressed /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="Transparent"/>
	</Style>

	<!-- Modern Icon Button Style for Grid View -->
	<Style Selector="Button.modern-icon">
		<Setter Property="Background" Value="{Binding ButtonColor}"/>
		<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Template">
			<ControlTemplate TargetType="Button">
				<Border Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="8"
						Padding="{TemplateBinding Padding}">
					<ContentPresenter
						Name="PART_ContentPresenter"
						Content="{TemplateBinding Content}"
						ContentTemplate="{TemplateBinding ContentTemplate}"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Foreground="{TemplateBinding Foreground}"/>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<Style Selector="Button.modern-icon:pointerover">
		<Setter Property="Opacity" Value="0.85"/>
		<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
	</Style>
	<Style Selector="UserControl.gamepad-chrome Button.modern-icon:pointerover">
		<Setter Property="Opacity" Value="1"/>
	</Style>
	<Style Selector="UserControl.gamepad-chrome Button.modern-icon.gamepad-focused:pointerover">
		<Setter Property="Opacity" Value="1"/>
	</Style>

	<Style Selector="Button.modern-icon:pressed">
		<Setter Property="Opacity" Value="0.7"/>
		<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
	</Style>

	<Style Selector="Button.modern-icon /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="Transparent"/>
	</Style>

	<Style Selector="Button.modern-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="Transparent"/>
	</Style>

	<Style Selector="Button.modern-icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="Transparent"/>
	</Style>

	<Style Selector="Button.options">
		<Setter Property="Background" Value="{DynamicResource ThemeBase}"/>
		<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
		<Setter Property="Padding" Value="10"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Template">
			<ControlTemplate TargetType="Button">
				<Border Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="6"
						Padding="{TemplateBinding Padding}">
					<ContentPresenter
						Name="PART_ContentPresenter"
						Content="{TemplateBinding Content}"
						ContentTemplate="{TemplateBinding ContentTemplate}"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						HorizontalContentAlignment="Center"
						VerticalContentAlignment="Center"
						Foreground="{TemplateBinding Foreground}"
						FontSize="{TemplateBinding FontSize}"
						FontWeight="{TemplateBinding FontWeight}"/>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<Style Selector="Button.options:pointerover">
		<Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
		<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
	</Style>

	<Style Selector="Button.options:pressed">
		<Setter Property="Background" Value="{DynamicResource ThemeBase}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
		<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
	</Style>

	<Style Selector="Button.options:disabled">
		<Setter Property="Opacity" Value="1"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="#3A3A3E"/>
		<Setter Property="Foreground" Value="#666666"/>
		<Setter Property="Cursor" Value="Arrow"/>
	</Style>

	<Style Selector="Button.options:disabled /template/ Border">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="#3A3A3E"/>
		<Setter Property="Opacity" Value="0.55"/>
	</Style>

	<Style Selector="Button.options:disabled /template/ ContentPresenter#PART_ContentPresenter">
