	<Style Selector="Button.settings:pointerover">
		<Setter Property="Background" Value="{DynamicResource ThemeBase}"/>
		<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
	</Style>

	<!-- Steam's virtual mouse still fires :pointerover in Gaming Mode. Don't let that
	     look like the gamepad cursor while chrome is on. -->
	<Style Selector="UserControl.gamepad-chrome Button.settings:pointerover">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
	</Style>
	<Style Selector="UserControl.gamepad-chrome Button.settings.selected:pointerover">
		<Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
		<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
