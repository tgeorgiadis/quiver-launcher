	<Style Selector="UserControl.gamepad-chrome Button.iconbutton:pointerover">
		<Setter Property="Opacity" Value="1"/>
	</Style>
	<Style Selector="UserControl.gamepad-chrome Button.iconbutton.gamepad-focused:pointerover">
		<Setter Property="Opacity" Value="1"/>
