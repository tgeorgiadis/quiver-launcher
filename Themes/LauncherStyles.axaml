	<!-- Library card update badge (corner overlay on app icons).
	     Solid dark green so it reads on charcoal cards; custom template so Fluent
	     pointerover chrome does not replace the fill with a grey wash. -->
	<Style Selector="Border.library-update-badge">
		<Setter Property="Background" Value="#166534"/>
		<Setter Property="BorderBrush" Value="#86EFAC"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="8"/>
		<Setter Property="Padding" Value="5,2"/>
		<Setter Property="MinWidth" Value="18"/>
		<Setter Property="MinHeight" Value="18"/>
	</Style>

	<Style Selector="Border.library-update-badge TextBlock">
		<Setter Property="Foreground" Value="#FFFFFF"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="FontSize" Value="10"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

	<Style Selector="Button.library-update-badge">
		<Setter Property="Background" Value="#166534"/>
		<Setter Property="BorderBrush" Value="#86EFAC"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="8"/>
		<Setter Property="Padding" Value="5,2"/>
		<Setter Property="MinWidth" Value="18"/>
		<Setter Property="MinHeight" Value="18"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Foreground" Value="#FFFFFF"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="Template">
			<ControlTemplate TargetType="Button">
				<Border Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="{TemplateBinding CornerRadius}"
						Padding="{TemplateBinding Padding}">
					<ContentPresenter
						Name="PART_ContentPresenter"
						Content="{TemplateBinding Content}"
						ContentTemplate="{TemplateBinding ContentTemplate}"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Foreground="{TemplateBinding Foreground}"
						FontSize="{TemplateBinding FontSize}"
						FontWeight="{TemplateBinding FontWeight}"/>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<Style Selector="Button.library-update-badge TextBlock">
		<Setter Property="Foreground" Value="#FFFFFF"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="FontSize" Value="10"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

	<Style Selector="Button.library-update-badge:pointerover">
		<Setter Property="Background" Value="#15803D"/>
		<Setter Property="BorderBrush" Value="#BBF7D0"/>
		<Setter Property="Foreground" Value="#FFFFFF"/>
	</Style>

	<Style Selector="Button.library-update-badge:pressed">
		<Setter Property="Background" Value="#14532D"/>
		<Setter Property="BorderBrush" Value="#86EFAC"/>
		<Setter Property="Foreground" Value="#FFFFFF"/>
	</Style>

	<Style Selector="Button.library-update-badge /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="Transparent"/>
	</Style>

	<Style Selector="Button.library-update-badge:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="#FFFFFF"/>
	</Style>

	<Style Selector="Button.library-update-badge:pressed /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="#FFFFFF"/>
	</Style>

	<!-- Card cursor is IsGamepadFocused on the Border. Do not require UserControl.gamepad-chrome:
	     DataTemplate items often fail that ancestor match after Avalonia 12. -->
	<Style Selector="Border.gamecard.gamepad-focused,
	                 Border.gamecardgrid.gamepad-focused,
	                 Border.gamecardcompact.gamepad-focused,
	                 Border.catalog-focus-card.gamepad-focused">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="3"/>
		<Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
	</Style>

	<!-- Sidebar / top-bar / settings: same ancestor-free workaround. Gamescope Steam
	     mouse still fires :pointerover; the ring must not depend on UserControl.gamepad-chrome. -->
	<Style Selector="Button.gamepad-focused,
	                 Button.settings.gamepad-focused,
	                 Button.iconbutton.gamepad-focused,
	                 Button.modern.gamepad-focused,
	                 Button.modern-icon.gamepad-focused,
	                 Button.options.gamepad-focused,
	                 Button.catalog-filter.gamepad-focused,
	                 Button.github-token-banner-link.gamepad-focused,
	                 Button.github-token-banner-close.gamepad-focused,
	                 Button.announcement-banner-close.gamepad-focused">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="3"/>
		<Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
	</Style>
	<Style Selector="Button.settings.gamepad-focused,
	                 Button.catalog-filter.gamepad-focused">
		<Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
	</Style>
	<Style Selector="Button.gamepad-focused /template/ Border,
	                 Button.settings.gamepad-focused /template/ Border,
	                 Button.iconbutton.gamepad-focused /template/ Border,
	                 Button.modern.gamepad-focused /template/ Border,
	                 Button.modern-icon.gamepad-focused /template/ Border,
	                 Button.options.gamepad-focused /template/ Border,
	                 Button.catalog-filter.gamepad-focused /template/ Border,
	                 Button.github-token-banner-close.gamepad-focused /template/ Border,
	                 Button.announcement-banner-close.gamepad-focused /template/ Border">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="3"/>
	</Style>
	<Style Selector="TextBox.gamepad-focused /template/ Border#PART_BorderElement">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="3"/>
	</Style>
	<Style Selector="ComboBox.gamepad-focused">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="3"/>
	</Style>
	<Style Selector="ComboBox.gamepad-focused /template/ Border#Background">
		<Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
		<Setter Property="BorderThickness" Value="3"/>
	</Style>
	<Style Selector="CheckBox.gamepad-focused /template/ Border#NormalRectangle">
