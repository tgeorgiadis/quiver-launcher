		<Setter Property="IsHitTestVisible" Value="False"/>
	</Style>

	<Style Selector="Button.display-filter-row:pointerover Button.display-filter-overflow, Button.display-filter-row:focus-within Button.display-filter-overflow, Button.display-filter-row.dragging Button.display-filter-overflow, Button.display-filter-row.gamepad-focused Button.display-filter-overflow">
